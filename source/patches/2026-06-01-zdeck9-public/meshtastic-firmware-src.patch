+constexpr size_t ITSZ_RECOVERY_LINE_MAX = 48;
+char itszRecoveryLine[ITSZ_RECOVERY_LINE_MAX] = {};
+size_t itszRecoveryLineLen = 0;
+
+bool itszEqualsIgnoreCase(const char *a, const char *b)
+{
+    while (*a && *b) {
+        char ca = (*a >= 'A' && *a <= 'Z') ? *a + ('a' - 'A') : *a;
+        char cb = (*b >= 'A' && *b <= 'Z') ? *b + ('a' - 'A') : *b;
+        if (ca != cb)
+            return false;
+        ++a;
+        ++b;
+    }
+    return *a == '\0' && *b == '\0';
+}
+
+bool itszIsBootloaderCommand(const char *line)
+{
+    return itszEqualsIgnoreCase(line, "itsz bootloader") || itszEqualsIgnoreCase(line, "itsz:bootloader") ||
+           itszEqualsIgnoreCase(line, "itsz dfu") || itszEqualsIgnoreCase(line, "itsz:dfu") ||
+           itszEqualsIgnoreCase(line, "itsz recovery") || itszEqualsIgnoreCase(line, "itsz:recovery");
+}
+
+bool itszIsRebootCommand(const char *line)
+{
+    return itszEqualsIgnoreCase(line, "itsz reboot") || itszEqualsIgnoreCase(line, "itsz:reboot");
+}
+
+bool itszRunRecoveryLine()
+{
+    itszRecoveryLine[itszRecoveryLineLen] = '\0';
+
+    if (itszIsBootloaderCommand(itszRecoveryLine)) {
+        Port.print("\r\nITSZ recovery: entering ESP32 ROM download mode\r\n");
+        Port.flush();
+        delay(250);
+        enterDfuMode();
+        return true;
+    }
+
+    if (itszIsRebootCommand(itszRecoveryLine)) {
+        Port.print("\r\nITSZ recovery: rebooting\r\n");
+        Port.flush();
+        rebootAtMsec = millis() + 250;
+        return true;
+    }
+
+    return false;
+}
+
+bool itszObserveRecoveryByte(uint8_t c)
+{
+    if (c == '\r' || c == '\n') {
+        if (itszRecoveryLineLen == 0)
+            return false;
+        bool handled = itszRunRecoveryLine();
+        itszRecoveryLineLen = 0;
+        return handled;
+    }
+
