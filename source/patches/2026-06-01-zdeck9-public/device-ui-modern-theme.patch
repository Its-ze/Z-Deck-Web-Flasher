+void TFTView_320x240::applyZDeckModernLayout(void)
+{
+    if (Themes::get() != Themes::eDark || !objects.main_screen)
+        return;
+
+    const uint32_t h = lv_display_get_horizontal_resolution(displaydriver->getDisplay());
+    const uint32_t v = lv_display_get_vertical_resolution(displaydriver->getDisplay());
+    const bool largeDisplay = h > 320 && v > 320;
+    const int32_t navSize = largeDisplay ? 64 : 34;
+    const int32_t statusIconSize = largeDisplay ? 42 : 34;
+
+    lv_obj_set_style_bg_color(objects.main_screen, zDeckModernBg, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_text_color(objects.main_screen, zDeckModernText, LV_PART_MAIN | LV_STATE_DEFAULT);
+
+    lv_obj_t *topPanels[] = {objects.top_panel, objects.top_settings_panel, objects.top_advanced_settings_panel,
+                             objects.top_node_options_panel};
+    for (lv_obj_t *panel : topPanels) {
+        zDeckModernFrame(panel, zDeckModernSurface, zDeckModernLine, 255);
+        if (panel)
+            lv_obj_set_style_radius(panel, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
+    }
+
+    if (objects.button_panel) {
+        zDeckModernFrame(objects.button_panel, zDeckModernSurface, zDeckModernLine, 255);
+        lv_obj_set_style_border_side(objects.button_panel, LV_BORDER_SIDE_RIGHT, LV_PART_MAIN | LV_STATE_DEFAULT);
+        lv_obj_set_style_radius(objects.button_panel, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
+        lv_obj_set_style_pad_row(objects.button_panel, 4, LV_PART_MAIN | LV_STATE_DEFAULT);
+        lv_obj_set_style_pad_column(objects.button_panel, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
+    }
+
+    lv_obj_t *navButtons[] = {objects.home_button, objects.nodes_button,    objects.groups_button,
+                              objects.messages_button, objects.map_button, objects.settings_button};
+    for (lv_obj_t *button : navButtons) {
+        if (!button)
+            continue;
+        lv_obj_set_size(button, navSize, navSize);
+        zDeckModernIconButton(button, zDeckModernDim);
+    }
+    if (activeButton)
+        setNavButtonActive(activeButton);
+
+    lv_obj_t *mainPanels[] = {objects.home_panel, objects.nodes_panel, objects.groups_panel, objects.messages_panel,
+                              objects.controller_panel, objects.node_options_panel};
+    for (lv_obj_t *panel : mainPanels) {
+        zDeckModernFrame(panel, zDeckModernBg, zDeckModernBg, 255);
+        if (panel) {
+            lv_obj_set_style_border_width(panel, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
+            lv_obj_set_style_radius(panel, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
+        }
+    }
+
+    if (objects.home_container) {
+        zDeckModernFrame(objects.home_container, zDeckModernSurface, zDeckModernLine, 255);
+        lv_obj_set_style_pad_left(objects.home_container, largeDisplay ? 9 : 6, LV_PART_MAIN | LV_STATE_DEFAULT);
+        lv_obj_set_style_pad_right(objects.home_container, 5, LV_PART_MAIN | LV_STATE_DEFAULT);
+        lv_obj_set_style_pad_top(objects.home_container, 5, LV_PART_MAIN | LV_STATE_DEFAULT);
+        lv_obj_set_style_pad_bottom(objects.home_container, 5, LV_PART_MAIN | LV_STATE_DEFAULT);
+        lv_obj_set_style_pad_column(objects.home_container, 6, LV_PART_MAIN | LV_STATE_DEFAULT);
+        lv_obj_set_style_pad_row(objects.home_container, 3, LV_PART_MAIN | LV_STATE_DEFAULT);
+    }
+
+    lv_obj_t *statusButtons[] = {objects.home_mail_button,      objects.home_nodes_button,    objects.home_time_button,
+                                 objects.home_lora_button,      objects.home_signal_button,   objects.home_bell_button,
+                                 objects.home_location_button,  objects.home_wlan_button,     objects.home_ethernet_button,
+                                 objects.home_bluetooth_button, objects.home_mqtt_button,     objects.home_sd_card_button,
+                                 objects.home_memory_button,    objects.home_qr_button};
+    for (lv_obj_t *button : statusButtons) {
+        if (!button)
+            continue;
+        lv_obj_set_size(button, statusIconSize, statusIconSize);
+        zDeckModernIconButton(button, zDeckModernDim);
+    }
+
+    zDeckModernIconButton(objects.home_mail_button, zDeckModernAccent2);
+    zDeckModernIconButton(objects.home_nodes_button, zDeckModernGood);
+    zDeckModernIconButton(objects.home_lora_button, db.config.lora.tx_enabled ? zDeckModernAccent : zDeckModernSoft);
+    zDeckModernIconButton(objects.home_signal_button, zDeckModernAccent2);
+    zDeckModernIconButton(objects.home_bell_button, db.uiConfig.alert_enabled || !db.silent ? zDeckModernWarn : zDeckModernSoft);
+    zDeckModernIconButton(objects.home_location_button,
+                          db.config.position.gps_mode == meshtastic_Config_PositionConfig_GpsMode_ENABLED ? zDeckModernGood
+                                                                                                          : zDeckModernSoft);
+    zDeckModernIconButton(objects.home_wlan_button, db.config.network.wifi_enabled ? zDeckModernAccent2 : zDeckModernSoft);
+    zDeckModernIconButton(objects.home_mqtt_button, db.module_config.mqtt.enabled ? zDeckModernAccent : zDeckModernSoft);
+    zDeckModernIconButton(objects.home_sd_card_button, cardDetected ? zDeckModernGood : zDeckModernWarn);
+    zDeckModernIconButton(objects.home_memory_button, zDeckModernMagenta);
+    zDeckModernIconButton(objects.home_qr_button, zDeckModernAccent2);
+
+    lv_obj_t *statusLabels[] = {objects.home_mail_label,      objects.home_nodes_label,    objects.home_time_label,
+                                objects.home_lora_label,      objects.home_signal_label,   objects.home_signal_pct_label,
+                                objects.home_bell_label,      objects.home_location_label, objects.home_wlan_label,
+                                objects.home_ethernet_label,  objects.home_bluetooth_label, objects.home_mqtt_label,
+                                objects.home_sd_card_label,   objects.home_memory_label,   objects.home_qr_label};
+    for (lv_obj_t *label : statusLabels)
+        zDeckModernStatusLabel(label);
+
+    auto setStatusText = [](lv_obj_t *obj, bool active) {
+        if (obj)
+            lv_obj_set_style_text_color(obj, active ? zDeckModernText : zDeckModernDim, LV_PART_MAIN | LV_STATE_DEFAULT);
+    };
+    setStatusText(objects.home_lora_label, db.config.lora.tx_enabled);
+    setStatusText(objects.home_bell_label, db.uiConfig.alert_enabled || !db.silent);
+    setStatusText(objects.home_location_label, db.config.position.gps_mode == meshtastic_Config_PositionConfig_GpsMode_ENABLED);
+    setStatusText(objects.home_wlan_label, db.config.network.wifi_enabled);
+    setStatusText(objects.home_mqtt_label, db.module_config.mqtt.enabled);
+    setStatusText(objects.home_sd_card_label, cardDetected);
+
+    if (objects.tab_page_tools) {
+        lv_obj_set_style_bg_color(objects.tab_page_tools, zDeckModernBg, LV_PART_MAIN | LV_STATE_DEFAULT);
+        lv_obj_set_style_pad_row(objects.tab_page_tools, 5, LV_PART_MAIN | LV_STATE_DEFAULT);
+    }
+
+    zDeckModernFrame(zDeckHealthButton, zDeckModernPanel, zDeckModernAccent);
+    zDeckModernFrame(zDeckHealthPanel, zDeckModernPanel, zDeckModernAccent, 245);
+    zDeckModernFrame(zDeckSdButton, zDeckModernPanel, zDeckModernWarn);
+    zDeckModernFrame(zDeckSdPanel, zDeckModernPanel, zDeckModernWarn, 245);
+    zDeckModernFrame(screenCorrectionButton, zDeckModernPanel, zDeckModernAccent2);
+    if (zDeckHealthButtonLabel)
+        lv_obj_set_style_text_color(zDeckHealthButtonLabel, zDeckModernText, LV_PART_MAIN | LV_STATE_DEFAULT);
+    if (zDeckHealthLabel)
+        lv_obj_set_style_text_color(zDeckHealthLabel, zDeckModernText, LV_PART_MAIN | LV_STATE_DEFAULT);
+    if (zDeckSdButtonLabel)
+        lv_obj_set_style_text_color(zDeckSdButtonLabel, zDeckModernText, LV_PART_MAIN | LV_STATE_DEFAULT);
+    if (zDeckSdLabel)
+        lv_obj_set_style_text_color(zDeckSdLabel, zDeckModernText, LV_PART_MAIN | LV_STATE_DEFAULT);
+    if (screenCorrectionButtonLabel)
+        lv_obj_set_style_text_color(screenCorrectionButtonLabel, zDeckModernText, LV_PART_MAIN | LV_STATE_DEFAULT);
+
+    zDeckModernFrame(sdSetupPanel, zDeckModernSurface, zDeckModernAccent, 255);
+    zDeckModernFrame(sdSetupIgnoreButton, zDeckModernPanel, zDeckModernLine);
+    zDeckModernFrame(sdSetupFormatButton, zDeckModernPanel, zDeckModernWarn);
+    if (sdSetupStatusLabel)
+        lv_obj_set_style_text_color(sdSetupStatusLabel, zDeckModernWarn, LV_PART_MAIN | LV_STATE_DEFAULT);
+
+    if (bootProgressBar) {
+        lv_obj_set_style_bg_color(bootProgressBar, zDeckModernLine, LV_PART_MAIN | LV_STATE_DEFAULT);
+        lv_obj_set_style_bg_opa(bootProgressBar, 160, LV_PART_MAIN | LV_STATE_DEFAULT);
+        lv_obj_set_style_bg_color(bootProgressBar, zDeckModernAccent, LV_PART_INDICATOR | LV_STATE_DEFAULT);
+        lv_obj_set_style_bg_opa(bootProgressBar, 255, LV_PART_INDICATOR | LV_STATE_DEFAULT);
+    }
+}
