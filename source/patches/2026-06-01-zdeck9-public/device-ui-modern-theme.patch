+static void zDeckModernFrame(lv_obj_t *obj, lv_color_t bg, lv_color_t border, lv_opa_t opa = 245)
+{
+    if (!obj)
+        return;
+
+    lv_obj_set_style_bg_color(obj, bg, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_bg_opa(obj, opa, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_border_color(obj, border, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_border_width(obj, 1, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_border_opa(obj, 220, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_radius(obj, 7, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_shadow_width(obj, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_text_color(obj, zDeckModernText, LV_PART_MAIN | LV_STATE_DEFAULT);
+}
+
+static void zDeckModernIconButton(lv_obj_t *obj, lv_color_t accent)
+{
+    if (!obj)
+        return;
+
+    zDeckModernFrame(obj, zDeckModernPanel, zDeckModernLine);
+    lv_obj_set_style_bg_color(obj, zDeckModernPanel2, LV_PART_MAIN | LV_STATE_PRESSED);
+    lv_obj_set_style_border_color(obj, accent, LV_PART_MAIN | LV_STATE_CHECKED);
+    lv_obj_set_style_outline_color(obj, accent, LV_PART_MAIN | LV_STATE_FOCUSED);
+    lv_obj_set_style_outline_width(obj, 1, LV_PART_MAIN | LV_STATE_FOCUSED);
+    lv_obj_set_style_bg_image_recolor(obj, accent, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_bg_image_recolor_opa(obj, 255, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_bg_img_recolor(obj, accent, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_bg_img_recolor_opa(obj, 255, LV_PART_MAIN | LV_STATE_DEFAULT);
+}
+
+static void zDeckModernStatusLabel(lv_obj_t *obj)
