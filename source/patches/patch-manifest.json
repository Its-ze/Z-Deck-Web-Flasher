{
    "name":  "zdeck-public-stack",
    "description":  "Public Z-Deck firmware layer for LilyGO T-Deck/T-Deck Plus on Meshtastic 2.8. Adds the Z-Deck identity/version surface, GPS/compass refresh fixes, map/cache status, clearer message delivery labels, hop counters where packet route data exposes them, SD message journal support, screen correction tools, and a public on-device health panel.",
    "release":  {
                    "label":  "Z-Deck 0.2.0-public",
                    "firmwareVersion":  "2.8.0.zdeck2",
                    "packVersion":  "0.2.0-public",
                    "channelDefaults":  "LongFast only",
                    "privateChannelsBundled":  false,
                    "privateKeysBundled":  false,
                    "adminKeysBundled":  false
                },
    "targetDevice":  {
                         "longName":  "Z-Deck T-Deck",
                         "shortName":  "ZDK",
                         "platformEnvironment":  "t-deck-tft",
                         "hardwareModel":  "T_DECK",
                         "flashSize":  "16MB",
                         "sdCard":  "Supported for maps and local message journal; not required to boot."
                     },
    "source":  {
                   "repository":  "https://github.com/meshtastic/firmware.git",
                   "branch":  "2.8",
                   "patchBase":  "origin/2.8"
               },
    "build":  {
                  "artifactFolder":  "firmware/zdeck-2.8.0-zdeck2-public",
                  "latestBuiltFrom":  "20260531-122626-t-deck-tft",
                  "status":  "WSL build completed successfully. Runtime serial API verification still requires the hardware booted in normal mode rather than ESP32-S3 bootloader mode."
              },
    "patchFiles":  [
                       "device-ui-brand-version.patch",
                       "device-ui-map.patch",
                       "device-ui-map-internet.patch",
                       "device-ui-screen-correction.patch",
                       "device-ui-sd-message-journal.patch",
                       "device-ui-usability.patch",
                       "device-ui-polish.patch",
                       "device-ui-delivery-status.patch",
                       "device-ui-zdeck-public-stack.patch",
                       "zdeck-full-source.patch"
                   ],
    "publicSetup":  {
                        "ownerDefault":  "Z-Deck",
                        "shortNameDefault":  "ZDK",
                        "regionDefault":  "US",
                        "presetDefault":  "LongFast",
                        "hopLimitDefault":  3,
                        "notes":  "Users can add their own channels, PSKs, owner names, and admin configuration after flashing with the Meshtastic app or CLI. No private channel data is shipped."
                    }
}
