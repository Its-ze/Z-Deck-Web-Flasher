+void TFTView_320x240::setupZDeckMapFallbackGrid(void)
+{
+    if (zDeckMapFallbackGrid)
+        return;
+
+    zDeckMapFallbackGrid = lv_obj_create(objects.raw_map_panel);
+    lv_obj_set_size(zDeckMapFallbackGrid, lv_pct(100), 216 - zDeckMapPageBarHeight);
+    lv_obj_set_pos(zDeckMapFallbackGrid, 0, 0);
+    lv_obj_add_flag(zDeckMapFallbackGrid, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_clear_flag(zDeckMapFallbackGrid, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_clear_flag(zDeckMapFallbackGrid, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_set_style_bg_opa(zDeckMapFallbackGrid, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_border_width(zDeckMapFallbackGrid, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_radius(zDeckMapFallbackGrid, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_pad_all(zDeckMapFallbackGrid, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
+
+    for (uint8_t i = 0; i < zDeckMapFallbackLines.size(); ++i) {
+        lv_obj_t *line = lv_obj_create(zDeckMapFallbackGrid);
+        zDeckMapFallbackLines[i] = line;
+        lv_obj_clear_flag(line, LV_OBJ_FLAG_SCROLLABLE);
+        lv_obj_clear_flag(line, LV_OBJ_FLAG_CLICKABLE);
+        lv_obj_set_style_bg_color(line, LV_COLOR_HEX(0x356060), LV_PART_MAIN | LV_STATE_DEFAULT);
+        lv_obj_set_style_bg_opa(line, 135, LV_PART_MAIN | LV_STATE_DEFAULT);
+        lv_obj_set_style_border_width(line, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
+        lv_obj_set_style_radius(line, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
+        lv_obj_set_style_pad_all(line, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
+        if (i < 4) {
+            lv_obj_set_pos(line, 55 + i * 55, 0);
+            lv_obj_set_size(line, 1, 216 - zDeckMapPageBarHeight);
+        } else {
+            lv_obj_set_pos(line, 0, 37 + (i - 4) * 37);
+            lv_obj_set_size(line, lv_pct(100), 1);
+        }
+    }
+
+    zDeckMapFallbackCross = lv_obj_create(zDeckMapFallbackGrid);
+    lv_obj_set_pos(zDeckMapFallbackCross, 134, 81);
+    lv_obj_set_size(zDeckMapFallbackCross, 13, 13);
+    lv_obj_clear_flag(zDeckMapFallbackCross, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_clear_flag(zDeckMapFallbackCross, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_set_style_bg_opa(zDeckMapFallbackCross, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_border_color(zDeckMapFallbackCross, colorYellow, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_border_width(zDeckMapFallbackCross, 2, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_radius(zDeckMapFallbackCross, LV_RADIUS_CIRCLE, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_pad_all(zDeckMapFallbackCross, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
+
+    zDeckMapFallbackLabel = lv_label_create(zDeckMapFallbackGrid);
+    lv_obj_set_pos(zDeckMapFallbackLabel, 150, 93);
+    lv_obj_set_size(zDeckMapFallbackLabel, 126, 52);
+    lv_label_set_long_mode(zDeckMapFallbackLabel, LV_LABEL_LONG_WRAP);
+    zDeckStyleReadableMapLabel(zDeckMapFallbackLabel, colorYellow, &lv_font_montserrat_10);
+    lv_label_set_text(zDeckMapFallbackLabel, "SMART GRID\nWaiting for position");
+}
+
+void TFTView_320x240::updateZDeckMapFallbackGrid(bool visible, bool gpsReady)
+{
+    setupZDeckMapFallbackGrid();
+    if (!zDeckMapFallbackGrid)
+        return;
+
+    visible = visible && zDeckMapState.pageIndex() == 0;
+    if (!visible) {
+        lv_obj_add_flag(zDeckMapFallbackGrid, LV_OBJ_FLAG_HIDDEN);
+        return;
+    }
+
+    char label[88];
+    if (gpsReady) {
+        lv_snprintf(label, sizeof(label), "SMART GRID\n%.5f, %.5f", myLatitude * 1e-7, myLongitude * 1e-7);
+    } else if (db.config.position.gps_mode != meshtastic_Config_PositionConfig_GpsMode_NOT_PRESENT && gpsSatellites > 0) {
+        lv_snprintf(label, sizeof(label), "GPS ACQUIRING\n%u sats | use open sky", (unsigned int)gpsSatellites);
+    } else if (db.config.position.gps_mode != meshtastic_Config_PositionConfig_GpsMode_NOT_PRESENT) {
+        lv_snprintf(label, sizeof(label), "GPS SEARCHING\nOpen sky | WiFi or SD");
+    } else {
+        lv_snprintf(label, sizeof(label), "GPS OFF\nWiFi or SD tiles");
+    }
+    lv_label_set_text(zDeckMapFallbackLabel, label);
+    lv_obj_clear_flag(zDeckMapFallbackGrid, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_move_foreground(zDeckMapFallbackGrid);
+    lv_obj_move_foreground(objects.navigation_panel);
+}
