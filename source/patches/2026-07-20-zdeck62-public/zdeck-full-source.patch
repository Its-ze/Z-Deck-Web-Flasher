diff --git a/src/itsz/ZDeckDebugLog.cpp b/src/itsz/ZDeckDebugLog.cpp
new file mode 100644
index 000000000..9f4d0c1a8
--- /dev/null
+++ b/src/itsz/ZDeckDebugLog.cpp
@@ -0,0 +1,187 @@
+#include "itsz/ZDeckDebugLog.h"
+
+#include "configuration.h"
+
+#include <Arduino.h>
+#include <cstdio>
+#include <cstring>
+
+#if defined(ARCH_ESP32)
+#include <Preferences.h>
+#include <esp_system.h>
+#endif
+
+#if defined(ARCH_ESP32) && defined(HAS_SDCARD) && !defined(SDCARD_USE_SOFT_SPI)
+#include "FSCommon.h"
+#include "SPILock.h"
+#include <SD.h>
+#endif
+
+namespace itsz::zdeck_debug
+{
+namespace
+{
+
+constexpr const char *nvsNamespace = "zdeckdbg";
+constexpr const char *sdLogRoot = "/zdeck";
+constexpr const char *sdLogDir = "/zdeck/logs";
+constexpr const char *sdLogPath = "/zdeck/logs/zdeck-debug.log";
+constexpr size_t maxSdLogSize = 64U * 1024U;
+
+char lastLine[192] = "No Z-Deck debug breadcrumb yet.";
+
+void scrubCopy(const char *input, char *output, size_t outputSize)
+{
+    if (!output || outputSize == 0)
+        return;
+
+    output[0] = '\0';
+    if (!input)
+        return;
+
+    size_t out = 0;
+    for (size_t in = 0; input[in] && out + 1 < outputSize; ++in) {
+        char c = input[in];
+        if (c == '\n' || c == '\r' || c == '\t')
+            c = ' ';
+        output[out++] = c;
+    }
+    output[out] = '\0';
+}
+
+uint32_t freeHeap()
+{
+#if defined(ARCH_ESP32)
+    return esp_get_free_heap_size();
+#else
+    return 0;
+#endif
+}
+
+uint32_t minFreeHeap()
+{
+#if defined(ARCH_ESP32)
+    return esp_get_minimum_free_heap_size();
+#else
+    return 0;
+#endif
+}
+
+int resetReason()
+{
+#if defined(ARCH_ESP32)
+    return static_cast<int>(esp_reset_reason());
+#else
+    return 0;
+#endif
+}
+
+void writePersistent(const char *action, const char *stage, const char *detail)
+{
+#if defined(ARCH_ESP32)
+    Preferences prefs;
+    if (!prefs.begin(nvsNamespace, false))
+        return;
+
+    const uint32_t seq = prefs.getUInt("seq", 0) + 1U;
+    prefs.putUInt("seq", seq);
+    prefs.putString("action", action ? action : "");
+    prefs.putString("stage", stage ? stage : "");
+    prefs.putString("detail", detail ? detail : "");
+    prefs.putUInt("ms", millis());
+    prefs.putUInt("heap", freeHeap());
+    prefs.putUInt("minheap", minFreeHeap());
+    prefs.putInt("reset", resetReason());
+    prefs.end();
+#else
+    (void)action;
+    (void)stage;
+    (void)detail;
+#endif
+}
+
+void appendSdLog(const char *line)
+{
+#if defined(ARCH_ESP32) && defined(HAS_SDCARD) && !defined(SDCARD_USE_SOFT_SPI)
+    if (!line || !line[0])
+        return;
+
+    setupSDCard();
+    concurrency::LockGuard guard(spiLock);
+    if (SD.cardType() == CARD_NONE)
+        return;
+
+    SD.mkdir(sdLogRoot);
+    SD.mkdir(sdLogDir);
+
+    File existing = SD.open(sdLogPath, FILE_READ);
+    if (existing) {
+        const size_t size = existing.size();
+        existing.close();
+        if (size > maxSdLogSize)
+            SD.remove(sdLogPath);
+    }
+
+    File log = SD.open(sdLogPath, FILE_APPEND);
+    if (!log)
+        return;
+    log.println(line);
+    log.flush();
+    log.close();
+#else
+    (void)line;
+#endif
+}
+
+} // namespace
+
+void breadcrumb(const char *action, const char *stage, const char *detail, bool persist, bool appendToSd)
+{
+    char safeAction[32];
+    char safeStage[48];
+    char safeDetail[80];
+    scrubCopy(action, safeAction, sizeof(safeAction));
+    scrubCopy(stage, safeStage, sizeof(safeStage));
+    scrubCopy(detail, safeDetail, sizeof(safeDetail));
+
+    snprintf(lastLine, sizeof(lastLine), "%lu %s/%s %s heap=%lu min=%lu reset=%d", static_cast<unsigned long>(millis()),
+             safeAction[0] ? safeAction : "zdeck", safeStage[0] ? safeStage : "stage", safeDetail,
+             static_cast<unsigned long>(freeHeap()), static_cast<unsigned long>(minFreeHeap()), resetReason());
+
+    LOG_INFO("ZDECKDBG %s", lastLine);
+
+    if (persist)
+        writePersistent(safeAction, safeStage, safeDetail);
+    if (appendToSd)
+        appendSdLog(lastLine);
+}
+
+const char *lastSummary()
+{
+#if defined(ARCH_ESP32)
+    static char summary[192];
+    Preferences prefs;
+    if (prefs.begin(nvsNamespace, true)) {
+        const uint32_t seq = prefs.getUInt("seq", 0);
+        const String action = prefs.getString("action", "");
+        const String stage = prefs.getString("stage", "");
+        const String detail = prefs.getString("detail", "");
+        const uint32_t ms = prefs.getUInt("ms", 0);
+        const uint32_t heap = prefs.getUInt("heap", 0);
+        const uint32_t minHeap = prefs.getUInt("minheap", 0);
+        const int reset = prefs.getInt("reset", 0);
+        prefs.end();
+
+        if (seq > 0) {
+            snprintf(summary, sizeof(summary), "Debug #%lu %s/%s %s ms=%lu heap=%lu min=%lu reset=%d",
+                     static_cast<unsigned long>(seq), action.c_str(), stage.c_str(), detail.c_str(),
+                     static_cast<unsigned long>(ms), static_cast<unsigned long>(heap),
+                     static_cast<unsigned long>(minHeap), reset);
+            return summary;
+        }
+    }
+#endif
+    return lastLine;
+}
+
+} // namespace itsz::zdeck_debug
