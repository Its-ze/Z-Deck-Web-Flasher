+void menuHandler::updateMenu()
+{
+    enum optionsNumbers { Back, Check, Apply, Backup, Restore, Status, enumEnd };
+
+    static const char *optionsArray[] = {"Back", "Check for Updates", "Apply Update", "Backup Settings", "Restore Settings",
+                                         "Update Status"};
+    BannerOverlayOptions bannerOptions;
+    bannerOptions.message = "Z-Deck Updates";
+    bannerOptions.optionsArrayPtr = optionsArray;
+    bannerOptions.optionsCount = enumEnd;
+    bannerOptions.bannerCallback = [](int selected) -> void {
+        if (selected == Check) {
+            itsz::zdeck_update::checkForUpdates();
+            if (itsz::zdeck_update::hasCachedUpdate()) {
+                static char message[192];
+                snprintf(message, sizeof(message), "Apply %s?\nSD backup first.",
+                         itsz::zdeck_update::cachedInfo().packVersion.c_str());
+                menuHandler::showConfirmationBanner(message, []() -> void { itsz::zdeck_update::applyCachedUpdate(); });
+            }
+        } else if (selected == Apply) {
+            if (!itsz::zdeck_update::hasCachedUpdate()) {
+                itsz::zdeck_update::checkForUpdates();
+            }
+            if (itsz::zdeck_update::hasCachedUpdate()) {
+                static char message[192];
+                snprintf(message, sizeof(message), "Apply %s?\nSD backup first.",
+                         itsz::zdeck_update::cachedInfo().packVersion.c_str());
+                menuHandler::showConfirmationBanner(message, []() -> void { itsz::zdeck_update::applyCachedUpdate(); });
+            }
+        } else if (selected == Backup) {
+            const bool queued = itsz::zdeck_update::requestSdBackup();
+            IF_SCREEN(screen->showSimpleBanner(queued ? "Settings backup\nqueued." : "Z-Deck task\nalready running.",
+                                               queued ? 3000 : 5000));
+        } else if (selected == Restore) {
+            menuHandler::showConfirmationBanner("Restore settings\nfrom SD and reboot?", []() -> void {
+                const bool queued = itsz::zdeck_update::requestSdRestore();
+                IF_SCREEN(screen->showSimpleBanner(queued ? "Settings restore\nqueued." : "Z-Deck task\nalready running.",
+                                                   queued ? 3000 : 5000));
+            });
+        } else if (selected == Status) {
+            IF_SCREEN(screen->showSimpleBanner(itsz::zdeck_update::statusText(), 7000));
+        }
+    };
+    screen->showOverlayBanner(bannerOptions);
+}
