+++ b/src/itsz/ZDeckStateModel.h
@@ -0,0 +1,50 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace itsz::zdeck_state
+{
+
+enum class Subsystem : uint8_t {
+    Ota = 0,
+    Sd,
+    Map,
+    Chat,
+    Count,
+};
+
+enum class State : uint8_t {
+    Unknown = 0,
+    Idle,
+    Ready,
+    Busy,
+    Waiting,
+    Warning,
+    Error,
+};
+
+struct Snapshot {
+    State state;
+    uint8_t progress;
+    uint32_t updatedMs;
+    char detail[80];
+};
+
+void set(Subsystem subsystem, State state, const char *detail = nullptr, int progress = -1);
+void setOta(State state, const char *detail = nullptr, int progress = -1);
+void setSd(State state, const char *detail = nullptr, int progress = -1);
+void setMap(State state, const char *detail = nullptr, int progress = -1);
+void setChat(State state, const char *detail = nullptr, int progress = -1);
+
+Snapshot get(Subsystem subsystem);
+
+const char *label(Subsystem subsystem);
+const char *stateLabel(State state);
+const char *stateToken(State state);
+
+void formatLine(Subsystem subsystem, char *out, size_t outSize);
+void formatCompact(char *out, size_t outSize);
+void formatDiagnostics(char *out, size_t outSize);
+
+} // namespace itsz::zdeck_state
diff --git a/src/itsz/ZDeckUpdateService.cpp b/src/itsz/ZDeckUpdateService.cpp
new file mode 100644
index 000000000..8b6f9bca4
--- /dev/null
+++ b/src/itsz/ZDeckUpdateService.cpp
@@ -0,0 +1,589 @@
+#include "itsz/ZDeckUpdateService.h"
+
+#if defined(ARCH_ESP32) && HAS_WIFI && defined(ZDECK_PUBLIC_BUILD)
+
+#include "NodeDB.h"
+#include "concurrency/Periodic.h"
+#include "itsz/ZDeckDebugLog.h"
+#include "itsz/ZDeckDualBoot.h"
+#include "itsz/ZDeckStateModel.h"
+#include "main.h"
+#include "meshUtils.h"
+#include <HTTPClient.h>
+#include <Update.h>
+#include <WiFi.h>
+#include <WiFiClientSecure.h>
+#include <esp_partition.h>
+#include <cctype>
+#include <cstring>
+
+#ifndef ZDECK_UPDATE_MANIFEST_URL
+#define ZDECK_UPDATE_MANIFEST_URL "https://its-ze.github.io/Z-Deck-Web-Flasher/update.json"
+#endif
+#ifndef ZDECK_OTA_MANIFEST_URL
+#define ZDECK_OTA_MANIFEST_URL "https://its-ze.github.io/Z-Deck-Web-Flasher/update-ota.json"
+#endif
+
+namespace itsz::zdeck_update
+{
+
+static UpdateInfo latestInfo;
+static char statusBuffer[192] = "No update check yet.";
+
+enum class DeferredAction : uint8_t { None, Backup, Restore, CheckUpdate, ApplyUpdate };
+static DeferredAction pendingAction = DeferredAction::None;
+static bool deferredBusy = false;
+static concurrency::Periodic *deferredWorker = nullptr;
+
+static int32_t runDeferredAction();
+static bool performCheckForUpdates();
+static bool performApplyCachedUpdate();
+
+static void ensureDeferredWorker()
+{
+    if (!deferredWorker)
+        deferredWorker = new concurrency::Periodic("ZDeckMaint", runDeferredAction);
+    deferredWorker->setIntervalFromNow(100);
+}
+
+static itsz::zdeck_state::State stateFromStatus(const char *message)
+{
+    if (!message || !message[0])
+        return itsz::zdeck_state::State::Unknown;
+
+    if (strstr(message, "failed") || strstr(message, "Failed") || strstr(message, "mismatch") ||
+        strstr(message, "timed out") || strstr(message, "dropped") || strstr(message, "cancelled") ||
+        strstr(message, "Bad") || strstr(message, "Could not") || strstr(message, "missing")) {
+        return itsz::zdeck_state::State::Error;
+    }
+
+    if (strstr(message, "No newer") || strstr(message, "No update"))
+        return itsz::zdeck_state::State::Idle;
+
+    if (strstr(message, "Checking") || strstr(message, "Downloading") || strstr(message, "Saving") ||
+        strstr(message, "Applying") || strstr(message, "Updating") || strstr(message, "Backing up") ||
+        strstr(message, "Restoring")) {
+        return itsz::zdeck_state::State::Busy;
+    }
+
+    if (strstr(message, "available") || strstr(message, "current") || strstr(message, "ready") ||
+        strstr(message, "backed up") || strstr(message, "saved to SD") || strstr(message, "restored") ||
+        strstr(message, "installed")) {
+        return itsz::zdeck_state::State::Ready;
+    }
+
+    return itsz::zdeck_state::State::Busy;
+}
+
+static void setStatus(const char *message)
+{
+    snprintf(statusBuffer, sizeof(statusBuffer), "%s", message);
+    itsz::zdeck_state::setOta(stateFromStatus(message), statusBuffer);
+    LOG_INFO("Z-Deck update: %s", statusBuffer);
+}
+
+static void pumpStatus(uint32_t pauseMs = 1)
+{
+    IF_SCREEN(screen->runNow());
+    if (pauseMs)
+        delay(pauseMs);
+    else
+        yield();
+}
+
+static void showStatus(const char *message, uint32_t durationMs = 5000)
+{
+    setStatus(message);
+    IF_SCREEN(screen->showSimpleBanner(statusBuffer, durationMs));
+    pumpStatus(10);
+}
+
+static int32_t runDeferredAction()
+{
+    if (deferredBusy || pendingAction == DeferredAction::None)
+        return 1000;
+
+    const DeferredAction action = pendingAction;
+    pendingAction = DeferredAction::None;
+    deferredBusy = true;
+
+    if (action == DeferredAction::Backup) {
+        showStatus("Saving settings\nbackup to SD...", 0);
+        itsz::zdeck_debug::breadcrumb("ui-backup", "deferred.begin");
+        const bool ok = nodeDB && nodeDB->backupPreferences(meshtastic_AdminMessage_BackupLocation_SD);
+        itsz::zdeck_debug::breadcrumb("ui-backup", ok ? "deferred.ok" : "deferred.fail", nullptr, true, true);
+        showStatus(ok ? "Settings backup\nsaved to SD." : "SD backup failed.\nCheck the card.", ok ? 5000 : 7000);
+    } else if (action == DeferredAction::Restore) {
+        showStatus("Restoring settings\nfrom SD...", 0);
+        itsz::zdeck_debug::breadcrumb("ui-restore", "deferred.begin");
+        const bool ok = nodeDB &&
+                        nodeDB->restorePreferences(meshtastic_AdminMessage_BackupLocation_SD,
+                                                    SEGMENT_CONFIG | SEGMENT_MODULECONFIG | SEGMENT_DEVICESTATE |
+                                                        SEGMENT_CHANNELS);
+        itsz::zdeck_debug::breadcrumb("ui-restore", ok ? "deferred.ok" : "deferred.fail", nullptr, true, true);
+        if (ok) {
+            showStatus("Settings restored.\nRebooting...", 0);
+            rebootAtMsec = millis() + 2000;
+        } else {
+            showStatus("SD restore failed.\nNo changes saved.", 7000);
+        }
+    } else if (action == DeferredAction::CheckUpdate) {
+        performCheckForUpdates();
+    } else if (action == DeferredAction::ApplyUpdate) {
+        performApplyCachedUpdate();
+    }
+
+    deferredBusy = false;
+    return 1000;
+}
+
+static bool queueDeferredAction(DeferredAction action, const char *queuedStatus, const char *busyStatus)
+{
+    if (deferredBusy || pendingAction != DeferredAction::None) {
+        setStatus(busyStatus);
+        return false;
+    }
+
+    pendingAction = action;
+    setStatus(queuedStatus);
+    ensureDeferredWorker();
+    return true;
+}
+
+bool requestSdBackup()
+{
+    return queueDeferredAction(DeferredAction::Backup, "SD backup queued.", "Another Z-Deck task is already running.");
+}
+
+bool requestSdRestore()
+{
+    return queueDeferredAction(DeferredAction::Restore, "SD restore queued.", "Another Z-Deck task is already running.");
+}
+
+static bool extractJsonString(const String &json, const char *key, String &value)
+{
+    String needle = String("\"") + key + "\"";
+    int keyPos = json.indexOf(needle);
+    if (keyPos < 0)
+        return false;
+
+    int colonPos = json.indexOf(':', keyPos + needle.length());
+    if (colonPos < 0)
+        return false;
+
+    int start = json.indexOf('"', colonPos + 1);
+    if (start < 0)
+        return false;
+
+    String out;
+    bool escaped = false;
+    for (int i = start + 1; i < json.length(); i++) {
+        char c = json.charAt(i);
+        if (escaped) {
+            out += c;
+            escaped = false;
+            continue;
+        }
+        if (c == '\\') {
+            escaped = true;
+            continue;
+        }
+        if (c == '"') {
+            value = out;
+            return true;
+        }
+        out += c;
+    }
+    return false;
+}
+
+static bool extractJsonUInt(const String &json, const char *key, uint32_t &value)
+{
+    String needle = String("\"") + key + "\"";
+    int keyPos = json.indexOf(needle);
+    if (keyPos < 0)
+        return false;
+
+    int colonPos = json.indexOf(':', keyPos + needle.length());
+    if (colonPos < 0)
+        return false;
+
+    int start = colonPos + 1;
+    while (start < json.length() && isspace((unsigned char)json.charAt(start)))
+        start++;
+
+    uint32_t parsed = 0;
+    bool sawDigit = false;
+    for (int i = start; i < json.length(); i++) {
+        char c = json.charAt(i);
+        if (!isdigit((unsigned char)c))
+            break;
+        sawDigit = true;
+        parsed = (parsed * 10U) + (uint32_t)(c - '0');
+    }
+
+    if (!sawDigit)
+        return false;
+
+    value = parsed;
+    return true;
+}
+
+static int nextVersionNumber(const String &version, int &offset)
+{
+    while (offset < version.length() && !isdigit((unsigned char)version.charAt(offset)))
+        offset++;
+
+    if (offset >= version.length())
+        return -1;
+
+    int value = 0;
+    while (offset < version.length() && isdigit((unsigned char)version.charAt(offset))) {
+        value = (value * 10) + (version.charAt(offset) - '0');
+        offset++;
+    }
+
+    return value;
+}
+
+static bool isVersionNewer(const String &available, const String &current)
+{
+    int availableOffset = 0;
+    int currentOffset = 0;
+
+    while (availableOffset < available.length() || currentOffset < current.length()) {
+        int a = nextVersionNumber(available, availableOffset);
+        int c = nextVersionNumber(current, currentOffset);
+        if (a < 0 && c < 0)
+            break;
+        if (a < 0)
+            a = 0;
+        if (c < 0)
+            c = 0;
+        if (a != c)
+            return a > c;
+    }
+
+    return available != current;
+}
+
+static bool parseManifest(const String &payload, UpdateInfo &info)
+{
+    UpdateInfo parsed;
+    extractJsonString(payload, "title", parsed.title);
+    extractJsonString(payload, "packVersion", parsed.packVersion);
+    extractJsonString(payload, "firmwareVersion", parsed.firmwareVersion);
+    extractJsonString(payload, "url", parsed.firmwareUrl);
+    extractJsonString(payload, "md5", parsed.md5);
+    extractJsonString(payload, "sha256", parsed.sha256);
+    extractJsonString(payload, "updateMode", parsed.updateMode);
+    extractJsonUInt(payload, "size", parsed.size);
+
+    if (parsed.packVersion.isEmpty() || parsed.firmwareUrl.isEmpty() || parsed.size == 0) {
+        setStatus("Update manifest is missing required app fields.");
+        return false;
+    }
+
+    if (!parsed.updateMode.isEmpty() && parsed.updateMode != "app-only") {
+        setStatus("Update requires a migration not supported by this firmware.");
+        return false;
+    }
+
+    parsed.valid = true;
+    parsed.updateAvailable = isVersionNewer(parsed.packVersion, currentPackVersion());
+    info = parsed;
+    return true;
+}
+
+static bool beginHttp(HTTPClient &http, WiFiClientSecure &client, const String &url)
+{
+    client.setInsecure();
+    http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
+    http.setConnectTimeout(10000);
+    http.setTimeout(15000);
+    http.setUserAgent("Z-Deck-Updater/" + String(currentPackVersion()));
+    return http.begin(client, url);
+}
+
+static const char *manifestUrlForLayout()
+{
+    const esp_partition_t *dedicatedMeshCore =
+        esp_partition_find_first(ESP_PARTITION_TYPE_APP, ESP_PARTITION_SUBTYPE_APP_TEST, "meshcore");
+    return dedicatedMeshCore ? ZDECK_OTA_MANIFEST_URL : ZDECK_UPDATE_MANIFEST_URL;
+}
+
+static bool performCheckForUpdates()
+{
+    itsz::zdeck_debug::breadcrumb("ota", "check.begin");
+    if (WiFi.status() != WL_CONNECTED) {
+        itsz::zdeck_debug::breadcrumb("ota", "check.no-wifi", nullptr, true, false);
+        showStatus("WiFi is not connected.\nEnable WiFi first.", 6000);
+        return false;
+    }
+
+    showStatus("Checking for\nZ-Deck updates...", 0);
+
+    HTTPClient http;
+    WiFiClientSecure client;
+    itsz::zdeck_debug::breadcrumb("ota", "manifest.begin");
+    if (!beginHttp(http, client, manifestUrlForLayout())) {
+        itsz::zdeck_debug::breadcrumb("ota", "manifest.begin.fail");
+        showStatus("Could not open\nupdate manifest.", 6000);
+        return false;
+    }
+
+    int httpCode = http.GET();
+    char detail[80];
+    snprintf(detail, sizeof(detail), "http=%d", httpCode);
+    itsz::zdeck_debug::breadcrumb("ota", "manifest.http", detail);
+    if (httpCode != HTTP_CODE_OK) {
+        char msg[96];
+        snprintf(msg, sizeof(msg), "Update check failed.\nHTTP %d", httpCode);
+        http.end();
+        showStatus(msg, 6000);
+        return false;
+    }
+
+    String payload = http.getString();
+    http.end();
+    snprintf(detail, sizeof(detail), "bytes=%u", static_cast<unsigned>(payload.length()));
+    itsz::zdeck_debug::breadcrumb("ota", "manifest.read", detail);
+
+    UpdateInfo parsed;
+    if (!parseManifest(payload, parsed)) {
+        itsz::zdeck_debug::breadcrumb("ota", "manifest.parse.fail", statusBuffer);
+        showStatus(statusBuffer, 7000);
+        return false;
+    }
+
+    latestInfo = parsed;
+    snprintf(detail, sizeof(detail), "size=%lu newer=%u", static_cast<unsigned long>(latestInfo.size),
+             latestInfo.updateAvailable ? 1U : 0U);
+    itsz::zdeck_debug::breadcrumb("ota", "manifest.parse.ok", detail);
+
+    if (latestInfo.updateAvailable) {
+        char msg[128];
+        snprintf(msg, sizeof(msg), "Update available\n%s", latestInfo.packVersion.c_str());
+        showStatus(msg, 7000);
+    } else {
+        char msg[128];
+        snprintf(msg, sizeof(msg), "Z-Deck is current\n%s", currentPackVersion());
+        showStatus(msg, 5000);
+    }
+
+    return true;
+}
+
+static bool downloadAndInstallUpdate()
+{
+    showStatus("Settings preserved.\nStarting download...", 0);
+    showStatus("Downloading update\nDo not power off.", 0);
+
+    HTTPClient http;
+    WiFiClientSecure client;
+    itsz::zdeck_debug::breadcrumb("ota", "firmware.begin");
+    if (!beginHttp(http, client, latestInfo.firmwareUrl)) {
+        itsz::zdeck_debug::breadcrumb("ota", "firmware.begin.fail");
+        showStatus("Could not open\nfirmware image.", 6000);
+        return false;
+    }
+
+    int httpCode = http.GET();
+    char detail[80];
+    snprintf(detail, sizeof(detail), "http=%d", httpCode);
+    itsz::zdeck_debug::breadcrumb("ota", "firmware.http", detail);
+    if (httpCode != HTTP_CODE_OK) {
+        char msg[96];
+        snprintf(msg, sizeof(msg), "Firmware download failed.\nHTTP %d", httpCode);
+        http.end();
+        showStatus(msg, 7000);
+        return false;
+    }
+
+    int contentLength = http.getSize();
+    snprintf(detail, sizeof(detail), "content=%d expected=%lu", contentLength, static_cast<unsigned long>(latestInfo.size));
+    itsz::zdeck_debug::breadcrumb("ota", "firmware.size", detail);
+    if (contentLength <= 0 || (latestInfo.size != 0 && (uint32_t)contentLength != latestInfo.size)) {
+        http.end();
+        itsz::zdeck_debug::breadcrumb("ota", "firmware.size.fail", detail);
+        showStatus("Firmware size\nmismatch.", 7000);
+        return false;
+    }
+
+    itsz::zdeck_debug::breadcrumb("ota", "update.begin");
+    if (!Update.begin((size_t)contentLength, U_FLASH)) {
+        char msg[96];
+        snprintf(msg, sizeof(msg), "OTA start failed.\n%s", Update.errorString());
+        http.end();
+        itsz::zdeck_debug::breadcrumb("ota", "update.begin.fail", Update.errorString());
+        showStatus(msg, 7000);
+        return false;
+    }
+
+    if (latestInfo.md5.length() == 32 && !Update.setMD5(latestInfo.md5.c_str())) {
+        Update.abort();
+        http.end();
+        itsz::zdeck_debug::breadcrumb("ota", "update.md5.fail");
+        showStatus("Bad update hash\nmetadata.", 7000);
+        return false;
+    }
+
+    WiFiClient *stream = http.getStreamPtr();
+    uint8_t buffer[1024];
+    size_t written = 0;
+    int lastPercent = -1;
+    uint32_t lastProgressMs = 0;
+    uint32_t lastPumpMs = 0;
+    uint32_t lastDataMs = millis();
+    itsz::zdeck_debug::breadcrumb("ota", "write.loop.begin");
+
+    while (http.connected() && written < (size_t)contentLength) {
+        size_t available = stream->available();
+        if (available) {
+            size_t toRead = available;
+            if (toRead > sizeof(buffer))
+                toRead = sizeof(buffer);
+            if (toRead > ((size_t)contentLength - written))
+                toRead = (size_t)contentLength - written;
+
+            int got = stream->readBytes(buffer, toRead);
+            if (got <= 0)
+                continue;
+
+            size_t justWritten = Update.write(buffer, (size_t)got);
+            if (justWritten != (size_t)got) {
+                char msg[96];
+                snprintf(msg, sizeof(msg), "OTA write failed.\n%s", Update.errorString());
+                Update.abort();
+                http.end();
+                itsz::zdeck_debug::breadcrumb("ota", "write.fail", Update.errorString());
+                showStatus(msg, 7000);
+                return false;
+            }
+
+            written += justWritten;
+            uint32_t now = millis();
+            lastDataMs = now;
+            int percent = (int)((written * 100U) / (size_t)contentLength);
+            if (percent != lastPercent && (percent % 10 == 0 || now - lastProgressMs > 3000)) {
+                lastPercent = percent;
+                lastProgressMs = now;
+                char msg[96];
+                snprintf(msg, sizeof(msg), "Updating Z-Deck\n%d%% complete", percent);
+                itsz::zdeck_state::setOta(itsz::zdeck_state::State::Busy, msg, percent);
+                itsz::zdeck_debug::breadcrumb("ota", "write.progress", msg, false, false);
+                showStatus(msg, 0);
+                lastPumpMs = now;
+            } else if (now - lastPumpMs > 500) {
+                pumpStatus(0);
+                lastPumpMs = now;
+            }
+        } else {
+            if (millis() - lastDataMs > 30000) {
+                Update.abort();
+                http.end();
+                itsz::zdeck_debug::breadcrumb("ota", "download.timeout");
+                showStatus("Download timed out.", 7000);
+                return false;
+            }
+            pumpStatus(0);
+            delay(10);
+        }
+    }
+
+    http.end();
+
+    if (written != (size_t)contentLength) {
+        Update.abort();
+        snprintf(detail, sizeof(detail), "written=%lu expected=%d", static_cast<unsigned long>(written), contentLength);
+        itsz::zdeck_debug::breadcrumb("ota", "download.short", detail);
+        showStatus("Download ended early.", 7000);
+        return false;
+    }
+
+    itsz::zdeck_debug::breadcrumb("ota", "update.end.begin");
+    if (!Update.end()) {
+        char msg[96];
+        snprintf(msg, sizeof(msg), "OTA verify failed.\n%s", Update.errorString());
+        itsz::zdeck_debug::breadcrumb("ota", "update.end.fail", Update.errorString());
+        showStatus(msg, 7000);
+        return false;
+    }
+
+    itsz::zdeck_debug::breadcrumb("ota", "update.end.ok", nullptr, true, true);
+    showStatus("Update installed.\nRebooting...", 0);
+    delay(1200);
+    ESP.restart();
+    return true;
+}
+
+static bool performApplyCachedUpdate()
+{
+    itsz::zdeck_debug::breadcrumb("ota", "apply.begin");
+    if (!latestInfo.valid || !latestInfo.updateAvailable) {
+        if (!performCheckForUpdates())
+            return false;
+    }
+
+    if (!latestInfo.valid || !latestInfo.updateAvailable) {
+        itsz::zdeck_debug::breadcrumb("ota", "apply.no-update");
+        showStatus("No newer update\navailable.", 5000);
+        return false;
+    }
+
+    if (WiFi.status() != WL_CONNECTED) {
+        itsz::zdeck_debug::breadcrumb("ota", "apply.wifi-dropped");
+        showStatus("WiFi dropped.\nReconnect first.", 6000);
+        return false;
+    }
+
+    const esp_partition_t *dedicatedMeshCore =
+        esp_partition_find_first(ESP_PARTITION_TYPE_APP, ESP_PARTITION_SUBTYPE_APP_TEST, "meshcore");
+    if (!dedicatedMeshCore && itsz::zdeck_dual_boot::meshCoreAvailable()) {
+        itsz::zdeck_debug::breadcrumb("ota", "apply.legacy-dual-layout");
+        showStatus("USB migration required.\nOTA would overwrite MeshCore.", 8000);
+        return false;
+    }
+
+    return downloadAndInstallUpdate();
+}
+
+bool checkForUpdates()
+{
+    itsz::zdeck_debug::breadcrumb("ota", "check.queued");
+    return queueDeferredAction(DeferredAction::CheckUpdate, "Update check queued.", "Another Z-Deck task is running.");
+}
+
+bool applyCachedUpdate()
+{
+    itsz::zdeck_debug::breadcrumb("ota", "apply.queued");
+    return queueDeferredAction(DeferredAction::ApplyUpdate, "OTA update queued.", "Another Z-Deck task is running.");
+}
+
+bool hasCachedUpdate()
+{
+    return latestInfo.valid && latestInfo.updateAvailable;
+}
+
+const UpdateInfo &cachedInfo()
+{
+    return latestInfo;
+}
+
+const char *statusText()
+{
+    return statusBuffer;
+}
+
+const char *currentPackVersion()
+{
+#ifdef ZDECK_PACK_VERSION
+    return ZDECK_PACK_VERSION;
+#else
+    return xstr(APP_VERSION);
+#endif
+}
+
+} // namespace itsz::zdeck_update
+
+#endif
