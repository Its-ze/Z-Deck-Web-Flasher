+#include "itsz/ZDeckMeshModePolicy.h"
+
+namespace itsz::zdeck_mesh_mode
+{
+
+Assessment Policy::assess(bool meshCoreAvailable, uint16_t meshtasticNodesOnline, uint32_t secondsSinceMeshtasticRx,
+                          uint32_t observationSeconds)
+{
+    if (meshtasticNodesOnline >= 3)
+        return {Recommendation::Meshtastic, 95, "several Meshtastic nodes are online"};
+
+    if (meshtasticNodesOnline > 0 && secondsSinceMeshtasticRx <= 15 * 60)
+        return {Recommendation::Meshtastic, 85, "active Meshtastic nodes were heard nearby"};
+
+    if (secondsSinceMeshtasticRx <= 5 * 60)
+        return {Recommendation::Meshtastic, 80, "recent Meshtastic traffic was received"};
+
+    if (observationSeconds < 3 * 60)
+        return {Recommendation::Observe, 35, "listen for three minutes before switching"};
+
+    if (!meshCoreAvailable)
+        return {Recommendation::InstallMeshCore, 100, "MeshCore is not installed in app1"};
+
+    if (meshtasticNodesOnline == 0 && secondsSinceMeshtasticRx > 30 * 60)
+        return {Recommendation::MeshCore, 80, "Meshtastic has been quiet here; try MeshCore"};
+
+    return {Recommendation::MeshCore, 65, "no active Meshtastic neighbors were found"};
+}
+
+const char *Policy::label(Recommendation recommendation)
+{
+    switch (recommendation) {
+    case Recommendation::Meshtastic:
+        return "MESHTASTIC";
+    case Recommendation::MeshCore:
+        return "TRY MESHCORE";
+    case Recommendation::InstallMeshCore:
+        return "INSTALL MESHCORE";
+    case Recommendation::Observe:
+    default:
+        return "OBSERVE";
+    }
+}
+
+} // namespace itsz::zdeck_mesh_mode
