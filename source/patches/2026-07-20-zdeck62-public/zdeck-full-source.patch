diff --git a/src/itsz/ZDeckStateModel.cpp b/src/itsz/ZDeckStateModel.cpp
new file mode 100644
index 000000000..a2bbd5f7d
--- /dev/null
+++ b/src/itsz/ZDeckStateModel.cpp
@@ -0,0 +1,230 @@
+#include "itsz/ZDeckStateModel.h"
+
+#include "itsz/ZDeckDebugLog.h"
+
+#include <Arduino.h>
+#include <cstdio>
+#include <cstring>
+
+namespace itsz::zdeck_state
+{
+
+namespace
+{
+
+constexpr uint8_t progressUnknown = 255;
+
+Snapshot snapshots[] = {
+    {State::Idle, progressUnknown, 0, "No update check yet."},
+    {State::Unknown, progressUnknown, 0, "SD state not checked."},
+    {State::Unknown, progressUnknown, 0, "Map not opened yet."},
+    {State::Idle, progressUnknown, 0, "No chat activity yet."},
+};
+
+static_assert(sizeof(snapshots) / sizeof(snapshots[0]) == static_cast<size_t>(Subsystem::Count), "snapshot count mismatch");
+
+size_t subsystemIndex(Subsystem subsystem)
+{
+    const size_t index = static_cast<size_t>(subsystem);
+    if (index >= static_cast<size_t>(Subsystem::Count))
+        return 0;
+    return index;
+}
+
+void append(char *out, size_t outSize, const char *text)
+{
+    if (!out || outSize == 0 || !text)
+        return;
+
+    const size_t used = strnlen(out, outSize);
+    if (used >= outSize - 1)
+        return;
+
+    snprintf(out + used, outSize - used, "%s", text);
+}
+
+void appendLine(char *out, size_t outSize, const char *text)
+{
+    if (!out || outSize == 0 || !text)
+        return;
+
+    if (out[0])
+        append(out, outSize, "\n");
+    append(out, outSize, text);
+}
+
+void formatAge(uint32_t updatedMs, char *out, size_t outSize)
+{
+    if (!out || outSize == 0)
+        return;
+
+    if (updatedMs == 0) {
+        snprintf(out, outSize, "boot");
+        return;
+    }
+
+    const uint32_t ageSec = (millis() - updatedMs) / 1000U;
+    if (ageSec < 60U) {
+        snprintf(out, outSize, "%lus", static_cast<unsigned long>(ageSec));
+    } else if (ageSec < 3600U) {
+        snprintf(out, outSize, "%lum", static_cast<unsigned long>(ageSec / 60U));
+    } else {
+        snprintf(out, outSize, "%luh", static_cast<unsigned long>(ageSec / 3600U));
+    }
+}
+
+} // namespace
+
+void set(Subsystem subsystem, State state, const char *detail, int progress)
+{
+    Snapshot &snapshot = snapshots[subsystemIndex(subsystem)];
+    snapshot.state = state;
+    snapshot.progress = (progress >= 0 && progress <= 100) ? static_cast<uint8_t>(progress) : progressUnknown;
+    snapshot.updatedMs = millis();
+
+    snapshot.detail[0] = '\0';
+    if (detail && detail[0]) {
+        size_t out = 0;
+        for (size_t in = 0; detail[in] && out + 1 < sizeof(snapshot.detail); ++in) {
+            const char c = detail[in];
+            snapshot.detail[out++] = (c == '\n' || c == '\r') ? ' ' : c;
+        }
+        snapshot.detail[out] = '\0';
+    }
+}
+
+void setOta(State state, const char *detail, int progress)
+{
+    set(Subsystem::Ota, state, detail, progress);
+}
+
+void setSd(State state, const char *detail, int progress)
+{
+    set(Subsystem::Sd, state, detail, progress);
+}
+
+void setMap(State state, const char *detail, int progress)
+{
+    set(Subsystem::Map, state, detail, progress);
+}
+
+void setChat(State state, const char *detail, int progress)
+{
+    set(Subsystem::Chat, state, detail, progress);
+}
+
+Snapshot get(Subsystem subsystem)
+{
+    return snapshots[subsystemIndex(subsystem)];
+}
+
+const char *label(Subsystem subsystem)
+{
+    switch (subsystem) {
+    case Subsystem::Ota:
+        return "OTA";
+    case Subsystem::Sd:
+        return "SD";
+    case Subsystem::Map:
+        return "Map";
+    case Subsystem::Chat:
+        return "Chat";
+    case Subsystem::Count:
+        break;
+    }
+    return "Z-Deck";
+}
+
+const char *stateLabel(State state)
+{
+    switch (state) {
+    case State::Idle:
+        return "idle";
+    case State::Ready:
+        return "ready";
+    case State::Busy:
+        return "busy";
+    case State::Waiting:
+        return "waiting";
+    case State::Warning:
+        return "warning";
+    case State::Error:
+        return "error";
+    case State::Unknown:
+    default:
+        return "unknown";
+    }
+}
+
+const char *stateToken(State state)
+{
+    switch (state) {
+    case State::Idle:
+        return "IDLE";
+    case State::Ready:
+        return "READY";
+    case State::Busy:
+        return "BUSY";
+    case State::Waiting:
+        return "WAIT";
+    case State::Warning:
+        return "WARN";
+    case State::Error:
+        return "ERR";
+    case State::Unknown:
+    default:
+        return "UNK";
+    }
+}
+
+void formatLine(Subsystem subsystem, char *out, size_t outSize)
+{
+    if (!out || outSize == 0)
+        return;
+
+    const Snapshot snapshot = get(subsystem);
+    char age[12];
+    formatAge(snapshot.updatedMs, age, sizeof(age));
+
+    if (snapshot.progress <= 100 && snapshot.detail[0]) {
+        snprintf(out, outSize, "%s %s %u%% %s (%s)", label(subsystem), stateToken(snapshot.state),
+                 static_cast<unsigned int>(snapshot.progress), snapshot.detail, age);
+    } else if (snapshot.progress <= 100) {
+        snprintf(out, outSize, "%s %s %u%% (%s)", label(subsystem), stateToken(snapshot.state),
+                 static_cast<unsigned int>(snapshot.progress), age);
+    } else if (snapshot.detail[0]) {
+        snprintf(out, outSize, "%s %s %s (%s)", label(subsystem), stateToken(snapshot.state), snapshot.detail, age);
+    } else {
+        snprintf(out, outSize, "%s %s (%s)", label(subsystem), stateToken(snapshot.state), age);
+    }
+}
+
+void formatCompact(char *out, size_t outSize)
+{
+    if (!out || outSize == 0)
+        return;
+
+    out[0] = '\0';
+    for (size_t i = 0; i < static_cast<size_t>(Subsystem::Count); ++i) {
+        char line[120];
+        formatLine(static_cast<Subsystem>(i), line, sizeof(line));
+        appendLine(out, outSize, line);
+    }
+}
+
+void formatDiagnostics(char *out, size_t outSize)
+{
+    if (!out || outSize == 0)
+        return;
+
+    out[0] = '\0';
+    appendLine(out, outSize, "Z-Deck diagnostics");
+    for (size_t i = 0; i < static_cast<size_t>(Subsystem::Count); ++i) {
+        char line[120];
+        formatLine(static_cast<Subsystem>(i), line, sizeof(line));
+        appendLine(out, outSize, line);
+    }
+    appendLine(out, outSize, itsz::zdeck_debug::lastSummary());
+}
+
+} // namespace itsz::zdeck_state
diff --git a/src/itsz/ZDeckStateModel.h b/src/itsz/ZDeckStateModel.h
