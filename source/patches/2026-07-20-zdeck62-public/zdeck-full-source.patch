+#include "itsz/ZDeckGpsQualityPolicy.h"
+
+#include <cassert>
+#include <cstring>
+
+using itsz::zdeck_gps::Policy;
+using itsz::zdeck_gps::Quality;
+
+int main()
+{
+    assert(!Policy::assess(0, 3, 10, 80, 100).accepted);
+    assert(!Policy::assess(1, 2, 10, 80, 100).accepted);
+    assert(!Policy::assess(1, 3, 4, 80, 100).accepted);
+    assert(!Policy::assess(1, 3, 8, 251, 100).accepted);
+    assert(!Policy::assess(1, 3, 8, 100, 2001).accepted);
+
+    auto result = Policy::assess(1, 3, 5, 250, 100);
+    assert(result.accepted && result.quality == Quality::Usable);
+    result = Policy::assess(1, 3, 8, 140, 100);
+    assert(result.accepted && result.quality == Quality::Good);
+    result = Policy::assess(2, 3, 12, 70, 100);
+    assert(result.accepted && result.quality == Quality::Excellent);
+    assert(result.estimatedErrorMeters == 4);
+    assert(std::strcmp(Policy::label(result.quality), "EXCELLENT") == 0);
+    return 0;
+}
diff --git a/tests/itsz/test_zdeck_map_state.cpp b/tests/itsz/test_zdeck_map_state.cpp
new file mode 100644
index 000000000..83c7342bb
--- /dev/null
+++ b/tests/itsz/test_zdeck_map_state.cpp
@@ -0,0 +1,73 @@
+#include "itsz/ZDeckMapState.h"
+
+#include <cassert>
+
+using itsz::zdeck_map::CenterInputs;
+using itsz::zdeck_map::CenterSource;
+using itsz::zdeck_map::Controller;
+using itsz::zdeck_map::Page;
+using itsz::zdeck_map::Point;
+using itsz::zdeck_map::TileInputs;
+using itsz::zdeck_map::TileState;
+
+int main()
+{
+    Controller state;
+    state.cyclePage(-1);
+    assert(state.page() == Page::Alert);
+    state.cyclePage(1);
+    assert(state.page() == Page::Mesh);
+    state.setPage(6);
+    assert(state.page() == Page::Deflock);
+
+    CenterInputs input;
+    input.gpsExpected = true;
+    input.savedHome = Point{410000000, -810000000, 12};
+    auto decision = state.chooseCenter(input, true);
+    assert(decision.apply);
+    assert(decision.source == CenterSource::SavedHome);
+    assert(decision.awaitingLiveGps);
+
+    input.gps = Point{411000000, -811000000, 14};
+    decision = state.chooseCenter(input);
+    assert(decision.source == CenterSource::Gps);
+    assert(!decision.awaitingLiveGps);
+
+    state.noteManualInteraction();
+    decision = state.chooseCenter(input);
+    assert(!decision.apply);
+    decision = state.chooseCenter(input, true);
+    assert(decision.apply);
+    assert(decision.source == CenterSource::Gps);
+
+    TileInputs tiles;
+    assert(Controller::classifyTiles(tiles) == TileState::Closed);
+    tiles.mapOpen = true;
+    tiles.drawing = true;
+    assert(Controller::classifyTiles(tiles) == TileState::Drawing);
+    tiles.tileSlots = 9;
+    tiles.missingTiles = 9;
+    assert(Controller::classifyTiles(tiles) == TileState::Grid);
+    tiles.sdReady = true;
+    assert(Controller::classifyTiles(tiles) == TileState::Missing);
+    tiles.sdReady = false;
+    tiles.wifiConnected = true;
+    assert(Controller::classifyTiles(tiles) == TileState::Missing);
+    tiles.wifiConnected = false;
+    tiles.tileSlots = 0;
+    tiles.missingTiles = 0;
+    tiles.drawing = false;
+    tiles.missingTiles = 2;
+    assert(Controller::classifyTiles(tiles) == TileState::Missing);
+    tiles.missingTiles = 0;
+    tiles.tileSlots = 9;
+    assert(Controller::classifyTiles(tiles) == TileState::Ready);
+    tiles.tileSlots = 0;
+    tiles.wifiConnected = true;
+    assert(Controller::classifyTiles(tiles) == TileState::Online);
+    tiles.wifiConnected = false;
+    tiles.sdReady = true;
+    assert(Controller::classifyTiles(tiles) == TileState::Offline);
+    tiles.sdReady = false;
+    assert(Controller::classifyTiles(tiles) == TileState::Grid);
+}
