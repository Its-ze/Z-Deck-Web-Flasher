+    sdSetupIgnoreButton = lv_btn_create(sdSetupPanel);
+    lv_obj_set_size(sdSetupIgnoreButton, buttonWidth, 34);
+    lv_obj_align(sdSetupIgnoreButton, LV_ALIGN_BOTTOM_LEFT, 0, 0);
+    add_style_settings_button_style(sdSetupIgnoreButton);
+    lv_obj_add_event_cb(sdSetupIgnoreButton, ui_event_sd_setup_ignore, LV_EVENT_CLICKED, NULL);
+
+    lv_obj_t *ignoreLabel = lv_label_create(sdSetupIgnoreButton);
