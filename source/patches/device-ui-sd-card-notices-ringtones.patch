+bool SDCard::prepareStorage(void)
+{
+    bool ok = true;
+    for (size_t i = 0; i < storageFolderCount(); i++) {
+        const char *folder = storageFolders[i];
+        File dir = SDFs.open(folder);
+        bool exists = dir && dir.isDirectory();
+        if (dir)
+            dir.close();
+        if (!exists && !SDFs.mkdir(folder)) {
+            ILOG_WARN("SD: failed to create %s", folder);
+            ok = false;
+        }
+    }
+    return ok;
+}
+
+bool SDCard::isStoragePrepared(void)
+{
+    for (size_t i = 0; i < storageFolderCount(); i++) {
+        File dir = SDFs.open(storageFolders[i]);
+        bool exists = dir && dir.isDirectory();
+        if (dir)
+            dir.close();
+        if (!exists)
+            return false;
+    }
+    return true;
+}
+
+std::vector<ISdCard::RingtoneFile> SDCard::loadRingtones(const char *folder)
+{
+    std::vector<RingtoneFile> ringtones;
+    File dir = SDFs.open(folder);
+    if (!dir)
+        return ringtones;
+
+    do {
+        File entry = dir.openNextFile();
+        if (!entry)
+            break;
+
+        std::string path = entry.name();
+        if (!entry.isDirectory() && isRingtoneFile(path)) {
+            std::string rtttl = readRtttlLine(entry);
+            if (!rtttl.empty()) {
+                ILOG_DEBUG("SD: found ringtone: %s", path.c_str());
+                ringtones.push_back({displayNameForRingtone(path, rtttl), rtttl});
+            }
+        }
+        entry.close();
+    } while (true);
+
+    dir.close();
+    return ringtones;
+}
