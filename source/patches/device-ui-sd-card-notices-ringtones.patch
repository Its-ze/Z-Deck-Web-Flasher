+    lv_label_set_text(body, _("This SD card is not set up yet. Format erases it."));
+    lv_obj_set_style_text_align(body, LV_TEXT_ALIGN_CENTER, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_align(body, LV_ALIGN_TOP_MID, 0, 28);
