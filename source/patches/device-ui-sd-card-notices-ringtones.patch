+    lv_obj_set_style_bg_img_recolor(button, colorGray, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_bg_img_recolor_opa(button, Themes::get() == Themes::eDark ? 0 : 255,
+                                        LV_PART_MAIN | LV_STATE_DEFAULT);
+}
