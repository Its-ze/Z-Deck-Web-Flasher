+void TFTView_320x240::refreshSdRingtones(void)
+{
+    sdRingtoneNames.clear();
+    sdRingtoneValues.clear();
+
+    if (!sdCard || sdCard->cardType() == ISdCard::eNone)
+        return;
+
+    const char *folders[] = {"/ringtones", "/meshtastic/ringtones"};
+    for (const char *folder : folders) {
+        std::vector<ISdCard::RingtoneFile> files = sdCard->loadRingtones(folder);
+        for (const ISdCard::RingtoneFile &file : files) {
+            if (std::find(sdRingtoneValues.begin(), sdRingtoneValues.end(), file.rtttl) != sdRingtoneValues.end())
+                continue;
+
+            sdRingtoneNames.push_back(file.name);
+            sdRingtoneValues.push_back(file.rtttl);
+        }
+    }
+}
+
+void TFTView_320x240::populateRingtoneDropdown(void)
+{
+    refreshSdRingtones();
+
+    std::string options = ringtone[1].name;
+    for (int i = 2; i < numRingtones; i++) {
+        options += '\n';
+        options += ringtone[i].name;
+    }
+    for (const std::string &name : sdRingtoneNames) {
+        options += "\nSD: ";
+        options += name;
+    }
+
+    lv_dropdown_set_options(objects.settings_ringtone_dropdown, options.c_str());
+
+    uint32_t selected = db.uiConfig.ring_tone_id > 0 ? db.uiConfig.ring_tone_id - 1 : 0;
+    if (selectedSdRingtone >= 0 && selectedSdRingtone < (int16_t)sdRingtoneNames.size()) {
+        selected = (numRingtones - 1) + selectedSdRingtone;
+    }
+    lv_dropdown_set_selected(objects.settings_ringtone_dropdown, selected);
+}
