+static const char *storageFolders[] = {"/maps", "/ringtones", "/messages", "/backups", "/logs"};
+
+static size_t storageFolderCount(void)
+{
+    return sizeof(storageFolders) / sizeof(storageFolders[0]);
+}
+
+static bool isRingtoneFile(const std::string &name)
+{
+    std::string lower = name;
+    std::transform(lower.begin(), lower.end(), lower.begin(), [](unsigned char c) { return std::tolower(c); });
+    auto endsWith = [&lower](const char *suffix) {
+        size_t suffixLen = strlen(suffix);
+        return lower.size() >= suffixLen && lower.compare(lower.size() - suffixLen, suffixLen, suffix) == 0;
+    };
+    return endsWith(".rtttl") || endsWith(".txt") || endsWith(".ring");
+}
+
+static std::string displayNameForRingtone(const std::string &path, const std::string &rtttl)
+{
+    std::string name;
+    size_t sep = rtttl.find(':');
+    if (sep != std::string::npos && sep > 0) {
+        name = rtttl.substr(0, sep);
+    } else {
+        size_t slash = path.find_last_of('/');
+        name = slash == std::string::npos ? path : path.substr(slash + 1);
+        size_t dot = name.find_last_of('.');
+        if (dot != std::string::npos)
+            name.resize(dot);
+    }
+
+    if (name.size() > 28)
+        name.resize(28);
+    return name.empty() ? "SD ringtone" : name;
+}
+
+static bool validRtttl(const std::string &rtttl)
+{
+    size_t first = rtttl.find(':');
+    if (first == std::string::npos)
+        return false;
+    return rtttl.find(':', first + 1) != std::string::npos && rtttl.size() < 231;
+}
+
+static std::string readRtttlLine(File &file)
+{
+    while (file.available()) {
+        String line = file.readStringUntil('\n');
+        line.trim();
+        if (line.length() == 0 || line[0] == '#')
+            continue;
+
+        std::string rtttl = line.c_str();
+        return validRtttl(rtttl) ? rtttl : std::string{};
+    }
+    return {};
+}
