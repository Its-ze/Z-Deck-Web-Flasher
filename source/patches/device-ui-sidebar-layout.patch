+void TFTView_320x240::loadZDeckSidebarPreference(void)
+{
+    zDeckSidebarRight = zDeckLoadSidebarRightPreference(true);
+}
+
+void TFTView_320x240::setupZDeckSidebarControl(void)
+{
+    if (zDeckSidebarButton || !objects.tab_page_basic_settings)
+        return;
+
+    zDeckSidebarButton = lv_btn_create(objects.tab_page_basic_settings);
+    lv_obj_set_size(zDeckSidebarButton, LV_PCT(95), 30);
+    add_style_settings_button_style(zDeckSidebarButton);
+    lv_obj_set_style_align(zDeckSidebarButton, LV_ALIGN_TOP_MID, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_shadow_width(zDeckSidebarButton, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_bg_color(zDeckSidebarButton, lv_color_hex(0xff4db270), LV_PART_MAIN | LV_STATE_PRESSED);
+    lv_obj_set_style_text_color(zDeckSidebarButton, lv_color_hex(0xff015114), LV_PART_MAIN | LV_STATE_PRESSED);
+    lv_obj_add_event_cb(zDeckSidebarButton, ui_event_zdeckSidebarButton, LV_EVENT_CLICKED, NULL);
+
+    zDeckSidebarButtonLabel = lv_label_create(zDeckSidebarButton);
+    lv_obj_set_size(zDeckSidebarButtonLabel, LV_PCT(100), LV_SIZE_CONTENT);
+    lv_label_set_long_mode(zDeckSidebarButtonLabel, LV_LABEL_LONG_DOT);
+    lv_obj_set_style_align(zDeckSidebarButtonLabel, LV_ALIGN_CENTER, LV_PART_MAIN | LV_STATE_DEFAULT);
+    updateZDeckSidebarLabel();
+}
+
+void TFTView_320x240::updateZDeckSidebarLabel(void)
+{
+    if (zDeckSidebarButtonLabel)
+        lv_label_set_text(zDeckSidebarButtonLabel, zDeckSidebarRight ? _("Sidebar: right") : _("Sidebar: left"));
+}
+
+void TFTView_320x240::applyZDeckSidebarPlacement(void)
+{
+    if (objects.button_panel) {
+        lv_obj_set_x(objects.button_panel, zDeckSidebarRight ? LV_PCT(88) : 0);
+        lv_obj_set_width(objects.button_panel, LV_PCT(12));
+        lv_obj_move_foreground(objects.button_panel);
+    }
+
+    lv_obj_t *contentPanels[] = {
+        objects.home_panel,       objects.nodes_panel,          objects.node_options_panel,  objects.groups_panel,
+        objects.messages_panel,   objects.chats_panel,          objects.map_panel,           objects.controller_panel,
+        ui_AdvancedSettingsPanel, objects.mesh_detector_panel,  objects.signal_scanner_panel, objects.trace_route_panel,
+        objects.details_panel,    objects.tools_statistics_panel, objects.tools_packet_log_panel,
+    };
+    for (lv_obj_t *panel : contentPanels)
+        zDeckPlaceMainContent(panel, zDeckSidebarRight);
+
+    lv_obj_t *topPanels[] = {
+        objects.top_panel,          objects.top_nodes_panel,        objects.top_node_options_panel, objects.top_groups_panel,
+        objects.top_group_chat_panel, objects.top_chats_panel,      objects.top_messages_panel,     objects.top_map_panel,
+        objects.top_settings_panel, objects.top_advanced_settings_panel, objects.top_mesh_detector_panel,
+        objects.top_signal_scanner_panel, objects.top_trace_route_panel, objects.top_statistics_panel, objects.top_packet_log_panel,
+    };
+    for (lv_obj_t *panel : topPanels)
+        zDeckPlaceMainContent(panel, zDeckSidebarRight);
+
+    updateZDeckSidebarLabel();
+    lv_obj_invalidate(objects.main_screen);
+}
+
+void TFTView_320x240::setZDeckSidebarRight(bool enabled, bool persist)
+{
+    zDeckSidebarRight = enabled;
+    if (persist)
+        zDeckSaveSidebarRightPreference(enabled);
+    applyZDeckSidebarPlacement();
+}
+
+void TFTView_320x240::ui_event_zdeckSidebarButton(lv_event_t *e)
+{
+    if (lv_event_get_code(e) != LV_EVENT_CLICKED || THIS->activeSettings != eNone)
+        return;
+    THIS->setZDeckSidebarRight(!THIS->zDeckSidebarRight);
+}
