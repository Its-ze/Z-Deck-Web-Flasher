+void TFTView_320x240::updateZDeckLauncherStatus(void)
+{
+    if (!zDeckLauncherStatusLabel || !zDeckLauncherPageLabel || !zDeckLauncherClockLabel || !zDeckLauncherDateLabel)
+        return;
+    time_t currentTime;
+#ifdef ARCH_PORTDUINO
+    time(&currentTime);
+#else
+    currentTime = actTime;
+#endif
+    char clockText[12] = "--:--";
+    char dateText[24] = "WAITING FOR TIME";
+    if (VALID_TIME(currentTime)) {
+        tm *currentTm = localtime(&currentTime);
+        if (currentTm) {
+            strftime(clockText, sizeof(clockText), db.config.display.use_12h_clock ? "%I:%M" : "%H:%M", currentTm);
+            if (db.config.display.use_12h_clock && clockText[0] == '0')
+                memmove(clockText, clockText + 1, strlen(clockText));
+            strftime(dateText, sizeof(dateText), "%a, %b %d", currentTm);
+        }
+    }
+    lv_label_set_text(zDeckLauncherClockLabel, clockText);
+    lv_label_set_text(zDeckLauncherDateLabel, dateText);
+
+    const char *gps = hasPosition ? "GPS FIX" : gpsSatellites ? "GPS ACQ" : "GPS WAIT";
+    const uint16_t nearbyNodes = nodesOnline > 0 ? nodesOnline - 1 : 0;
+    char status[48];
+    if (zDeckBatteryKnown) {
+        lv_snprintf(status, sizeof(status), "M%u %s BAT %u%%", static_cast<unsigned int>(nearbyNodes), gps,
+                    static_cast<unsigned int>(zDeckBatteryPercent));
+    } else {
+        lv_snprintf(status, sizeof(status), "M%u %s BAT --", static_cast<unsigned int>(nearbyNodes), gps);
+    }
+    lv_label_set_text(zDeckLauncherStatusLabel, status);
+
+    char pageStatus[72];
+    if (unreadMessages > 0) {
+        lv_snprintf(pageStatus, sizeof(pageStatus), "%u / 3   SD %s   %u NEW", (unsigned int)zDeckLauncherPage + 1,
+                    cardDetected ? "READY" : "OFF", (unsigned int)unreadMessages);
+    } else {
+        lv_snprintf(pageStatus, sizeof(pageStatus), "%u / 3   SD %s   %s", (unsigned int)zDeckLauncherPage + 1,
+                    cardDetected ? "READY" : "OFF", RtcName(getRTCQuality()));
+    }
+    lv_label_set_text(zDeckLauncherPageLabel, pageStatus);
+    updateZDeckDashboard();
+    updateZDeckMeshHub();
+}
+
+void TFTView_320x240::updateZDeckDashboard(void)
+{
+    if (!zDeckDashboardNetworkLabel || !zDeckDashboardTelemetryLabel)
+        return;
+    const bool meshCoreReady = itsz::zdeck_dual_boot::meshCoreAvailable();
+    const uint16_t nearbyNodes = nodesOnline > 0 ? nodesOnline - 1 : 0;
+    time_t now = 0;
+    time(&now);
+    uint32_t secondsSinceRx = UINT32_MAX;
+    if (lastHeard > 0 && now >= lastHeard)
+        secondsSinceRx = static_cast<uint32_t>(now - lastHeard);
+    char rx[20];
+    if (secondsSinceRx == UINT32_MAX)
+        lv_snprintf(rx, sizeof(rx), "no RX yet");
+    else if (secondsSinceRx < 60)
+        lv_snprintf(rx, sizeof(rx), "RX %lus ago", static_cast<unsigned long>(secondsSinceRx));
+    else
+        lv_snprintf(rx, sizeof(rx), "RX %lum ago", static_cast<unsigned long>(secondsSinceRx / 60));
+    char network[160];
+    lv_snprintf(network, sizeof(network), "ACTIVE  Z-MESH\n%u nearby | %s | MeshCore %s",
+                static_cast<unsigned int>(nearbyNodes), rx, meshCoreReady ? "READY" : "USB INSTALL NEEDED");
+    lv_label_set_text(zDeckDashboardNetworkLabel, network);
+    const char *gps = hasPosition ? "FIX" : gpsSatellites ? "ACQUIRING" : "SEARCHING";
+    char battery[12];
+    if (zDeckBatteryKnown)
+        lv_snprintf(battery, sizeof(battery), "%u%%", static_cast<unsigned int>(zDeckBatteryPercent));
+    else
+        lv_snprintf(battery, sizeof(battery), "--");
+    char telemetry[128];
+    lv_snprintf(telemetry, sizeof(telemetry), "GPS %s (%u sats) | BAT %s\nSD %s | %u unread | %s", gps,
+                static_cast<unsigned int>(gpsSatellites), battery,
+                cardDetected ? "ready" : "off", static_cast<unsigned int>(unreadMessages),
+                meshCoreReady ? "dual mesh ready" : "flash dual system over USB");
+    lv_label_set_text(zDeckDashboardTelemetryLabel, telemetry);
+}
+
+void TFTView_320x240::updateZDeckBluetooth(void)
+{
+    if (!zDeckBluetoothStatusLabel)
+        return;
+    const bool enabled = db.config.bluetooth.enabled;
+    const bool connected = db.connectionStatus.bluetooth.is_connected;
+    const bool randomPin = db.config.bluetooth.mode == meshtastic_Config_BluetoothConfig_PairingMode_RANDOM_PIN;
+    char status[160];
+    lv_snprintf(status, sizeof(status), "Radio: %s\nConnection: %s\nPairing: %s\nDevice: Meshtastic_%04x", enabled ? "ON" : "OFF",
+                connected ? "CONNECTED" : enabled ? "READY" : "DISABLED", randomPin ? "RANDOM PIN" : "FIXED PIN",
+                (unsigned int)(ownNode & 0xffff));
+    lv_label_set_text(zDeckBluetoothStatusLabel, status);
+    lv_obj_set_style_text_color(zDeckBluetoothStatusLabel, connected ? lv_color_hex(0x7FE0C3) : lv_color_hex(0xE7F2EF),
+                                LV_PART_MAIN | LV_STATE_DEFAULT);
+    if (zDeckBluetoothToggleButtonLabel)
+        lv_label_set_text(zDeckBluetoothToggleButtonLabel, enabled ? "TURN OFF" : "TURN ON");
+}
+
+void TFTView_320x240::updateZDeckMeshHub(void)
+{
+    if (!zDeckMeshHubStatusLabel)
+        return;
+    const bool available = itsz::zdeck_dual_boot::meshCoreAvailable();
+    const uint16_t nearbyNodes = nodesOnline > 0 ? nodesOnline - 1 : 0;
+    time_t now = 0;
+    time(&now);
+    uint32_t secondsSinceRx = UINT32_MAX;
+    if (lastHeard > 0 && now >= lastHeard)
+        secondsSinceRx = static_cast<uint32_t>(now - lastHeard);
+    const uint32_t observationSeconds = (millis() - zDeckMeshObservationStartedMs) / 1000U;
+    const auto assessment = itsz::zdeck_mesh_mode::Policy::assess(available, nearbyNodes, secondsSinceRx, observationSeconds);
+    char rx[20];
+    if (secondsSinceRx == UINT32_MAX)
+        lv_snprintf(rx, sizeof(rx), "no RX yet");
+    else if (secondsSinceRx < 60)
+        lv_snprintf(rx, sizeof(rx), "RX %lus ago", static_cast<unsigned long>(secondsSinceRx));
+    else
+        lv_snprintf(rx, sizeof(rx), "RX %lum ago", static_cast<unsigned long>(secondsSinceRx / 60));
+    char status[220];
+    lv_snprintf(status, sizeof(status), "STAYS: Z-MESH | MeshCore: %s\n%u nearby | %s\nADVICE ONLY %s %u%%: %s",
+                available ? "READY" : "NOT INSTALLED", static_cast<unsigned int>(nearbyNodes), rx,
+                itsz::zdeck_mesh_mode::Policy::label(assessment.recommendation), assessment.confidence, assessment.reason);
+    lv_label_set_text(zDeckMeshHubStatusLabel, status);
+    if (zDeckMeshHubSwitchButtonLabel) {
+        if (!available)
+            lv_label_set_text(zDeckMeshHubSwitchButtonLabel, "USB INSTALL");
+        else if (zDeckMeshSwitchArmed && millis() - zDeckMeshSwitchArmedAtMs <= 10000U)
+            lv_label_set_text(zDeckMeshHubSwitchButtonLabel, "PRESS AGAIN");
+        else
+            lv_label_set_text(zDeckMeshHubSwitchButtonLabel, "MESHCORE >");
+    }
+}
