+void TFTView_320x240::updateZDeckAlwaysOnDisplay(void)
+{
+    if (!zDeckAlwaysOnTimeLabel || !zDeckAlwaysOnStatusLabel)
+        return;
+    time_t now = getTime(true);
+    tm *local = localtime(&now);
+    char clock[48];
+    if (VALID_TIME(now) && local) {
+        strftime(clock, sizeof(clock), db.config.display.use_12h_clock ? "%I:%M %p\n%a %b %d" : "%H:%M\n%a %b %d", local);
+    } else {
+        lv_snprintf(clock, sizeof(clock), "--:--\nTIME SEARCH");
+    }
+    lv_label_set_text(zDeckAlwaysOnTimeLabel, clock);
+
+    char status[96];
+    char battery[12];
+    if (zDeckBatteryKnown)
+        lv_snprintf(battery, sizeof(battery), "%u%%", static_cast<unsigned int>(zDeckBatteryPercent));
+    else
+        lv_snprintf(battery, sizeof(battery), "--");
+    lv_snprintf(status, sizeof(status), "TIME %s | GPS %s\nBAT %s | %u unread", RtcName(getRTCQuality()),
+                hasPosition ? "fix" : gpsSatellites ? "acquiring" : "searching", battery,
+                (unsigned int)unreadMessages);
+    lv_label_set_text(zDeckAlwaysOnStatusLabel, status);
+}
