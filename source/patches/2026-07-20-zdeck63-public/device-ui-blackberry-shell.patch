+void TFTView_320x240::showZDeckLauncher(bool show)
+{
+    if (!zDeckLauncherPanel)
+        return;
+    if (show) {
+        showZDeckDashboard(false);
+        showZDeckBluetooth(false);
+        showZDeckMeshHub(false);
+        lv_obj_clear_flag(zDeckLauncherPanel, LV_OBJ_FLAG_HIDDEN);
+        lv_obj_move_foreground(zDeckLauncherPanel);
+        setZDeckLauncherPage(zDeckLauncherPage, false);
+        updateZDeckLauncherStatus();
+        lv_group_focus_obj(zDeckLauncherButtons[zDeckLauncherPage * 8]);
+    } else {
+        lv_obj_add_flag(zDeckLauncherPanel, LV_OBJ_FLAG_HIDDEN);
+    }
+}
+
+void TFTView_320x240::setZDeckLauncherPage(uint8_t page, bool focusFirst)
+{
+    if (!zDeckLauncherPanel)
+        return;
+    zDeckLauncherPage = std::min<uint8_t>(page, 2);
+    const uint8_t first = zDeckLauncherPage * 8;
+    const uint8_t last = std::min<uint8_t>(first + 8, zDeckLauncherButtons.size());
+    for (uint8_t i = 0; i < zDeckLauncherButtons.size(); ++i) {
+        if (i >= first && i < last) {
+            const uint8_t slot = i - first;
+            lv_obj_set_pos(zDeckLauncherButtons[i], 4 + (slot % 4) * 68, 28 + (slot / 4) * 56);
+            lv_obj_clear_flag(zDeckLauncherButtons[i], LV_OBJ_FLAG_HIDDEN);
+        } else {
+            lv_obj_add_flag(zDeckLauncherButtons[i], LV_OBJ_FLAG_HIDDEN);
+        }
+    }
+    if (zDeckLauncherPreviousButton) {
+        if (zDeckLauncherPage == 0)
+            lv_obj_add_state(zDeckLauncherPreviousButton, LV_STATE_DISABLED);
+        else
+            lv_obj_clear_state(zDeckLauncherPreviousButton, LV_STATE_DISABLED);
+    }
+    if (zDeckLauncherNextButton) {
+        if (zDeckLauncherPage == 2)
+            lv_obj_add_state(zDeckLauncherNextButton, LV_STATE_DISABLED);
+        else
+            lv_obj_clear_state(zDeckLauncherNextButton, LV_STATE_DISABLED);
+    }
+    updateZDeckLauncherStatus();
+    if (focusFirst)
+        lv_group_focus_obj(zDeckLauncherButtons[first]);
+}
