+void TFTView_320x240::ui_event_zdeckLauncherButton(lv_event_t *e)
+{
+    if (lv_event_get_code(e) != LV_EVENT_CLICKED || THIS->activeSettings != eNone)
+        return;
+    const uint8_t app = static_cast<uint8_t>(reinterpret_cast<uintptr_t>(lv_event_get_user_data(e)));
+    if (app == 255) {
+        THIS->setZDeckLauncherPage(0, false);
+        THIS->showZDeckLauncher(true);
+        return;
+    }
+
+    THIS->showZDeckLauncher(false);
+    THIS->showZDeckDashboard(false);
+    THIS->showZDeckBluetooth(false);
+    THIS->showZDeckMeshHub(false);
+    switch (app) {
+    case 0:
+        THIS->showZDeckDashboard(true);
+        break;
+    case 1:
+        lv_obj_send_event(objects.messages_button, LV_EVENT_CLICKED, nullptr);
+        break;
+    case 2:
+        lv_obj_send_event(objects.nodes_button, LV_EVENT_CLICKED, nullptr);
+        break;
+    case 3:
+        lv_obj_send_event(objects.groups_button, LV_EVENT_CLICKED, nullptr);
+        break;
+    case 4:
+        lv_obj_send_event(objects.map_button, LV_EVENT_CLICKED, nullptr);
+        THIS->setZDeckMapPage(0, false);
+        break;
+    case 5:
+        lv_obj_send_event(objects.map_button, LV_EVENT_CLICKED, nullptr);
+        THIS->setZDeckMapPage(1, false);
+        break;
+    case 6:
+        lv_obj_send_event(objects.map_button, LV_EVENT_CLICKED, nullptr);
+        THIS->setZDeckMapPage(2, false);
+        break;
+    case 7:
+        lv_obj_send_event(objects.map_button, LV_EVENT_CLICKED, nullptr);
+        THIS->setZDeckMapPage(3, false);
+        break;
+    case 8:
+        lv_obj_send_event(objects.tools_mesh_detector_button, LV_EVENT_CLICKED, nullptr);
+        break;
+    case 9:
+        lv_obj_send_event(objects.tools_signal_scanner_button, LV_EVENT_CLICKED, nullptr);
+        break;
+    case 10:
+        lv_obj_send_event(objects.tools_trace_route_button, LV_EVENT_CLICKED, nullptr);
+        break;
+    case 11:
+        lv_obj_send_event(objects.tools_neighbors_button, LV_EVENT_CLICKED, nullptr);
+        break;
+    case 12:
+        lv_obj_send_event(objects.tools_statistics_button, LV_EVENT_CLICKED, nullptr);
+        break;
+    case 13:
+        lv_obj_send_event(objects.tools_packet_log_button, LV_EVENT_CLICKED, nullptr);
+        break;
+    case 14:
+        THIS->showZDeckMeshHub(true);
+        break;
+    case 15:
+        lv_obj_send_event(objects.settings_button, LV_EVENT_CLICKED, nullptr);
+        lv_tabview_set_active(objects.controller_tab_view, 0, LV_ANIM_OFF);
+        lv_obj_send_event(objects.basic_settings_user_button, LV_EVENT_CLICKED, nullptr);
+        break;
+    case 16:
+        lv_obj_send_event(objects.settings_button, LV_EVENT_CLICKED, nullptr);
+        lv_tabview_set_active(objects.controller_tab_view, 0, LV_ANIM_OFF);
+        lv_obj_send_event(objects.basic_settings_modem_preset_button, LV_EVENT_CLICKED, nullptr);
+        break;
+    case 17:
+        lv_obj_send_event(objects.settings_button, LV_EVENT_CLICKED, nullptr);
+        lv_tabview_set_active(objects.controller_tab_view, 0, LV_ANIM_OFF);
+        lv_obj_send_event(objects.basic_settings_wifi_button, LV_EVENT_CLICKED, nullptr);
+        break;
+    case 18:
+        lv_obj_send_event(objects.settings_button, LV_EVENT_CLICKED, nullptr);
+        lv_tabview_set_active(objects.controller_tab_view, 0, LV_ANIM_OFF);
+        if (THIS->zDeckAlwaysOnButton)
+            lv_obj_scroll_to_view(THIS->zDeckAlwaysOnButton, LV_ANIM_OFF);
+        break;
+    case 19:
+        lv_obj_send_event(objects.settings_button, LV_EVENT_CLICKED, nullptr);
+        lv_tabview_set_active(objects.controller_tab_view, 0, LV_ANIM_OFF);
+        lv_obj_send_event(objects.basic_settings_input_button, LV_EVENT_CLICKED, nullptr);
+        break;
+    case 20:
