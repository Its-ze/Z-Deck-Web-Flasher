diff --git a/src/itsz/ZDeckUpdatePolicy.cpp b/src/itsz/ZDeckUpdatePolicy.cpp
new file mode 100644
index 0000000..bf48cec
--- /dev/null
+++ b/src/itsz/ZDeckUpdatePolicy.cpp
@@ -0,0 +1,80 @@
+#include "itsz/ZDeckUpdatePolicy.h"
+
+#include <cctype>
+#include <cstring>
+
+namespace itsz::zdeck_update
+{
+
+static int nextVersionNumber(const char *version, size_t &offset)
+{
+    if (!version)
+        return -1;
+
+    while (version[offset] && !std::isdigit(static_cast<unsigned char>(version[offset])))
+        offset++;
+
+    if (!version[offset])
+        return -1;
+
+    int value = 0;
+    while (version[offset] && std::isdigit(static_cast<unsigned char>(version[offset]))) {
+        value = (value * 10) + (version[offset] - '0');
+        offset++;
+    }
+    return value;
+}
+
+bool isVersionNewer(const char *available, const char *current)
+{
+    size_t availableOffset = 0;
+    size_t currentOffset = 0;
+
+    while (true) {
+        int a = nextVersionNumber(available, availableOffset);
+        int c = nextVersionNumber(current, currentOffset);
+        if (a < 0 && c < 0)
+            return false;
+        if (a < 0)
+            a = 0;
+        if (c < 0)
+            c = 0;
+        if (a != c)
+            return a > c;
+    }
+}
+
+static int hexValue(char value)
+{
+    if (value >= '0' && value <= '9')
+        return value - '0';
+    value = static_cast<char>(std::tolower(static_cast<unsigned char>(value)));
+    if (value >= 'a' && value <= 'f')
+        return value - 'a' + 10;
+    return -1;
+}
+
+bool decodeSha256(const char *hex, uint8_t output[32])
+{
+    if (!hex || !output || std::strlen(hex) != 64)
+        return false;
+
+    for (size_t i = 0; i < 32; i++) {
+        const int high = hexValue(hex[i * 2]);
+        const int low = hexValue(hex[i * 2 + 1]);
+        if (high < 0 || low < 0)
+            return false;
+        output[i] = static_cast<uint8_t>((high << 4) | low);
+    }
+    return true;
+}
+
+bool hashesEqual(const uint8_t lhs[32], const uint8_t rhs[32])
+{
+    uint8_t difference = 0;
+    for (size_t i = 0; i < 32; i++)
+        difference |= lhs[i] ^ rhs[i];
+    return difference == 0;
+}
+
+} // namespace itsz::zdeck_update
