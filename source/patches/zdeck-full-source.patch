+    }
+
+    concurrency::LockGuard guard(spiLock);
+    if (!SD.exists(sdBackupFileName)) {
+        LOG_WARN("SD preference backup missing: %s", sdBackupFileName);
+        itsz::zdeck_debug::breadcrumb("sd-restore", "load.missing");
+        return false;
+    }
+
+    File file = SD.open(sdBackupFileName, FILE_O_READ);
+    if (!file) {
+        LOG_ERROR("SD preference backup open failed: %s", sdBackupFileName);
+        itsz::zdeck_debug::breadcrumb("sd-restore", "load.open.fail");
+        return false;
+    }
+
+    const size_t backupSize = file.size();
+    char detail[80];
+    snprintf(detail, sizeof(detail), "size=%u", static_cast<unsigned>(backupSize));
+    itsz::zdeck_debug::breadcrumb("sd-restore", "load.open.ok", detail);
+    if (backupSize == 0 || backupSize > meshtastic_BackupPreferences_size) {
+        LOG_ERROR("SD preference backup has invalid size: %u", static_cast<unsigned>(backupSize));
+        file.close();
+        itsz::zdeck_debug::breadcrumb("sd-restore", "load.size.invalid", detail);
+        return false;
+    }
+
+    pb_istream_t stream = {&readcb, &file, backupSize};
+    meshtastic_BackupPreferences empty = meshtastic_BackupPreferences_init_zero;
+    backup = empty;
+    bool ok = pb_decode(&stream, &meshtastic_BackupPreferences_msg, &backup);
+    file.close();
+
+    if (!ok) {
+        LOG_ERROR("SD preference backup decode failed: %s", PB_GET_ERROR(&stream));
+        itsz::zdeck_debug::breadcrumb("sd-restore", "decode.fail", PB_GET_ERROR(&stream));
+        return false;
+    }
+
+    itsz::zdeck_debug::breadcrumb("sd-restore", "decode.ok", detail);
+    return true;
+}
+
+bool verifySdPreferencesBackup()
+{
+    itsz::zdeck_debug::breadcrumb("sd-backup", "verify.begin");
+    meshtastic_BackupPreferences scratch = meshtastic_BackupPreferences_init_zero;
+    const bool ok = loadSdPreferencesBackup(scratch);
+    itsz::zdeck_debug::breadcrumb("sd-backup", ok ? "verify.ok" : "verify.fail");
+    return ok;
+}
+
+bool saveSdPreferencesBackup(const meshtastic_BackupPreferences &backup, size_t backupSize)
+{
+    char detail[80];
+    snprintf(detail, sizeof(detail), "size=%u", static_cast<unsigned>(backupSize));
+    itsz::zdeck_debug::breadcrumb("sd-backup", "save.begin", detail);
+    if (!ensureSdBackupStorage()) {
+        itsz::zdeck_debug::breadcrumb("sd-backup", "save.ensure.fail");
+        return false;
+    }
+
+    {
+        concurrency::LockGuard guard(spiLock);
+        SD.remove(sdBackupTmpFileName);
+    }
+
+    File file;
+    {
+        concurrency::LockGuard guard(spiLock);
+        file = SD.open(sdBackupTmpFileName, FILE_O_WRITE);
+    }
+    if (!file) {
+        LOG_ERROR("SD preference backup temp open failed: %s", sdBackupTmpFileName);
+        itsz::zdeck_debug::breadcrumb("sd-backup", "temp.open.fail");
+        return false;
+    }
+
+    itsz::zdeck_debug::breadcrumb("sd-backup", "encode.begin", detail);
+    pb_ostream_t stream = {&writecb, static_cast<Print *>(&file), backupSize};
+    bool ok = pb_encode(&stream, &meshtastic_BackupPreferences_msg, &backup);
+    {
+        concurrency::LockGuard guard(spiLock);
+        file.flush();
+        file.close();
+    }
+
+    if (!ok) {
+        LOG_ERROR("SD preference backup encode failed: %s", PB_GET_ERROR(&stream));
+        concurrency::LockGuard guard(spiLock);
+        SD.remove(sdBackupTmpFileName);
+        itsz::zdeck_debug::breadcrumb("sd-backup", "encode.fail", PB_GET_ERROR(&stream));
+        return false;
+    }
+
+    itsz::zdeck_debug::breadcrumb("sd-backup", "encode.ok", detail);
+    {
+        concurrency::LockGuard guard(spiLock);
+        SD.remove(sdBackupPreviousFileName);
+        if (SD.exists(sdBackupFileName) && !SD.rename(sdBackupFileName, sdBackupPreviousFileName)) {
+            LOG_ERROR("SD preference backup previous rename failed");
+            SD.remove(sdBackupTmpFileName);
+            itsz::zdeck_debug::breadcrumb("sd-backup", "rename.previous.fail");
+            return false;
+        }
+        if (!SD.rename(sdBackupTmpFileName, sdBackupFileName)) {
+            LOG_ERROR("SD preference backup rename failed");
+            if (SD.exists(sdBackupPreviousFileName))
+                SD.rename(sdBackupPreviousFileName, sdBackupFileName);
+            SD.remove(sdBackupTmpFileName);
+            itsz::zdeck_debug::breadcrumb("sd-backup", "rename.final.fail");
+            return false;
+        }
+        SD.remove(sdBackupPreviousFileName);
+    }
+
+    itsz::zdeck_debug::breadcrumb("sd-backup", "rename.ok", detail);
+    return verifySdPreferencesBackup();
+}
+
+bool removeSdPreferencesBackup()
+{
+    itsz::zdeck_debug::breadcrumb("sd-backup", "remove.begin");
+    if (!ensureSdBackupStorage()) {
+        itsz::zdeck_debug::breadcrumb("sd-backup", "remove.ensure.fail");
+        return false;
+    }
+
+    concurrency::LockGuard guard(spiLock);
+    bool removed = true;
+    if (SD.exists(sdBackupFileName))
+        removed &= SD.remove(sdBackupFileName);
+    if (SD.exists(sdBackupTmpFileName))
+        removed &= SD.remove(sdBackupTmpFileName);
+    if (SD.exists(sdBackupPreviousFileName))
+        removed &= SD.remove(sdBackupPreviousFileName);
+    itsz::zdeck_debug::breadcrumb("sd-backup", removed ? "remove.ok" : "remove.fail");
+    return removed;
+}
