+void itszScanZDeckWifi()
+{
+    Port.print("\r\nITSZ Z-Deck: WIFI SCAN begin\r\n");
+    WiFi.mode(WIFI_STA);
+    const int count = WiFi.scanNetworks(false, true);
+    if (count < 0) {
+        char line[96];
+        snprintf(line, sizeof(line), "ZDECKWIFI scan failed result=%d\r\n", count);
+        Port.print(line);
+        return;
+    }
+
+    bool configuredSeen = false;
+    int configuredBestRssi = -999;
+    int openCount = 0;
+    int securedCount = 0;
+    for (int i = 0; i < count; ++i) {
+        const String ssid = WiFi.SSID(i);
+        if (ssid == config.network.wifi_ssid) {
+            configuredSeen = true;
+            configuredBestRssi = max(configuredBestRssi, WiFi.RSSI(i));
+        }
+        if (WiFi.encryptionType(i) == WIFI_AUTH_OPEN)
+            ++openCount;
+        else
+            ++securedCount;
+    }
+
+    char line[160];
+    snprintf(line, sizeof(line), "ZDECKWIFI scan count=%d configuredSeen=%s configuredBestRssi=%d open=%d secured=%d\r\n", count,
+             configuredSeen ? "yes" : "no", configuredBestRssi, openCount, securedCount);
+    Port.print(line);
+    WiFi.scanDelete();
+}
