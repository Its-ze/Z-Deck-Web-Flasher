diff --git a/src/itsz/ZDeckGpsQualityPolicy.cpp b/src/itsz/ZDeckGpsQualityPolicy.cpp
new file mode 100644
index 0000000..73895eb
--- /dev/null
+++ b/src/itsz/ZDeckGpsQualityPolicy.cpp
@@ -0,0 +1,44 @@
+#include "itsz/ZDeckGpsQualityPolicy.h"
+
+#include <algorithm>
+
+namespace itsz::zdeck_gps
+{
+
+Assessment Policy::assess(uint8_t fixQuality, uint8_t fixType, uint8_t satellites, uint32_t hdopHundredths, uint32_t ageMs)
+{
+    if (fixQuality < 1 || fixQuality > 5)
+        return {false, Quality::Rejected, 0, "no valid GNSS fix"};
+    if (fixType != 0 && fixType != 3)
+        return {false, Quality::Rejected, 0, "waiting for a 3D fix"};
+    if (ageMs > 2000)
+        return {false, Quality::Rejected, 0, "GNSS solution is stale"};
+    if (satellites < 5)
+        return {false, Quality::Rejected, 0, "waiting for five satellites"};
+    if (hdopHundredths == 0 || hdopHundredths > 250)
+        return {false, Quality::Rejected, 0, "HDOP is above 2.5"};
+
+    const uint16_t errorMeters = std::max<uint16_t>(1, static_cast<uint16_t>((hdopHundredths * 5U + 99U) / 100U));
+    if (satellites >= 10 && hdopHundredths <= 100)
+        return {true, Quality::Excellent, errorMeters, "stable high-quality GNSS fix"};
+    if (satellites >= 7 && hdopHundredths <= 160)
+        return {true, Quality::Good, errorMeters, "good GNSS geometry"};
+    return {true, Quality::Usable, errorMeters, "usable precision GNSS fix"};
+}
+
+const char *Policy::label(Quality quality)
+{
+    switch (quality) {
+    case Quality::Excellent:
+        return "EXCELLENT";
+    case Quality::Good:
+        return "GOOD";
+    case Quality::Usable:
+        return "USABLE";
+    case Quality::Rejected:
+    default:
+        return "SEARCHING";
+    }
+}
+
+} // namespace itsz::zdeck_gps
diff --git a/src/itsz/ZDeckGpsQualityPolicy.h b/src/itsz/ZDeckGpsQualityPolicy.h
new file mode 100644
index 0000000..0a00287
--- /dev/null
+++ b/src/itsz/ZDeckGpsQualityPolicy.h
@@ -0,0 +1,25 @@
+#pragma once
+
+#include <cstdint>
+
+namespace itsz::zdeck_gps
+{
+
+enum class Quality : uint8_t { Rejected = 0, Usable, Good, Excellent };
+
+struct Assessment {
+    bool accepted;
+    Quality quality;
+    uint16_t estimatedErrorMeters;
+    const char *reason;
+};
+
+class Policy
+{
