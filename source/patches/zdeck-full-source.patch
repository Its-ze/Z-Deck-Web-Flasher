+        itsz::zdeck_state::Subsystem::Sd,
+        itsz::zdeck_state::Subsystem::Map,
+        itsz::zdeck_state::Subsystem::Chat,
+    };
+
+    for (auto subsystem : subsystems) {
+        itsz::zdeck_state::formatLine(subsystem, row, sizeof(row));
+        display->drawString(x, getTextPositions(display)[line++], row);
+        if (line >= 6 && SCREEN_HEIGHT <= 64)
+            break;
+    }
+
+    if (SCREEN_HEIGHT > 64) {
+        char uptimeStr[32] = "";
+        getUptimeStr(millis(), "Up: ", uptimeStr, sizeof(uptimeStr));
+        display->drawString(x, getTextPositions(display)[line++], uptimeStr);
+    }
+
+    graphics::drawCommonFooter(display, x, y);
