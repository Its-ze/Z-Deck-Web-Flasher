+static void formatNodeDisplayName(uint32_t nodeNum, char *out, size_t outLen, bool preferShort = false)
+{
+    if (!out || outLen == 0)
+        return;
+
+    out[0] = '\0';
+    meshtastic_NodeInfoLite *node = nodeDB->getMeshNode(nodeNum);
+    if (nodeInfoLiteHasUser(node)) {
+        const char *first = preferShort ? node->short_name : node->long_name;
+        const char *second = preferShort ? node->long_name : node->short_name;
+        if (!isPlaceholderNodeName(first)) {
+            strncpy(out, first, outLen - 1);
+            out[outLen - 1] = '\0';
+            return;
+        }
+        if (!isPlaceholderNodeName(second)) {
+            strncpy(out, second, outLen - 1);
+            out[outLen - 1] = '\0';
+            return;
+        }
+    }
+
+    snprintf(out, outLen, "Node %04x", (unsigned int)(nodeNum & 0xffff));
+}
