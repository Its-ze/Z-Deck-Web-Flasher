@@ -0,0 +1,107 @@
+#include "itsz/ZDeckMapState.h"
+
+namespace itsz::zdeck_map
+{
+
+void Controller::setPage(uint8_t pageIndex)
+{
+    page_ = static_cast<Page>(pageIndex % static_cast<uint8_t>(Page::Count));
+}
+
+void Controller::cyclePage(int direction)
+{
+    const int count = static_cast<int>(Page::Count);
+    int next = (static_cast<int>(page_) + direction) % count;
+    if (next < 0)
+        next += count;
+    page_ = static_cast<Page>(next);
+}
+
+void Controller::requestAutoCenter()
+{
+    awaitingLiveGps_ = true;
+    manualOverride_ = false;
+}
+
+void Controller::noteManualInteraction()
+{
+    awaitingLiveGps_ = false;
+    manualOverride_ = true;
+    centerSource_ = CenterSource::None;
+}
+
+CenterDecision Controller::chooseCenter(const CenterInputs &inputs, bool explicitRequest)
+{
+    if (explicitRequest)
+        requestAutoCenter();
+
+    CenterDecision decision;
+    if (manualOverride_ && !explicitRequest)
+        return decision;
+
+    if (inputs.gps.valid()) {
+        decision.point = inputs.gps;
+        decision.source = CenterSource::Gps;
+        decision.apply = true;
+        awaitingLiveGps_ = false;
+        manualOverride_ = false;
+    } else if (inputs.savedHome.valid()) {
+        decision.point = inputs.savedHome;
+        decision.source = CenterSource::SavedHome;
+        decision.apply = true;
+        awaitingLiveGps_ = inputs.gpsExpected;
+    } else if (inputs.peerCluster.valid()) {
+        decision.point = inputs.peerCluster;
+        decision.source = CenterSource::PeerCluster;
+        decision.apply = true;
+        awaitingLiveGps_ = inputs.gpsExpected;
+    } else {
+        awaitingLiveGps_ = inputs.gpsExpected;
+    }
+
+    centerSource_ = decision.source;
+    decision.awaitingLiveGps = awaitingLiveGps_;
+    return decision;
+}
+
+TileState Controller::classifyTiles(const TileInputs &inputs)
+{
+    if (!inputs.mapOpen)
+        return TileState::Closed;
+    if (inputs.tileSlots > 0 && inputs.missingTiles >= inputs.tileSlots && !inputs.wifiConnected && !inputs.sdReady)
+        return TileState::Grid;
+    if (inputs.tileSlots > 0 && inputs.missingTiles >= inputs.tileSlots)
+        return TileState::Missing;
+    if (inputs.drawing)
+        return TileState::Drawing;
+    if (inputs.missingTiles > 0)
+        return TileState::Missing;
+    if (inputs.tileSlots > 0)
+        return TileState::Ready;
+    if (inputs.wifiConnected)
+        return TileState::Online;
+    return inputs.sdReady ? TileState::Offline : TileState::Grid;
+}
+
+const char *Controller::tileStateLabel(TileState state)
+{
+    switch (state) {
+    case TileState::Closed:
+        return "map closed";
+    case TileState::Drawing:
+        return "drawing tiles";
+    case TileState::Missing:
+        return "tiles missing";
+    case TileState::Ready:
+        return "tiles ready";
+    case TileState::Online:
+        return "online tiles";
+    case TileState::Offline:
+        return "SD tiles";
+    case TileState::Grid:
+        return "grid only";
+    }
+    return "map unknown";
+}
+
+} // namespace itsz::zdeck_map
