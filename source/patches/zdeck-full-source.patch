+#include "itsz/ZDeckMeshModePolicy.h"
+
+#include <cassert>
+#include <cstring>
+#include <limits>
+
+using itsz::zdeck_mesh_mode::Policy;
+using itsz::zdeck_mesh_mode::Recommendation;
+
+int main()
+{
+    auto result = Policy::assess(true, 4, 60, 600);
+    assert(result.recommendation == Recommendation::Meshtastic);
+    assert(result.confidence == 95);
+
+    result = Policy::assess(true, 1, 600, 600);
+    assert(result.recommendation == Recommendation::Meshtastic);
+
+    result = Policy::assess(true, 0, 60, 600);
+    assert(result.recommendation == Recommendation::Meshtastic);
+
+    result = Policy::assess(true, 0, std::numeric_limits<uint32_t>::max(), 60);
+    assert(result.recommendation == Recommendation::Observe);
+
+    result = Policy::assess(false, 0, std::numeric_limits<uint32_t>::max(), 600);
+    assert(result.recommendation == Recommendation::InstallMeshCore);
+
+    result = Policy::assess(true, 0, 31 * 60, 600);
+    assert(result.recommendation == Recommendation::MeshCore);
+    assert(std::strcmp(Policy::label(result.recommendation), "TRY MESHCORE") == 0);
+    return 0;
+}
diff --git a/tests/itsz/test_zdeck_update_policy.cpp b/tests/itsz/test_zdeck_update_policy.cpp
new file mode 100644
index 0000000..155b8e1
--- /dev/null
+++ b/tests/itsz/test_zdeck_update_policy.cpp
@@ -0,0 +1,32 @@
+#include "itsz/ZDeckUpdatePolicy.h"
+
+#include <cassert>
+#include <cstdint>
+
+using itsz::zdeck_update::decodeSha256;
+using itsz::zdeck_update::hashesEqual;
+using itsz::zdeck_update::isVersionNewer;
+
+int main()
+{
+    assert(isVersionNewer("0.2.67-core", "0.2.66-core"));
+    assert(isVersionNewer("2.8.1", "2.8.0-zdeck65"));
+    assert(!isVersionNewer("0.2.65-core", "0.2.65-core"));
+    assert(!isVersionNewer("zdeck65", "zdeck65"));
+    assert(!isVersionNewer("2.7.99", "2.8.0"));
+
+    const char *valid = "0123456789abcdef0123456789ABCDEF0123456789abcdef0123456789ABCDEF";
+    uint8_t decoded[32] = {};
+    uint8_t expected[32] = {};
+    assert(decodeSha256(valid, decoded));
+    assert(decoded[0] == 0x01 && decoded[15] == 0xef && decoded[31] == 0xef);
+    assert(decodeSha256(valid, expected));
+    assert(hashesEqual(decoded, expected));
+
+    expected[31] ^= 1;
+    assert(!hashesEqual(decoded, expected));
+    assert(!decodeSha256("0123", decoded));
+    assert(!decodeSha256("g123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef", decoded));
+    assert(!decodeSha256("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef00", decoded));
+    return 0;
+}
