+void drawZDeckDiagnosticsScreen(OLEDDisplay *display, OLEDDisplayUiState *state, int16_t x, int16_t y)
+{
+    display->clear();
+    display->setFont(FONT_SMALL);
+    display->setTextAlignment(TEXT_ALIGN_LEFT);
+
+    graphics::drawCommonHeader(display, x, y, "Z-Deck Diag");
+
+    int line = 1;
+    char row[128];
+    constexpr itsz::zdeck_state::Subsystem subsystems[] = {
