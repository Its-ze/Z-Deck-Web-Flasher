diff --git a/src/itsz/ZDeckDualBoot.cpp b/src/itsz/ZDeckDualBoot.cpp
new file mode 100644
index 0000000..b34526b
--- /dev/null
+++ b/src/itsz/ZDeckDualBoot.cpp
@@ -0,0 +1,149 @@
+#include "itsz/ZDeckDualBoot.h"
+
+#include "main.h"
+
+#include <cstdio>
+
+#if defined(ARCH_ESP32)
+#include <Preferences.h>
+#include <esp_ota_ops.h>
+#include <esp_partition.h>
+#endif
+
+namespace itsz::zdeck_dual_boot
+{
+namespace
+{
+char status[128] = "MeshCore slot not checked";
+
+#if defined(ARCH_ESP32)
+int8_t cachedAvailability = -1;
+char cachedVersion[49] = {};
+
+bool containsMeshCoreMarker(const esp_partition_t *partition)
+{
+    constexpr char marker[] = "meshcore";
+    uint8_t imageHeader[2048] = {};
+    if (esp_partition_read(partition, 0, imageHeader, sizeof(imageHeader)) != ESP_OK)
+        return false;
+
+    for (size_t offset = 0; offset + sizeof(marker) - 1 <= sizeof(imageHeader); ++offset) {
+        bool matches = true;
+        for (size_t index = 0; index < sizeof(marker) - 1; ++index) {
+            char value = static_cast<char>(imageHeader[offset + index]);
+            if (value >= 'A' && value <= 'Z')
+                value = static_cast<char>(value + ('a' - 'A'));
+            if (value != marker[index]) {
+                matches = false;
+                break;
+            }
+        }
+        if (matches)
+            return true;
+    }
+
+    return false;
+}
+
+const esp_partition_t *loadMeshCoreApp(esp_app_desc_t &appDesc)
+{
+    const esp_partition_t *partition = esp_partition_find_first(ESP_PARTITION_TYPE_APP, ESP_PARTITION_SUBTYPE_APP_TEST,
+                                                                 "meshcore");
+    if (!partition) {
+        // Compatibility with dual-mode installations made before the dedicated MeshCore partition existed.
+        partition = esp_partition_find_first(ESP_PARTITION_TYPE_APP, ESP_PARTITION_SUBTYPE_APP_OTA_1, nullptr);
+    }
+    if (!partition) {
+        snprintf(status, sizeof(status), "MeshCore partition not found");
+        return nullptr;
+    }
+
+    const esp_err_t result = esp_ota_get_partition_description(partition, &appDesc);
+    if (result != ESP_OK) {
+        snprintf(status, sizeof(status), "MeshCore image is not bootable (%d)", static_cast<int>(result));
+        return nullptr;
+    }
+
+    if (!containsMeshCoreMarker(partition)) {
+        snprintf(status, sizeof(status), "Dedicated mesh image is not MeshCore");
+        return nullptr;
+    }
+
+    return partition;
+}
+#endif
+} // namespace
+
+bool meshCoreAvailable()
+{
+#if defined(ARCH_ESP32)
+    if (cachedAvailability >= 0) {
+        if (cachedAvailability == 1)
+            snprintf(status, sizeof(status), "MeshCore %.48s ready", cachedVersion);
+        return cachedAvailability == 1;
+    }
+
+    esp_app_desc_t appDesc = {};
+    if (!loadMeshCoreApp(appDesc)) {
+        cachedAvailability = 0;
+        return false;
+    }
+
+    cachedAvailability = 1;
+    snprintf(cachedVersion, sizeof(cachedVersion), "%.48s", appDesc.version);
+    snprintf(status, sizeof(status), "MeshCore %.48s ready", appDesc.version);
+    return true;
+#else
+    snprintf(status, sizeof(status), "MeshCore switching requires ESP32");
+    return false;
+#endif
+}
+
+bool switchToMeshCore()
+{
+#if defined(ARCH_ESP32)
+    esp_app_desc_t appDesc = {};
+    const esp_partition_t *partition = loadMeshCoreApp(appDesc);
+    if (!partition)
+        return false;
+
+    const esp_partition_t *running = esp_ota_get_running_partition();
+    if (!running || (running->subtype != ESP_PARTITION_SUBTYPE_APP_OTA_0 &&
+                     running->subtype != ESP_PARTITION_SUBTYPE_APP_OTA_1)) {
+        snprintf(status, sizeof(status), "Current Z-Deck OTA slot is invalid");
+        return false;
+    }
+
+    Preferences preferences;
+    if (!preferences.begin("zdeck-boot", false)) {
+        snprintf(status, sizeof(status), "Could not save the Z-Deck return slot");
+        return false;
+    }
+    const size_t saved = preferences.putUChar("zslot", static_cast<uint8_t>(running->subtype));
+    preferences.end();
+    if (saved != sizeof(uint8_t)) {
+        snprintf(status, sizeof(status), "Could not save the Z-Deck return slot");
+        return false;
+    }
+
+    const esp_err_t result = esp_ota_set_boot_partition(partition);
+    if (result != ESP_OK) {
+        snprintf(status, sizeof(status), "MeshCore boot selection failed (%d)", static_cast<int>(result));
+        return false;
+    }
+
+    snprintf(status, sizeof(status), "Booting MeshCore %.48s", appDesc.version);
+    rebootAtMsec = millis() + 750;
+    return true;
+#else
+    snprintf(status, sizeof(status), "MeshCore switching requires ESP32");
+    return false;
+#endif
+}
+
+const char *statusText()
+{
+    return status;
+}
+
+} // namespace itsz::zdeck_dual_boot
