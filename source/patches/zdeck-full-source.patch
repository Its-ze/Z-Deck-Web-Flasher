+#include "itsz/ZDeckDisplayPolicy.h"
+
+#include <algorithm>
+
+namespace itsz::zdeck_display
+{
+
+TimeoutMode Policy::timeoutMode(bool alwaysOnEnabled, uint8_t batteryPercent)
+{
+    if (!alwaysOnEnabled)
+        return TimeoutMode::ScreenOff;
+    if (batteryPercent > 0 && batteryPercent <= 10)
+        return TimeoutMode::ScreenOff;
+    return TimeoutMode::AlwaysOn;
+}
+
+uint8_t Policy::alwaysOnBrightness(uint8_t normalBrightness)
+{
+    return std::clamp<uint8_t>(normalBrightness / 8, 5, 18);
+}
+
+uint32_t Policy::alwaysOnRefreshMs()
+{
+    return 60000;
+}
+
+} // namespace itsz::zdeck_display
