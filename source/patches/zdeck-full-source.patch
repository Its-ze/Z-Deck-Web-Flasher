+
+bool itszRunZDeckCommand(const char *line)
+{
+    if (!itszIsZDeckCommand(line))
+        return false;
+
+    if (itszEqualsIgnoreCase(line, "itsz zdeck") || itszEqualsIgnoreCase(line, "itsz:zdeck") ||
+        itszEqualsIgnoreCase(line, "itsz zdeck help") || itszEqualsIgnoreCase(line, "itsz:zdeck:help")) {
+        itszPrintZDeckHelp();
+        return true;
+    }
+
+    if (itszEqualsIgnoreCase(line, "itsz zdeck status") || itszEqualsIgnoreCase(line, "itsz:zdeck:status") ||
+        itszEqualsIgnoreCase(line, "itsz zdeck debug") || itszEqualsIgnoreCase(line, "itsz:zdeck:debug")) {
+        itszPrintZDeckStatus();
+        return true;
+    }
+
+    if (itszEqualsIgnoreCase(line, "itsz zdeck backup-queue") ||
+        itszEqualsIgnoreCase(line, "itsz zdeck backup queued") ||
+        itszEqualsIgnoreCase(line, "itsz:zdeck:backup:queue")) {
+        Port.print("\r\nITSZ Z-Deck: BACKUP SD queue begin\r\n");
+        const bool ok = itsz::zdeck_update::requestSdBackup();
+        Port.print(ok ? "ITSZ Z-Deck: BACKUP SD queued\r\n" : "ITSZ Z-Deck: BACKUP SD queue busy\r\n");
+        itszPrintZDeckStatus();
+        return true;
+    }
+
+    if (itszEqualsIgnoreCase(line, "itsz zdeck backup") || itszEqualsIgnoreCase(line, "itsz zdeck backup-sd") ||
+        itszEqualsIgnoreCase(line, "itsz:zdeck:backup")) {
+        Port.print("\r\nITSZ Z-Deck: BACKUP SD begin\r\n");
+        const bool ok = nodeDB && nodeDB->backupPreferences(meshtastic_AdminMessage_BackupLocation_SD);
+        Port.print(ok ? "ITSZ Z-Deck: BACKUP SD ok\r\n" : "ITSZ Z-Deck: BACKUP SD failed\r\n");
+        itszPrintZDeckStatus();
+        return true;
+    }
+
+#if defined(ARCH_ESP32) && HAS_WIFI && defined(ZDECK_PUBLIC_BUILD)
+    if (itszEqualsIgnoreCase(line, "itsz zdeck wifi") || itszEqualsIgnoreCase(line, "itsz:zdeck:wifi") ||
+        itszEqualsIgnoreCase(line, "itsz zdeck wifi status") || itszEqualsIgnoreCase(line, "itsz:zdeck:wifi:status")) {
+        itszPrintZDeckWifiStatus();
+        return true;
+    }
+
+    if (itszEqualsIgnoreCase(line, "itsz zdeck wifi scan") || itszEqualsIgnoreCase(line, "itsz:zdeck:wifi:scan")) {
+        itszScanZDeckWifi();
+        itszPrintZDeckWifiStatus();
+        return true;
+    }
+
+    if (itszEqualsIgnoreCase(line, "itsz zdeck wifi start") || itszEqualsIgnoreCase(line, "itsz zdeck wifi reconnect") ||
+        itszEqualsIgnoreCase(line, "itsz:zdeck:wifi:start") || itszEqualsIgnoreCase(line, "itsz:zdeck:wifi:reconnect")) {
+        itszStartZDeckWifi();
+        return true;
+    }
+
+    if (itszEqualsIgnoreCase(line, "itsz zdeck ota check") || itszEqualsIgnoreCase(line, "itsz:zdeck:ota:check") ||
+        itszEqualsIgnoreCase(line, "itsz zdeck update check")) {
+        Port.print("\r\nITSZ Z-Deck: OTA CHECK begin\r\n");
+        const bool ok = itsz::zdeck_update::checkForUpdates();
+        Port.print(ok ? "ITSZ Z-Deck: OTA CHECK ok\r\n" : "ITSZ Z-Deck: OTA CHECK failed\r\n");
+        itszPrintZDeckStatus();
+        return true;
+    }
+
+    if (itszEqualsIgnoreCase(line, "itsz zdeck ota apply") || itszEqualsIgnoreCase(line, "itsz:zdeck:ota:apply") ||
+        itszEqualsIgnoreCase(line, "itsz zdeck update apply")) {
+        Port.print("\r\nITSZ Z-Deck: OTA APPLY begin\r\n");
+        Port.print("ITSZ Z-Deck: streaming debug as ZDECKDBG lines until reboot/failure\r\n");
+        const bool ok = itsz::zdeck_update::applyCachedUpdate();
+        Port.print(ok ? "ITSZ Z-Deck: OTA APPLY ok\r\n" : "ITSZ Z-Deck: OTA APPLY failed\r\n");
+        itszPrintZDeckStatus();
+        return true;
+    }
+#endif
+
+    if (itszEqualsIgnoreCase(line, "itsz zdeck switch meshcore") ||
+        itszEqualsIgnoreCase(line, "itsz:zdeck:switch:meshcore")) {
+        itszSwitchToMeshCore();
+        return true;
+    }
+
+    if (itszEqualsIgnoreCase(line, "itsz zdeck restore confirm") ||
+        itszEqualsIgnoreCase(line, "itsz:zdeck:restore:confirm")) {
+        Port.print("\r\nITSZ Z-Deck: RESTORE SD confirm begin\r\n");
+        const bool ok = nodeDB && nodeDB->restorePreferences(meshtastic_AdminMessage_BackupLocation_SD,
+                                                             SEGMENT_CONFIG | SEGMENT_MODULECONFIG | SEGMENT_DEVICESTATE |
+                                                                 SEGMENT_CHANNELS);
+        Port.print(ok ? "ITSZ Z-Deck: RESTORE SD ok; rebooting\r\n" : "ITSZ Z-Deck: RESTORE SD failed\r\n");
+        itszPrintZDeckStatus();
+        if (ok)
+            rebootAtMsec = millis() + 1500;
+        return true;
+    }
+
+    return true;
+}
+
+bool itszRunRecoveryLine()
+{
+    itszRecoveryLine[itszRecoveryLineLen] = '\0';
+
+    if (itszRunZDeckCommand(itszRecoveryLine)) {
+        Port.flush();
+        return true;
+    }
+
+    if (itszIsBootloaderCommand(itszRecoveryLine)) {
+        Port.print("\r\nITSZ recovery: entering ESP32 ROM download mode\r\n");
+        Port.flush();
+        delay(250);
+        enterDfuMode();
+        return true;
+    }
+
+    if (itszIsRebootCommand(itszRecoveryLine)) {
+        Port.print("\r\nITSZ recovery: rebooting\r\n");
+        Port.flush();
+        rebootAtMsec = millis() + 250;
+        return true;
+    }
+
+    return false;
+}
+
+bool itszObserveRecoveryByte(uint8_t c)
+{
+    if (c == '\r' || c == '\n') {
+        if (itszRecoveryLineLen == 0) {
+            return false;
+        }
+
+        bool handled = itszRunRecoveryLine();
+        itszRecoveryLineLen = 0;
+        return handled;
+    }
+
+    if (c < 0x20 || c > 0x7e) {
+        itszRecoveryLineLen = 0;
+        return false;
+    }
+
+    if (itszRecoveryLineLen >= ITSZ_RECOVERY_LINE_MAX - 1) {
+        memmove(itszRecoveryLine, itszRecoveryLine + 1, ITSZ_RECOVERY_LINE_MAX - 2);
+        itszRecoveryLineLen = ITSZ_RECOVERY_LINE_MAX - 2;
+    }
+
+    itszRecoveryLine[itszRecoveryLineLen++] = static_cast<char>(c);
+    return false;
+}
+
+bool itszObserveRecoveryBytes(const char *buf, uint16_t len)
+{
+    for (uint16_t i = 0; i < len; ++i) {
+        if (itszObserveRecoveryByte(static_cast<uint8_t>(buf[i]))) {
+            return true;
+        }
+    }
+
+    return false;
+}
