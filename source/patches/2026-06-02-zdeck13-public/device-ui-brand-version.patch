diff --git a/source/graphics/TFT/TFTView_320x240.cpp b/source/graphics/TFT/TFTView_320x240.cpp
--- a/source/graphics/TFT/TFTView_320x240.cpp
+++ b/source/graphics/TFT/TFTView_320x240.cpp
@@ -113,5 +113,26 @@
 extern const char *firmware_version;

+#ifndef APP_BUILD_NAME
+#define APP_BUILD_NAME ""
+#endif
+
+#ifndef ZDECK_PACK_VERSION
+#define ZDECK_PACK_VERSION "dev"
+#endif
+
+static const char *itszBootFirmwareLabel()
+{
+    static char label[40];
+    if (label[0] == '\0') {
+        const char *buildName = APP_BUILD_NAME;
+        if (buildName != nullptr && buildName[0] != '\0')
+            snprintf(label, sizeof(label), "Z-Deck %s", ZDECK_PACK_VERSION);
+        else
+            snprintf(label, sizeof(label), "%s", firmware_version);
+    }
+    return label;
+}
