+void TFTView_320x240::setupZDeckMeshHandoff(void)
+{
+#if defined(ARCH_ESP32) && HAS_WIFI && defined(ZDECK_PUBLIC_BUILD)
+    if (zDeckMeshQuickButton || !objects.top_panel)
+        return;
+
+    const bool available = itsz::zdeck_dual_boot::meshCoreAvailable();
+    zDeckMeshQuickButton = lv_btn_create(objects.top_panel);
+    lv_obj_set_size(zDeckMeshQuickButton, 58, 20);
+    lv_obj_set_align(zDeckMeshQuickButton, LV_ALIGN_LEFT_MID);
+    lv_obj_set_pos(zDeckMeshQuickButton, 2, 0);
+    lv_obj_set_style_radius(zDeckMeshQuickButton, 3, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_bg_color(zDeckMeshQuickButton, colorDarkGray, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_border_color(zDeckMeshQuickButton, available ? colorBlueGreen : colorGray,
+                                  LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_border_width(zDeckMeshQuickButton, 1, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_shadow_width(zDeckMeshQuickButton, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_add_event_cb(zDeckMeshQuickButton, ui_event_zdeckMeshCoreButton, LV_EVENT_CLICKED, NULL);
+    if (!available)
+        lv_obj_add_state(zDeckMeshQuickButton, LV_STATE_DISABLED);
+
+    lv_obj_t *label = lv_label_create(zDeckMeshQuickButton);
+    lv_label_set_text(label, available ? "MESH >" : "MESH --");
+    lv_obj_set_style_text_font(label, &lv_font_montserrat_10, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_text_color(label, available ? colorBlueGreen : colorGray, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_center(label);
+#endif
+}
