+void TFTView_320x240::timer_event_screen_correction(lv_timer_t *timer)
+{
+    if (!THIS->screenCorrectionOverlay || timer != THIS->screenCorrectionTimer)
+        return;
+
+    THIS->screenCorrectionStep++;
+    if (THIS->screenCorrectionStep > 15) {
+        THIS->stopScreenCorrection();
+        THIS->messageAlert(_("Screen correction done"), true);
+        return;
+    }
+
+    THIS->showScreenCorrectionStep();
+}
