+
+String itszFormatNode(uint32_t node)
+{
+    if (node == 0xffffffffU)
+        return String("^all");
+    if (node == 0U)
+        return String("");
+
+    char buf[12];
+    snprintf(buf, sizeof(buf), "!%08x", (unsigned int)node);
+    return String(buf);
+}
+
+String itszEscapeJson(const uint8_t *msg, size_t len)
+{
+    String out;
+    out.reserve(len + 8);
+    for (size_t i = 0; i < len; i++) {
+        const char c = (char)msg[i];
+        switch (c) {
+        case '\\':
+            out += "\\\\";
+            break;
+        case '"':
+            out += "\\\"";
+            break;
+        case '\n':
+            out += "\\n";
+            break;
+        case '\r':
+            out += "\\r";
+            break;
+        case '\t':
+            out += "\\t";
+            break;
+        default:
+            if ((uint8_t)c < 0x20) {
+                char esc[7];
+                snprintf(esc, sizeof(esc), "\\u%04x", (unsigned int)(uint8_t)c);
+                out += esc;
+            } else {
+                out += c;
+            }
+            break;
+        }
+    }
+    return out;
+}
+
+void itszAppendSdMessageJournal(const char *direction, uint32_t from, uint32_t to, uint8_t ch, uint32_t msgTime, size_t msgLen,
+                                const uint8_t *msg)
+{
+    if (msgLen > 0 && msg == nullptr)
+        return;
+
+    if (sdCard != nullptr && sdCard->cardType() == ISdCard::eNone)
+        return;
+
+    SDFs.mkdir(itszSdRootDir);
+    SDFs.mkdir(itszSdHistoryDir);
+
+#if defined(HAS_SDCARD) && !defined(HAS_SD_MMC) && !defined(ARCH_PORTDUINO)
+    FsFile file = SDFs.open(itszSdHistoryPath, O_RDWR | O_CREAT | O_APPEND);
+#else
+    File file = SDFs.open(itszSdHistoryPath, FILE_APPEND);
+#endif
+    if (!file) {
+        ILOG_DEBUG("ITSZ SD message journal unavailable: %s", itszSdHistoryPath);
+        return;
+    }
+
+    String text = itszEscapeJson(msg, msgLen);
+    file.print("{\"schema\":1,\"time\":");
+    file.print((uint32_t)msgTime);
+    file.print(",\"direction\":\"");
+    file.print(direction);
+    file.print("\",\"from\":\"");
+    file.print(itszFormatNode(from));
+    file.print("\",\"to\":\"");
+    file.print(itszFormatNode(to));
+    file.print("\",\"channel\":");
+    file.print((uint32_t)ch);
+    file.print(",\"text\":\"");
+    file.print(text);
+    file.println("\"}");
+    file.close();
+}
+#else
+void itszAppendSdMessageJournal(const char *, uint32_t, uint32_t, uint8_t, uint32_t, size_t, const uint8_t *) {}
+#endif
+} // namespace
