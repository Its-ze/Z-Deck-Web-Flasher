+void UITask::switchToZDeck() {
+#ifdef ESP32
+  uint8_t returnSubtype = ESP_PARTITION_SUBTYPE_APP_OTA_0;
+  Preferences preferences;
+  if (preferences.begin("zdeck-boot", true)) {
+    const uint8_t saved = preferences.getUChar("zslot", ESP_PARTITION_SUBTYPE_APP_OTA_0);
+    preferences.end();
+    if (saved == ESP_PARTITION_SUBTYPE_APP_OTA_0 || saved == ESP_PARTITION_SUBTYPE_APP_OTA_1)
+      returnSubtype = saved;
+  }
+
+  const esp_partition_t* part = esp_partition_find_first(
+      ESP_PARTITION_TYPE_APP, static_cast<esp_partition_subtype_t>(returnSubtype), NULL);
+  if (part == NULL && returnSubtype != ESP_PARTITION_SUBTYPE_APP_OTA_0) {
+    part = esp_partition_find_first(ESP_PARTITION_TYPE_APP, ESP_PARTITION_SUBTYPE_APP_OTA_0, NULL);
+  }
+  if (part == NULL) {
+    showAlert("Z-Deck slot missing", 2000);
+    return;
+  }
+
+  esp_app_desc_t appDesc = {};
+  if (esp_ota_get_partition_description(part, &appDesc) != ESP_OK) {
+    showAlert("Z-Deck slot invalid", 2000);
+    return;
+  }
+
+  constexpr char marker[] = "zdeck";
+  bool zdeckVersion = false;
+  for (size_t offset = 0; offset < sizeof(appDesc.version) && appDesc.version[offset] != '\0' && !zdeckVersion; ++offset) {
+    size_t index = 0;
+    while (marker[index] != '\0' && offset + index < sizeof(appDesc.version) &&
+           appDesc.version[offset + index] != '\0') {
+      char value = appDesc.version[offset + index];
+      if (value >= 'A' && value <= 'Z')
+        value = static_cast<char>(value + ('a' - 'A'));
+      if (value != marker[index])
+        break;
+      ++index;
+    }
+    zdeckVersion = marker[index] == '\0';
+  }
+  if (!zdeckVersion) {
+    showAlert("App0 is not Z-Deck", 2000);
+    return;
+  }
+
+  if (esp_ota_set_boot_partition(part) != ESP_OK) {
+    showAlert("Switch failed", 2000);
+    return;
+  }
+
+  showAlert("Z-Deck verified; rebooting", 500);
+  delay(250);
+  _board->reboot();
+#else
+  showAlert("ESP32 only", 2000);
+#endif
+}
