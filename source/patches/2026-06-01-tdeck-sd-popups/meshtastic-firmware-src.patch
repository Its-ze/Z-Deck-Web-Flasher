+
+static bool writeMessagesToSD(const std::deque<StoredMessage> &messages)
+{
+    if (!sdMessageStorageReady()) {
+        return false;
+    }
+
+    concurrency::LockGuard guard(spiLock);
+    SD.mkdir(SD_MESSAGE_DIR);
+    SD.remove(SD_MESSAGE_TMP_FILE);
+
+    File f = SD.open(SD_MESSAGE_TMP_FILE, FILE_WRITE);
+    if (!f) {
+        LOG_WARN("MessageStore: could not open SD temp file");
+        return false;
+    }
+
+    uint8_t count = static_cast<uint8_t>(messages.size());
+    if (count > MAX_MESSAGES_SAVED) {
+        count = MAX_MESSAGES_SAVED;
+    }
+
+    f.write(&count, 1);
+    for (uint8_t i = 0; i < count; ++i) {
+        StoredMessageRecord rec = {};
+        const StoredMessage &m = messages[i];
+        rec.timestamp = m.timestamp;
+        rec.sender = m.sender;
+        rec.channelIndex = m.channelIndex;
+        rec.dest = m.dest;
+        rec.isBootRelative = m.isBootRelative;
+        rec.ackStatus = static_cast<uint8_t>(m.ackStatus);
+        rec.type = static_cast<uint8_t>(m.type);
+        rec.textLength = m.textLength;
+
+        const char *txt = getTextFromPool(m.textOffset);
+        strncpy(rec.text, txt, MAX_MESSAGE_SIZE - 1);
+        rec.text[MAX_MESSAGE_SIZE - 1] = '\0';
+        f.write(reinterpret_cast<const uint8_t *>(&rec), sizeof(rec));
+    }
+
+    f.flush();
+    f.close();
+
+    SD.remove(SD_MESSAGE_FILE);
+    if (!SD.rename(SD_MESSAGE_TMP_FILE, SD_MESSAGE_FILE)) {
+        LOG_WARN("MessageStore: could not promote SD message file");
+        SD.remove(SD_MESSAGE_TMP_FILE);
+        return false;
+    }
+
+    return true;
+}
+
+static bool loadMessagesFromSD(std::deque<StoredMessage> &messages)
+{
+    if (!sdMessageStorageReady()) {
+        return false;
+    }
+
+    concurrency::LockGuard guard(spiLock);
+    if (!SD.exists(SD_MESSAGE_FILE)) {
+        return false;
+    }
+
+    File f = SD.open(SD_MESSAGE_FILE, FILE_READ);
+    if (!f) {
+        return false;
+    }
+
+    uint8_t count = 0;
+    if (f.readBytes(reinterpret_cast<char *>(&count), 1) != 1) {
+        f.close();
+        return false;
+    }
+
+    if (count > MAX_MESSAGES_SAVED) {
+        count = MAX_MESSAGES_SAVED;
+    }
+
+    if (count == 0) {
+        f.close();
+        return true;
+    }
+
+    for (uint8_t i = 0; i < count; ++i) {
+        StoredMessage m;
+        if (!readMessageRecord(f, m)) {
+            break;
+        }
+        messages.push_back(m);
+    }
+
+    f.close();
+    return true;
+}
