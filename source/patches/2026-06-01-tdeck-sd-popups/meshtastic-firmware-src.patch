+static void formatLastHeard(char *timeStr, size_t size, meshtastic_NodeInfoLite *node)
+{
+    uint32_t seconds = sinceLastSeen(node);
+    if (seconds == UINT32_MAX) {
+        snprintf(timeStr, size, "?");
+    } else if (seconds < 60) {
+        snprintf(timeStr, size, "now");
+    } else if (seconds < 3600) {
+        snprintf(timeStr, size, "%um", static_cast<unsigned int>(seconds / 60));
+    } else if (seconds < 86400) {
+        snprintf(timeStr, size, "%uh", static_cast<unsigned int>(seconds / 3600));
+    } else {
+        uint32_t days = seconds / 86400;
+        if (days > 365) {
+            snprintf(timeStr, size, "old");
+        } else {
+            snprintf(timeStr, size, "%ud", static_cast<unsigned int>(days));
+        }
+    }
+}
