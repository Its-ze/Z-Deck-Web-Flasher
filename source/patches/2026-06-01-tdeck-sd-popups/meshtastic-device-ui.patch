+
+    int32_t screenWidth = lv_display_get_horizontal_resolution(displaydriver->getDisplay());
+    int32_t panelWidth = std::max<int32_t>(210, std::min<int32_t>(screenWidth - 24, 292));
+    int32_t buttonWidth = (panelWidth - 30) / 2;
+
+    sdSetupPanel = lv_obj_create(objects.main_screen);
+    lv_obj_set_size(sdSetupPanel, panelWidth, 136);
+    lv_obj_align(sdSetupPanel, LV_ALIGN_CENTER, 0, 0);
+    lv_obj_clear_flag(sdSetupPanel, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_add_flag(sdSetupPanel, LV_OBJ_FLAG_HIDDEN);
+    add_style_alert_panel_style(sdSetupPanel);
+    lv_obj_set_style_border_width(sdSetupPanel, 2, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_border_color(sdSetupPanel, colorMesh, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_pad_all(sdSetupPanel, 8, LV_PART_MAIN | LV_STATE_DEFAULT);
+
+    lv_obj_t *title = lv_label_create(sdSetupPanel);
+    lv_obj_set_width(title, LV_PCT(100));
