+
+bool LittleFSService::load(const char *name, void *img)
+{
+#if defined(FSCom) && defined(ARCH_ESP32)
+    File file = FSCom.open(name, FILE_O_READ);
+    if (!file) {
+        return false;
+    }
+
+    const size_t len = file.size();
+    if (len == 0 || len > 512 * 1024) {
+        file.close();
+        ILOG_WARN("LittleFS tile rejected: %s (%u bytes)", name, (unsigned int)len);
+        return false;
+    }
+
+    uint8_t *pngImage = (uint8_t *)lv_malloc(len);
+    if (!pngImage) {
+        file.close();
+        ILOG_ERROR("lv_malloc failed for LittleFS tile %s (%u bytes)", name, (unsigned int)len);
+        return false;
+    }
+
+    const size_t bytesRead = file.read(pngImage, len);
+    file.close();
+    if (bytesRead != len) {
+        lv_free(pngImage);
+        ILOG_ERROR("LittleFS tile read error %s: %u != %u", name, (unsigned int)bytesRead, (unsigned int)len);
+        return false;
+    }
+
+    lv_img_dsc_t *img_dsc = nullptr;
+    const bool decoded = MapTileSettings::color() ? decodeImgColor(pngImage, len, &img_dsc) : decodeImgGrey(pngImage, len, &img_dsc);
+    lv_free(pngImage);
+
+    if (!decoded || !img_dsc) {
+        ILOG_ERROR("Failed to decode LittleFS tile %s", name);
+        return false;
+    }
+
+    lv_obj_t *img_obj = (lv_obj_t *)img;
+    lv_image_set_src(img_obj, img_dsc);
+    if (lv_image_get_src(img_obj) != img_dsc) {
+        ILOG_ERROR("lv_image_set_src failed for LittleFS tile %s", name);
+        if (img_dsc->data && img_dsc->data_size > 0) {
+            lv_free((void *)img_dsc->data);
+        }
+        lv_free(img_dsc);
+        return false;
+    }
+
+    ILOG_DEBUG("LittleFS tile loaded: %s", name);
+    return true;
+#else
+    return false;
+#endif
+}
