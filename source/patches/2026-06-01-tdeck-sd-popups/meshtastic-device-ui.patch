+static bool sanitizeUIConfig(meshtastic_DeviceUIConfig &config)
+{
+    bool changed = false;
+
+    if (config.theme != meshtastic_Theme_DARK && config.theme != meshtastic_Theme_LIGHT) {
+        config.theme = meshtastic_Theme_DARK;
+        changed = true;
+    }
+
+    if (config.screen_timeout == 1 || (defaultScreenTimeoutSecs > 30 && config.screen_timeout < defaultScreenTimeoutSecs)) {
+        config.screen_timeout = defaultScreenTimeoutSecs;
+        changed = true;
+    }
+
+    if (config.screen_brightness == 0) {
+        config.screen_brightness = 153;
+        changed = true;
+    }
+
+    return changed;
+}
