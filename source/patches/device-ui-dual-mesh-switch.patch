+void TFTView_320x240::ui_event_zdeckMeshCoreButton(lv_event_t *e)
+{
+    if (lv_event_get_code(e) != LV_EVENT_CLICKED || THIS->activeSettings != eNone)
+        return;
+
+#if defined(ARCH_ESP32) && HAS_WIFI && defined(ZDECK_PUBLIC_BUILD)
+    THIS->zDeckUpdateRestoreArmed = false;
+    zDeckReleaseUpdateButton(THIS->zDeckMeshCoreButton);
+
+    if (!itsz::zdeck_dual_boot::meshCoreAvailable()) {
+        THIS->zDeckMeshCoreArmed = false;
+        THIS->updateZDeckUpdateStatusLabel(itsz::zdeck_dual_boot::statusText());
+        THIS->messageAlert("MeshCore is not installed", true);
+        return;
+    }
+
+    if (!THIS->zDeckMeshCoreArmed) {
+        THIS->zDeckMeshCoreArmed = true;
+        THIS->updateZDeckUpdateStatusLabel("Press SWITCH TO MESHCORE again to reboot. Z-Deck stays in app0.");
+        THIS->messageAlert("Press MeshCore switch again", true);
+        return;
+    }
+
+    THIS->zDeckMeshCoreArmed = false;
+    const bool switching = itsz::zdeck_dual_boot::switchToMeshCore();
+    THIS->updateZDeckUpdateStatusLabel(itsz::zdeck_dual_boot::statusText());
+    THIS->messageAlert(switching ? "Rebooting into MeshCore" : "MeshCore switch failed", true);
+#endif
+}
