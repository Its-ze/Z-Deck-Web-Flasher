+uint8_t zDeckLoadMapPagePreference(uint8_t defaultValue)
+{
+    File file = fileSystem.open(zDeckMapPagePreferencePath, FILE_READ);
+    if (file) {
+        int value = file.read();
+        file.close();
+        if (value >= '0' && value < '0' + (int)zDeckMapPageCount())
+            return (uint8_t)(value - '0');
+    }
+    return defaultValue % zDeckMapPageCount();
+}
