+void TFTView_320x240::cycleZDeckMapPage(void)
+{
+    zDeckEnsureMapStyle(db.uiConfig.map_data);
+    const int next = (zDeckMapPageIndex(db.uiConfig.map_data.style) + 1) %
+                     (int)(sizeof(zDeckMapPages) / sizeof(zDeckMapPages[0]));
+    strncpy(db.uiConfig.map_data.style, zDeckMapPages[next].style, sizeof(db.uiConfig.map_data.style) - 1);
+    db.uiConfig.map_data.style[sizeof(db.uiConfig.map_data.style) - 1] = '\0';
+    db.uiConfig.has_map_data = true;
+    MapTileSettings::setPrefix("/maps");
+    MapTileSettings::setTileStyle(db.uiConfig.map_data.style);
+    if (cardDetected)
+        MapTileSettings::setSaveOK(true);
+    controller->storeUIConfig(db.uiConfig);
+    if (map)
+        map->forceRedraw();
+    updateDynamicMapMenu();
+    char msg[48];
+    lv_snprintf(msg, sizeof(msg), "Default map: %s", zDeckMapPages[next].name);
+    messageAlert(msg, true);
+}
