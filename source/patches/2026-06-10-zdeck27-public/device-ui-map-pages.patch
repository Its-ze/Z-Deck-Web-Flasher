+struct ZDeckMapPage {
+    const char *style;
+    const char *name;
+    const char *button;
+};
+
+constexpr ZDeckMapPage zDeckMapPages[] = {
+    {"zdeck-mesh", "Mesh map", "MESH"},
+    {"zdeck-compass", "Live compass", "COMPASS"},
+    {"zdeck-radar", "DF/Radar", "RADAR"},
+    {"zdeck-alert", "Distance alert", "ALERT"},
+};
+
+int zDeckMapPageIndex(const char *style)
+{
+    if (!style || !style[0])
+        return 0;
+    for (size_t i = 0; i < sizeof(zDeckMapPages) / sizeof(zDeckMapPages[0]); ++i) {
+        if (strcmp(style, zDeckMapPages[i].style) == 0)
+            return (int)i;
+    }
+    return 0;
+}
+
+bool zDeckMapStyleIsManaged(const char *style)
+{
+    if (!style || !style[0])
+        return true;
+    for (const auto &page : zDeckMapPages) {
+        if (strcmp(style, page.style) == 0)
+            return true;
+    }
+    return false;
+}
+
+void zDeckEnsureMapStyle(meshtastic_Map &mapData)
+{
+    if (!mapData.style[0]) {
+        strncpy(mapData.style, zDeckMapPages[0].style, sizeof(mapData.style) - 1);
+        mapData.style[sizeof(mapData.style) - 1] = '\0';
+    }
+}
+
+const ZDeckMapPage &zDeckCurrentMapPage(const meshtastic_Map &mapData)
+{
+    return zDeckMapPages[zDeckMapPageIndex(mapData.style)];
+}
