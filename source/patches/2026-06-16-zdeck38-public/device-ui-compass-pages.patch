+
+float zDeckWrapRadians(float angle)
+{
+    const float fullTurn = 2.0f * PI;
+    while (angle < 0.0f)
+        angle += fullTurn;
+    while (angle >= fullTurn)
+        angle -= fullTurn;
+    return angle;
+}
+
+void zDeckSetLineToAngle(lv_obj_t *line, lv_point_precise_t *points, int16_t cx, int16_t cy, int16_t radius, float angle)
+{
+    points[0].x = cx;
+    points[0].y = cy;
+    points[1].x = cx + (lv_value_precise_t)roundf(sinf(angle) * radius);
+    points[1].y = cy - (lv_value_precise_t)roundf(cosf(angle) * radius);
+    lv_line_set_points(line, points, 2);
+    lv_obj_clear_flag(line, LV_OBJ_FLAG_HIDDEN);
+}
+
+void zDeckPlaceCompassLabel(lv_obj_t *label, int16_t cx, int16_t cy, int16_t radius, float angle)
+{
+    lv_obj_set_pos(label, cx + (int16_t)roundf(sinf(angle) * radius) - 6,
+                   cy - (int16_t)roundf(cosf(angle) * radius) - 6);
+}
+
+float zDeckRadiansToDegrees360(float angle)
+{
+    return zDeckWrapRadians(angle) * 180.0f / PI;
+}
+
+bool zDeckUpdateCompassHeading(int32_t lat, int32_t lon, float &heading)
+{
+    if (!lat || !lon)
+        return false;
+
+    if (zDeckCompassLastLat && zDeckCompassLastLon) {
+        const float dx = 71.5f * 1e-7f * (lon - zDeckCompassLastLon);
+        const float dy = 111.3f * 1e-7f * (lat - zDeckCompassLastLat);
+        const float movedKm = sqrtf(dx * dx + dy * dy);
+        if (movedKm >= 0.005f) {
+            zDeckCompassHeading = GeoCoord::bearing(zDeckCompassLastLat * 1e-7, zDeckCompassLastLon * 1e-7, lat * 1e-7, lon * 1e-7);
+            zDeckCompassHeadingValid = true;
+            zDeckCompassLastLat = lat;
+            zDeckCompassLastLon = lon;
+        }
+    } else {
+        zDeckCompassLastLat = lat;
+        zDeckCompassLastLon = lon;
+    }
+
+    if (!zDeckCompassHeadingValid)
+        return false;
+
+    heading = zDeckCompassHeading;
+    return true;
+}
