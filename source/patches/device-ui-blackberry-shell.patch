+void TFTView_320x240::timer_event_zdeckAlwaysOn(lv_timer_t *timer)
+{
+    if (timer == THIS->zDeckAlwaysOnTimer && THIS->zDeckAlwaysOnActive)
+        THIS->updateZDeckAlwaysOnDisplay();
+}
