+{
+    if (lv_event_get_code(e) != LV_EVENT_CLICKED || THIS->activeSettings != eNone)
+        return;
+    THIS->setZDeckAlwaysOn(!THIS->zDeckAlwaysOnEnabled);
+    THIS->messageAlert(THIS->zDeckAlwaysOnEnabled ? "Always-on display enabled" : "Always-on display disabled", true);
+}
