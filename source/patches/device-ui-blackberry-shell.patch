+void TFTView_320x240::updateZDeckMeshModePanel(bool activeCheck)
+{
+#if defined(ARCH_ESP32) && HAS_WIFI && defined(ZDECK_PUBLIC_BUILD)
+    if (!zDeckMeshModeLabel)
+        return;
+
+    const bool available = itsz::zdeck_dual_boot::meshCoreAvailable();
+    const uint16_t nearbyNodes = nodesOnline > 0 ? nodesOnline - 1 : 0;
+    time_t now = 0;
+    time(&now);
+    uint32_t secondsSinceRx = UINT32_MAX;
+    if (lastHeard > 0 && now >= lastHeard)
+        secondsSinceRx = static_cast<uint32_t>(now - lastHeard);
+    const uint32_t observationSeconds = (millis() - zDeckMeshObservationStartedMs) / 1000U;
+    const auto assessment = itsz::zdeck_mesh_mode::Policy::assess(available, nearbyNodes, secondsSinceRx, observationSeconds);
+
+    char rx[20];
+    if (secondsSinceRx == UINT32_MAX)
+        lv_snprintf(rx, sizeof(rx), "no RX yet");
+    else if (secondsSinceRx < 60)
+        lv_snprintf(rx, sizeof(rx), "RX %lus ago", static_cast<unsigned long>(secondsSinceRx));
+    else
+        lv_snprintf(rx, sizeof(rx), "RX %lum ago", static_cast<unsigned long>(secondsSinceRx / 60));
+
+    char summary[192];
+    lv_snprintf(summary, sizeof(summary), "%s %u%% | %u nearby | %s\n%s%s",
+                itsz::zdeck_mesh_mode::Policy::label(assessment.recommendation), assessment.confidence,
+                static_cast<unsigned int>(nearbyNodes), rx, activeCheck ? "Checked: " : "", assessment.reason);
+    lv_label_set_text(zDeckMeshModeLabel, summary);
+
+    if (zDeckMeshCoreButtonLabel) {
+        if (!available)
+            lv_label_set_text(zDeckMeshCoreButtonLabel, "NOT INSTALLED");
+        else if (zDeckMeshSwitchArmed && millis() - zDeckMeshSwitchArmedAtMs <= 10000U)
+            lv_label_set_text(zDeckMeshCoreButtonLabel, "PRESS AGAIN");
+        else {
+            zDeckMeshSwitchArmed = false;
+            lv_label_set_text(zDeckMeshCoreButtonLabel, "MESHCORE >");
+        }
+    }
+#else
+    (void)activeCheck;
+#endif
+}
