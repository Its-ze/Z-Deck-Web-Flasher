+void TFTView_320x240::setupZDeckMapPageBar(void)
+{
+    if (zDeckMapPageBar)
+        return;
+
+    zDeckMapPageBar = lv_obj_create(objects.raw_map_panel);
+    lv_obj_set_size(zDeckMapPageBar, lv_pct(100), zDeckMapPageBarHeight);
+    lv_obj_set_align(zDeckMapPageBar, LV_ALIGN_BOTTOM_MID);
+    lv_obj_set_pos(zDeckMapPageBar, 0, 0);
+    lv_obj_clear_flag(zDeckMapPageBar, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_style_bg_color(zDeckMapPageBar, LV_COLOR_HEX(0x071010), LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_bg_opa(zDeckMapPageBar, 250, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_border_width(zDeckMapPageBar, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_radius(zDeckMapPageBar, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_pad_all(zDeckMapPageBar, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
+
+    static const char *labels[] = {"MAP", "COMP", "RADAR", "ALERT"};
+    for (uint8_t i = 0; i < zDeckMapPageCount(); ++i) {
+        lv_obj_t *button = lv_btn_create(zDeckMapPageBar);
+        zDeckMapPageButtons[i] = button;
+        lv_obj_set_pos(button, 4 + i * 68, 2);
+        lv_obj_set_size(button, zDeckMapPageButtonWidth, 26);
+        lv_obj_add_flag(button, LV_OBJ_FLAG_CHECKABLE);
+        lv_obj_set_style_radius(button, 3, LV_PART_MAIN | LV_STATE_DEFAULT);
+        lv_obj_set_style_bg_color(button, LV_COLOR_HEX(0x202828), LV_PART_MAIN | LV_STATE_DEFAULT);
+        lv_obj_set_style_bg_color(button, colorBlueGreen, LV_PART_MAIN | LV_STATE_CHECKED);
+        lv_obj_set_style_border_color(button, colorGray, LV_PART_MAIN | LV_STATE_DEFAULT);
+        lv_obj_set_style_border_color(button, colorBlueGreen, LV_PART_MAIN | LV_STATE_CHECKED);
+        lv_obj_set_style_border_width(button, 1, LV_PART_MAIN | LV_STATE_DEFAULT);
+        lv_obj_set_style_shadow_width(button, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
+        lv_obj_add_event_cb(button, ui_event_zdeckMapPageButton, LV_EVENT_CLICKED,
+                            reinterpret_cast<void *>(static_cast<uintptr_t>(i)));
+
+        lv_obj_t *label = lv_label_create(button);
+        lv_label_set_text(label, labels[i]);
+        lv_obj_set_style_text_font(label, &lv_font_montserrat_10, LV_PART_MAIN | LV_STATE_DEFAULT);
+        lv_obj_set_style_text_color(label, colorLightGray, LV_PART_MAIN | LV_STATE_DEFAULT);
+        lv_obj_set_style_text_color(label, LV_COLOR_HEX(0x041010), LV_PART_MAIN | LV_STATE_CHECKED);
+        lv_obj_center(label);
+    }
+    updateZDeckMapPageBar();
+}
