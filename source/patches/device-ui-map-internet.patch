+    lv_obj_set_width(mapInternetStatusLabel, lv_pct(94));
+    lv_label_set_long_mode(mapInternetStatusLabel, LV_LABEL_LONG_DOT);
+
+    mapInternetButton = lv_btn_create(objects.map_osd_panel);
+    lv_obj_set_pos(mapInternetButton, 7, 140);
+    lv_obj_set_size(mapInternetButton, 116, 26);
+    lv_obj_set_style_bg_color(mapInternetButton, colorDarkGray, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_border_color(mapInternetButton, colorBlueGreen, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_border_width(mapInternetButton, 1, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_add_event_cb(mapInternetButton, ui_event_mapInternetButton, LV_EVENT_CLICKED, NULL);
+    mapInternetButtonLabel = lv_label_create(mapInternetButton);
+    lv_label_set_text(mapInternetButtonLabel, "WIFI");
+    lv_obj_center(mapInternetButtonLabel);
+
+    mapCacheButton = lv_btn_create(objects.map_osd_panel);
+    lv_obj_set_pos(mapCacheButton, 131, 140);
+    lv_obj_set_size(mapCacheButton, 116, 26);
+    lv_obj_set_style_bg_color(mapCacheButton, colorDarkGray, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_border_color(mapCacheButton, colorMesh, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_border_width(mapCacheButton, 1, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_add_event_cb(mapCacheButton, ui_event_mapCacheButton, LV_EVENT_CLICKED, NULL);
+    mapCacheButtonLabel = lv_label_create(mapCacheButton);
+    lv_label_set_text(mapCacheButtonLabel, "CACHE");
+    lv_obj_center(mapCacheButtonLabel);
+
+    mapCacheStatusLabel = lv_label_create(objects.map_osd_panel);
+    lv_obj_set_pos(mapCacheStatusLabel, 7, 172);
+    lv_obj_set_width(mapCacheStatusLabel, lv_pct(94));
+    lv_label_set_long_mode(mapCacheStatusLabel, LV_LABEL_LONG_DOT);
+
+    updateDynamicMapMenu();
+}
+
+void TFTView_320x240::updateDynamicMapMenu(void)
+{
+    if (!mapInternetStatusLabel)
+        return;
+
+    const bool hasNetwork = db.config.has_network;
+    const bool hasWifiStatus = db.connectionStatus.has_wifi && db.connectionStatus.wifi.has_status;
+    const bool wifiConnected = hasWifiStatus && db.connectionStatus.wifi.status.is_connected;
+    const bool hasWifiConfig = db.config.network.wifi_ssid[0] != '\0' && db.config.network.wifi_psk[0] != '\0';
+    const char *ssid = db.connectionStatus.wifi.ssid[0] ? db.connectionStatus.wifi.ssid : db.config.network.wifi_ssid;
+
+    char buf[112];
+    if (!hasNetwork) {
+        lv_label_set_text(mapInternetStatusLabel, "Internet: no WiFi radio");
+        lv_label_set_text(mapInternetButtonLabel, "NO WIFI");
+    } else if (!hasWifiConfig) {
+        lv_label_set_text(mapInternetStatusLabel, "Internet: WiFi not set");
+        lv_label_set_text(mapInternetButtonLabel, "SET WIFI");
+    } else if (wifiConnected) {
+        uint32_t ip = db.connectionStatus.wifi.status.ip_address;
+        lv_snprintf(buf, sizeof(buf), "Internet: %s %d.%d.%d.%d %ddBm", ssid, ip & 0xff, (ip & 0xff00) >> 8,
+                    (ip & 0xff0000) >> 16, (ip & 0xff000000) >> 24, db.connectionStatus.wifi.rssi);
+        lv_label_set_text(mapInternetStatusLabel, buf);
+        lv_label_set_text(mapInternetButtonLabel, "WIFI OFF");
+    } else if (db.config.network.wifi_enabled) {
+        lv_snprintf(buf, sizeof(buf), "Internet: %s connecting", ssid);
+        lv_label_set_text(mapInternetStatusLabel, buf);
+        lv_label_set_text(mapInternetButtonLabel, "EDIT WIFI");
+    } else {
+        lv_snprintf(buf, sizeof(buf), "Internet: %s saved, off", ssid);
+        lv_label_set_text(mapInternetStatusLabel, buf);
+        lv_label_set_text(mapInternetButtonLabel, "WIFI ON");
+    }
+
+    if (MapTileSettings::saveOK()) {
+        lv_snprintf(buf, sizeof(buf), "Cache: SD backfill on z%d %s", MapTileSettings::getZoomLevel(),
+                    MapTileSettings::getTileStyle()[0] ? MapTileSettings::getTileStyle() : "default");
+    } else if (cardDetected) {
+        lv_snprintf(buf, sizeof(buf), "Cache: local first, press remember");
+    } else {
+        lv_snprintf(buf, sizeof(buf), "Cache: SD card not ready");
+    }
+    lv_label_set_text(mapCacheStatusLabel, buf);
+    lv_label_set_text(mapCacheButtonLabel, "REMEMBER");
+}
+
+void TFTView_320x240::openWifiSettingsFromMap(void)
+{
+    lv_textarea_set_text(objects.settings_wifi_ssid_textarea, db.config.network.wifi_ssid);
+    lv_textarea_set_text(objects.settings_wifi_password_textarea, db.config.network.wifi_psk);
+    lv_obj_clear_flag(objects.settings_wifi_panel, LV_OBJ_FLAG_HIDDEN);
+    lv_group_focus_obj(objects.settings_wifi_ssid_textarea);
+    disablePanel(objects.map_panel);
+    settingsDisabledPanel = objects.map_panel;
+    activeSettings = eWifi;
+}
+
+void TFTView_320x240::rememberCurrentMapArea(void)
+{
+    if (!map)
+        return;
+
+    float lat, lon;
+    map->setHomePosition();
+    map->getHomeLocation(lat, lon);
+
+    db.uiConfig.has_map_data = true;
+    db.uiConfig.map_data.has_home = true;
+    db.uiConfig.map_data.home.latitude = lat * 1e7f;
+    db.uiConfig.map_data.home.longitude = lon * 1e7f;
+    db.uiConfig.map_data.home.zoom = MapTileSettings::getZoomLevel();
+    controller->storeUIConfig(db.uiConfig);
+
+    if (cardDetected)
+        MapTileSettings::setSaveOK(true);
+
+    map->forceRedraw();
+    updateDynamicMapMenu();
+    messageAlert(_("Map area remembered"), true);
+}
+
+void TFTView_320x240::ui_event_mapInternetButton(lv_event_t *e)
+{
+    lv_event_code_t event_code = lv_event_get_code(e);
+    if (event_code != LV_EVENT_CLICKED || THIS->activeSettings != eNone)
+        return;
+
+    if (!THIS->db.config.has_network) {
+        THIS->messageAlert(_("No WiFi radio"), true);
+        return;
+    }
+
+    if (THIS->db.config.network.wifi_ssid[0] == '\0' || THIS->db.config.network.wifi_psk[0] == '\0') {
+        THIS->openWifiSettingsFromMap();
+        return;
+    }
+
+    const bool wifiConnected = THIS->db.connectionStatus.has_wifi && THIS->db.connectionStatus.wifi.has_status &&
+                               THIS->db.connectionStatus.wifi.status.is_connected;
+    if (THIS->db.config.network.wifi_enabled && !wifiConnected) {
+        THIS->openWifiSettingsFromMap();
+        return;
+    }
+
+    meshtastic_Config_NetworkConfig &network = THIS->db.config.network;
+    network.wifi_enabled = !network.wifi_enabled;
+    THIS->controller->sendConfig(meshtastic_Config_NetworkConfig{network}, THIS->ownNode);
+    THIS->updateDynamicMapMenu();
+    THIS->notifyReboot(true);
+}
+
+void TFTView_320x240::ui_event_mapCacheButton(lv_event_t *e)
+{
+    lv_event_code_t event_code = lv_event_get_code(e);
+    if (event_code == LV_EVENT_CLICKED && THIS->activeSettings == eNone)
+        THIS->rememberCurrentMapArea();
+}
