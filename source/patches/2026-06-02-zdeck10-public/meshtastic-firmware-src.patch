+        project_dir / "itsz" / "device-ui-brand-version.patch",
+        project_dir / "itsz" / "device-ui-zdeck-public-stack.patch",
+        project_dir / "itsz" / "device-ui-sd-tools.patch",
+    ]
+    for patch_path in patch_paths:
+        if not patch_path.exists():
+            raise RuntimeError(f"ITSZ device-ui map patch is missing: {patch_path}")
+
+    lib_root = Path(lib_root)
+    lib_candidates = [
+        lib_root,
+        lib_root.parent / pioenv / lib_root.name,
+    ]
+    lib_root = next((candidate for candidate in lib_candidates if candidate.exists()), None)
+    if lib_root is None:
+        checked = ", ".join(str(candidate) for candidate in lib_candidates)
+        raise RuntimeError(f"meshtastic-device-ui library path is missing; checked: {checked}")
+
+    lib_dir_arg = lib_root.relative_to(project_dir).as_posix()
+    apply_cmd = ["git", "apply", "--directory", lib_dir_arg]
+
+    def patch_marker_present(patch_name):
