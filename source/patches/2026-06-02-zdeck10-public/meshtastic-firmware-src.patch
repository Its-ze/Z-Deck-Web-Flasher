+                ("source/graphics/TFT/TFTView_320x240.cpp", "LoRa listening\\nno mesh packets"),
+            ],
+            "device-ui-delivery-status.patch": [
+                ("source/graphics/TFT/TFTView_320x240.cpp", "RX CH %u H%d"),
+                ("source/graphics/TFT/TFTView_320x240.cpp", "BCAST TTL%u NO ACK"),
+            ],
+            "device-ui-brand-version.patch": [
+                ("source/graphics/TFT/TFTView_320x240.cpp", "itszBootFirmwareLabel"),
+            ],
+            "device-ui-zdeck-public-stack.patch": [
+                ("source/graphics/TFT/TFTView_320x240.cpp", "setupZDeckHealthTool"),
+                ("include/graphics/view/TFT/TFTView_320x240.h", "zDeckHealthPanel"),
+            ],
+            "device-ui-sd-tools.patch": [
+                ("source/graphics/TFT/TFTView_320x240.cpp", "setupZDeckSDTool"),
+                ("source/graphics/common/SdCard.cpp", "zDeckUsbSdMassStorageRefresh"),
+                ("include/graphics/view/TFT/TFTView_320x240.h", "zDeckSdResetArmed"),
+            ],
+        }.get(patch_name, [])
+
+        for rel_path, marker in markers:
+            target = lib_root / rel_path
+            if not target.exists() or marker not in target.read_text(errors="ignore"):
+                return False
+        return bool(markers)
+
+    for patch_path in patch_paths:
+        reverse_check = subprocess.run(
+            [*apply_cmd, "--reverse", "--check", str(patch_path)],
+            cwd=str(project_dir),
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        if reverse_check.returncode == 0:
