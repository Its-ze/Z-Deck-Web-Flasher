+const char *itszOutgoingStatusText(LogMessage::MsgStatus status, bool pendingRequest)
+{
+    switch (status) {
+    case LogMessage::eHeard:
+        return "heard by mesh";
+    case LogMessage::eNoResponse:
+        return "no response";
+    case LogMessage::eAcked:
+        return "acknowledged";
+    case LogMessage::eFailed:
+        return "failed";
+    case LogMessage::eDeleted:
+        return "deleted";
+    default:
+        return pendingRequest ? "queued" : "sent";
+    }
+}
+
+lv_color_t itszOutgoingStatusColor(LogMessage::MsgStatus status)
+{
+    switch (status) {
+    case LogMessage::eHeard:
+        return colorYellow;
+    case LogMessage::eAcked:
+        return colorBlueGreen;
+    case LogMessage::eNoResponse:
+    case LogMessage::eFailed:
+        return colorRed;
+    default:
+        return colorMesh;
+    }
+}
+
+void itszSetOutgoingStatus(lv_obj_t *panel, const char *text, lv_color_t color)
+{
+    if (!panel || !panel->spec_attr || panel->spec_attr->child_cnt < 2)
+        return;
+
+    lv_obj_t *statusLabel = panel->spec_attr->children[1];
+    lv_label_set_text(statusLabel, text);
+    lv_obj_set_style_text_color(statusLabel, color, LV_PART_MAIN | LV_STATE_DEFAULT);
+}
