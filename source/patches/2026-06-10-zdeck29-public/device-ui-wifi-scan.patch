+void TFTView_320x240::resetWifiScanControls(void)
+{
+    setupWifiScanControls();
+    wifiScanNetworkCount = 0;
+    memset(wifiScanSsids, 0, sizeof(wifiScanSsids));
+    memset(wifiScanOpen, 0, sizeof(wifiScanOpen));
+    memset(wifiScanOptions, 0, sizeof(wifiScanOptions));
+
+    if (wifiNetworkDropdown) {
+        lv_dropdown_set_options(wifiNetworkDropdown, "Press Scan");
+        lv_dropdown_set_selected(wifiNetworkDropdown, 0);
+    }
+    if (wifiScanButtonLabel)
+        lv_label_set_text(wifiScanButtonLabel, "SCAN");
+    if (wifiScanButton)
+        lv_obj_clear_state(wifiScanButton, LV_STATE_DISABLED);
+
+    const char *ssid = lv_textarea_get_text(objects.settings_wifi_ssid_textarea);
+    char buf[96];
+    if (ssid && ssid[0]) {
+        char clean[33];
+        zDeckCleanWifiSsid(clean, sizeof(clean), ssid);
+        lv_snprintf(buf, sizeof(buf), "Saved: %s. Scan to change.", clean);
+        updateWifiScanStatus(buf);
+    } else {
+        updateWifiScanStatus("Scan nearby WiFi, or type SSID.");
+    }
+}
