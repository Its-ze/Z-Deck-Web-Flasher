+bool TFTView_320x240::centerMapBestEffort(bool showAlert)
+{
+    if (!map)
+        return false;
+
+    const bool gpsReady = hasPosition && myLatitude != 0 && myLongitude != 0;
+    if (gpsReady) {
+        if (!db.uiConfig.map_data.has_home && MapTileSettings::getZoomLevel() <= 3)
+            map->setZoom(13);
+        map->setGpsPosition(myLatitude * 1e-7, myLongitude * 1e-7);
+        map->moveCurrent();
+        zDeckMapAutoCenterPending = false;
+        updateLocationMap(map->getObjectsOnMap());
+        updateDynamicMapMenu();
+        if (showAlert)
+            messageAlert(_("Centered on GPS"), true);
+        return true;
+    }
+
+    if (db.uiConfig.map_data.has_home) {
+        map->setZoom(db.uiConfig.map_data.home.zoom);
+        map->setHomeLocation(db.uiConfig.map_data.home.latitude * 1e-7, db.uiConfig.map_data.home.longitude * 1e-7);
+        zDeckMapAutoCenterPending = false;
+        updateLocationMap(map->getObjectsOnMap());
+        updateDynamicMapMenu();
+        if (showAlert)
+            messageAlert(_("Centered saved map"), true);
+        return true;
+    }
+
+    std::vector<int32_t> sortedLat;
+    std::vector<int32_t> sortedLon;
+    sortedLat.reserve(nodeObjects.size());
+    sortedLon.reserve(nodeObjects.size());
+    for (auto it : nodeObjects) {
+        auto nodeIt = nodes.find(it.first);
+        if (nodeIt == nodes.end() || !nodeIt->second)
+            continue;
+        lv_obj_t *p = nodeIt->second;
+        int32_t lat = (long)p->LV_OBJ_IDX(node_pos1_idx)->user_data;
+        int32_t lon = (long)p->LV_OBJ_IDX(node_pos2_idx)->user_data;
+        if (lat && lon) {
+            sortedLat.push_back(lat);
+            sortedLon.push_back(lon);
+        }
+    }
+    if (!sortedLat.empty()) {
+        std::sort(sortedLat.begin(), sortedLat.end());
+        std::sort(sortedLon.begin(), sortedLon.end());
+        int64_t latcenter = 0;
+        int64_t loncenter = 0;
+        int32_t count = 0;
+        size_t trim = sortedLat.size() / 5;
+        size_t end = sortedLat.size() - trim;
+        if (end <= trim) {
+            trim = 0;
+            end = sortedLat.size();
+        }
+        for (size_t i = trim; i < end; i++) {
+            latcenter += sortedLat[i];
+            loncenter += sortedLon[i];
+            count++;
+        }
+        latcenter /= count;
+        loncenter /= count;
+
+        lv_obj_update_layout(objects.raw_map_panel);
+        const float latRad = latcenter * 1e-7f * float(M_PI) / 180.0f;
+        const float latKm = std::max(0.05f, float(sortedLat.back() - sortedLat.front()) * 1e-7f * 111.32f);
+        const float latCos = std::max(0.1f, float(fabs(cos(latRad))));
+        const float lonKm = std::max(0.05f, float(sortedLon.back() - sortedLon.front()) * 1e-7f * 111.32f * latCos);
+        const float distanceKm = std::max(latKm, lonKm);
+        const float panelPixels = std::max(64, lv_obj_get_width(objects.raw_map_panel) - 64);
+        const float targetMpp = distanceKm * 1000.0f / panelPixels;
+        uint8_t zoom = 20;
+        while (zoom > 1 && (156543.034f * latCos / float(1UL << zoom)) < targetMpp)
+            zoom--;
+
+        map->setHomeLocation(latcenter * 1e-7, loncenter * 1e-7);
+        map->setZoom(zoom);
+        zDeckMapAutoCenterPending = false;
+        updateLocationMap(map->getObjectsOnMap());
+        updateDynamicMapMenu();
+        if (showAlert)
+            messageAlert(_("Centered on nodes"), true);
+        return true;
+    }
+
+    zDeckMapAutoCenterPending = true;
+    updateDynamicMapMenu();
+    if (showAlert)
+        messageAlert(_("Waiting for GPS or node positions"), true);
+    return false;
+}
