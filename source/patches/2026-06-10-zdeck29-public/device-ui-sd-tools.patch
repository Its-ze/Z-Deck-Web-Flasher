+namespace
+{
+uint16_t zDeckLe16(const uint8_t *p)
+{
+    return (uint16_t)p[0] | ((uint16_t)p[1] << 8);
+}
+
+uint32_t zDeckLe32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+bool zDeckLooksFatBootSector(const uint8_t *sector)
+{
+    return sector[510] == 0x55 && sector[511] == 0xAA && zDeckLe16(sector + 11) == 512 && sector[13] != 0 &&
+           zDeckLe16(sector + 14) != 0 && sector[16] != 0;
+}
+
+void zDeckMakeFatLabel(const char *label, uint8_t out[11])
+{
+    memset(out, ' ', 11);
+    if (!label)
+        return;
+
+    size_t pos = 0;
+    for (size_t i = 0; label[i] && pos < 11; i++) {
+        char c = label[i];
+        if (c >= 'a' && c <= 'z')
+            c = (char)(c - 'a' + 'A');
+        if (c == '.' || c == '/' || c == '\\' || c == ':' || c == '*' || c == '?' || c == '"' || c == '<' || c == '>' ||
+            c == '|')
+            continue;
+        out[pos++] = (uint8_t)c;
+    }
+}
+
+bool zDeckWriteRootVolumeLabel(uint32_t bootSector, const uint8_t boot[512], const uint8_t label[11])
+{
+    const uint16_t bytesPerSector = zDeckLe16(boot + 11);
+    const uint8_t sectorsPerCluster = boot[13];
+    const uint16_t reservedSectors = zDeckLe16(boot + 14);
+    const uint8_t fatCount = boot[16];
+    const uint16_t rootEntryCount = zDeckLe16(boot + 17);
+    const uint16_t fat16Sectors = zDeckLe16(boot + 22);
+    const uint32_t fatSectors = fat16Sectors ? fat16Sectors : zDeckLe32(boot + 36);
+
+    if (bytesPerSector != 512 || sectorsPerCluster == 0 || reservedSectors == 0 || fatCount == 0 || fatSectors == 0)
+        return false;
+
+    const uint32_t rootDirSectors = ((uint32_t)rootEntryCount * 32U + bytesPerSector - 1U) / bytesPerSector;
+    uint32_t rootSector = bootSector + reservedSectors + (uint32_t)fatCount * fatSectors;
+    uint32_t sectorsToScan = rootDirSectors;
+
+    if (fat16Sectors == 0 && rootEntryCount == 0) {
+        const uint32_t rootCluster = zDeckLe32(boot + 44);
+        if (rootCluster < 2)
+            return false;
+        const uint32_t firstDataSector = rootSector + rootDirSectors;
+        rootSector = firstDataSector + (rootCluster - 2U) * sectorsPerCluster;
+        sectorsToScan = sectorsPerCluster;
+    }
+
+    uint8_t sector[512];
+    for (uint32_t i = 0; i < sectorsToScan; i++) {
+        if (!SDFs.card()->readSector(rootSector + i, sector))
+            return false;
+
+        for (size_t entry = 0; entry < 512; entry += 32) {
+            const uint8_t first = sector[entry];
+            const uint8_t attr = sector[entry + 11];
+            if (first == 0x00 || first == 0xE5 || attr == 0x08) {
+                memset(sector + entry, 0, 32);
+                memcpy(sector + entry, label, 11);
+                sector[entry + 11] = 0x08;
+                return SDFs.card()->writeSector(rootSector + i, sector);
+            }
+        }
+    }
+
+    return false;
+}
+} // namespace
+
+bool zDeckWriteSdVolumeLabel(const char *label)
+{
+    if (!SDFs.card())
+        return false;
+
+    concurrency::LockGuard g(spiLock);
+    uint8_t sector[512];
+    if (!SDFs.card()->readSector(0, sector))
+        return false;
+
+    uint32_t bootSector = 0;
+    if (!zDeckLooksFatBootSector(sector)) {
+        if (sector[510] != 0x55 || sector[511] != 0xAA || sector[0x1BE + 4] == 0)
+            return false;
+        bootSector = zDeckLe32(sector + 0x1BE + 8);
+        if (bootSector == 0 || !SDFs.card()->readSector(bootSector, sector))
+            return false;
+    }
+
+    if (!zDeckLooksFatBootSector(sector))
+        return false;
+
+    uint8_t fatLabel[11];
+    zDeckMakeFatLabel(label, fatLabel);
+
+    const uint16_t fat16Sectors = zDeckLe16(sector + 22);
+    const uint16_t rootEntryCount = zDeckLe16(sector + 17);
+    const size_t labelOffset = (fat16Sectors == 0 && rootEntryCount == 0) ? 71 : 43;
+    memcpy(sector + labelOffset, fatLabel, 11);
+
+    const bool bootOk = SDFs.card()->writeSector(bootSector, sector);
+    const bool rootOk = zDeckWriteRootVolumeLabel(bootSector, sector, fatLabel);
+    SDFs.card()->syncDevice();
+    return bootOk && rootOk;
+}
+#else
+bool zDeckWriteSdVolumeLabel(const char *)
+{
+    return false;
+}
+#endif
