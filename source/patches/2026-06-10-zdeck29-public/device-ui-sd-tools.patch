+bool TFTView_320x240::prepareZDeckSDCard(void)
+{
+    updateZDeckSDPanel("Formatting SD card...");
+    updateSDCard();
+
+    if (!sdCard || sdCard->cardType() == ISdCard::eNone) {
+        updateZDeckSDPanel("No SD card found.");
+        return false;
+    }
+
+    if (!sdCard->format()) {
+        updateZDeckSDPanel("SD format failed.");
+        return false;
+    }
+
+    updateSDCard();
+    if (!cardDetected) {
+        updateZDeckSDPanel("Formatted, but remount failed.");
+        return false;
+    }
+
+    bool labelSet = false;
+#if defined(HAS_SDCARD)
+    labelSet = zDeckWriteSdVolumeLabel("TDECKSDCARD");
+
+    SDFs.mkdir("/zdeck");
+    SDFs.mkdir("/zdeck/maps");
+    SDFs.mkdir("/zdeck/maps/cache");
+    SDFs.mkdir("/zdeck/history");
+    SDFs.mkdir("/zdeck/ringtones");
+    SDFs.mkdir("/zdeck/logs");
+    SDFs.mkdir("/zdeck/exports");
+    SDFs.mkdir("/maps");
+    SDFs.mkdir("/maps/zdeck-mesh");
+    SDFs.mkdir("/maps/zdeck-compass");
+    SDFs.mkdir("/maps/zdeck-radar");
+    SDFs.mkdir("/maps/zdeck-alert");
+    SDFs.mkdir("/itsz");
+    SDFs.mkdir("/itsz/history");
+
+#if defined(HAS_SD_MMC) || defined(ARCH_PORTDUINO)
+    File readme = SDFs.open("/zdeck/README.TXT", FILE_WRITE);
+    if (readme) {
+        readme.print("T-Deck SD Card for Z-Deck firmware.\r\nMaps, message history, ringtones, logs, and exports live here.\r\n");
+        readme.print("Put preloaded map tiles under /maps/zdeck-mesh/<z>/<x>/<y>.png.\r\n");
+        readme.close();
+    }
+#else
+    FsFile readme = SDFs.open("/zdeck/README.TXT", O_RDWR | O_CREAT | O_TRUNC);
+    if (readme) {
+        readme.print("T-Deck SD Card for Z-Deck firmware.\r\nMaps, message history, ringtones, logs, and exports live here.\r\n");
+        readme.print("Put preloaded map tiles under /maps/zdeck-mesh/<z>/<x>/<y>.png.\r\n");
+        readme.close();
+    }
+#endif
+#endif
+
+    zDeckUsbSdMassStorageRefresh();
+    updateZDeckHealthPanel();
+    updateZDeckSDPanel(labelSet ? "SD card prepared. Label set." : "SD card prepared. Label not set.");
+    return true;
+}
