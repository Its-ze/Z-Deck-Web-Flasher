+#if defined(ZDECK_USB_SD_MSC_ENABLED) && ZDECK_USB_SD_MSC_ENABLED == 1 && defined(HAS_SDCARD) && !defined(HAS_SD_MMC) && !defined(ARCH_PORTDUINO) &&                    \
+    defined(ARDUINO_ARCH_ESP32) && CONFIG_TINYUSB_MSC_ENABLED
+#include "USBMSC.h"
