+void TFTView_320x240::updateZDeckSDPanel(const char *status)
+{
+    if (!zDeckSdLabel)
+        return;
+
+    const char *sd = cardDetected ? "ready" : "missing";
+    char buf[260];
+    if (status && status[0]) {
+        lv_snprintf(buf, sizeof(buf), "%s\nSD: %s\n%s", status, sd, zDeckUsbSdMassStorageStatus());
+    } else if (zDeckSdResetArmed) {
+        lv_snprintf(buf, sizeof(buf),
+                    "WARNING: next press formats the SD card and rebuilds Z-Deck folders.\nBack up files first.\n%s",
+                    zDeckUsbSdMassStorageStatus());
+    } else {
+        lv_snprintf(buf, sizeof(buf), "SD prep: TDECKSDCARD\nUSB drive: disabled in public build\n%s",
+                    zDeckUsbSdMassStorageStatus());
+    }
+    lv_label_set_text(zDeckSdLabel, buf);
+}
