+void TFTView_320x240::setupZDeckHealthTool(void)
+{
+    if (zDeckHealthButton || !objects.tab_page_tools)
+        return;
+
+    zDeckHealthButton = lv_btn_create(objects.tab_page_tools);
+    lv_obj_set_size(zDeckHealthButton, LV_PCT(95), 30);
+    add_style_settings_button_style(zDeckHealthButton);
+    lv_obj_set_style_align(zDeckHealthButton, LV_ALIGN_TOP_MID, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_shadow_width(zDeckHealthButton, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_bg_color(zDeckHealthButton, colorDarkGray, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_border_color(zDeckHealthButton, colorBlueGreen, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_border_width(zDeckHealthButton, 1, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_add_event_cb(zDeckHealthButton, ui_event_zdeckHealthButton, LV_EVENT_CLICKED, NULL);
+
+    zDeckHealthButtonLabel = lv_label_create(zDeckHealthButton);
+    lv_obj_set_size(zDeckHealthButtonLabel, LV_PCT(100), LV_SIZE_CONTENT);
+    lv_label_set_long_mode(zDeckHealthButtonLabel, LV_LABEL_LONG_DOT);
+    lv_label_set_text(zDeckHealthButtonLabel, "Z-Deck Health");
+    lv_obj_set_style_align(zDeckHealthButtonLabel, LV_ALIGN_CENTER, LV_PART_MAIN | LV_STATE_DEFAULT);
+
+    zDeckHealthPanel = lv_obj_create(objects.tab_page_tools);
+    lv_obj_set_size(zDeckHealthPanel, LV_PCT(95), 114);
+    lv_obj_clear_flag(zDeckHealthPanel, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_style_bg_color(zDeckHealthPanel, colorDarkGray, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_bg_opa(zDeckHealthPanel, 190, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_border_color(zDeckHealthPanel, colorBlueGreen, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_border_width(zDeckHealthPanel, 1, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_radius(zDeckHealthPanel, 4, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_pad_all(zDeckHealthPanel, 6, LV_PART_MAIN | LV_STATE_DEFAULT);
+
+    zDeckHealthLabel = lv_label_create(zDeckHealthPanel);
+    lv_obj_set_width(zDeckHealthLabel, LV_PCT(100));
+    lv_label_set_long_mode(zDeckHealthLabel, LV_LABEL_LONG_WRAP);
+    lv_obj_set_style_text_font(zDeckHealthLabel, &lv_font_montserrat_10, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_text_color(zDeckHealthLabel, colorLightGray, LV_PART_MAIN | LV_STATE_DEFAULT);
+
+    updateZDeckHealthPanel();
+}
+
+void TFTView_320x240::updateZDeckHealthPanel(void)
+{
+    if (!zDeckHealthLabel)
+        return;
+
+    uint8_t enabledChannels = 0;
+    const char *primary = "LongFast";
+    for (int i = 0; i < c_max_channels; i++) {
+        meshtastic_Channel &ch = db.channel[i];
+        if (ch.has_settings && ch.role != meshtastic_Channel_Role_DISABLED) {
+            enabledChannels++;
+            if (ch.role == meshtastic_Channel_Role_PRIMARY) {
+                primary = strlen(ch.settings.name) ? ch.settings.name : LoRaPresets::modemPresetToString(db.config.lora.modem_preset);
+            }
+        }
+    }
+
+    const char *gps =
+        db.config.position.gps_mode == meshtastic_Config_PositionConfig_GpsMode_NOT_PRESENT
+            ? "not present"
+            : db.config.position.gps_mode == meshtastic_Config_PositionConfig_GpsMode_ENABLED ? "enabled" : "off";
+    const char *wifi = db.config.has_network && db.config.network.wifi_enabled ? "on" : "off";
+    const char *sd = cardDetected ? "ready" : "missing";
+    const bool longFastDefault = strcmp(primary, "LongFast") == 0 && enabledChannels <= 1;
+
+    char buf[300];
+    lv_snprintf(buf, sizeof(buf),
+                "Z-Deck %s | FW %s\n"
+                "Public profile: %s\n"
+                "Primary: %s | channels %u\n"
+                "GPS: %s RX%u/TX%u sats %u\n"
+                "SD: %s | WiFi %s | nodes %u\n"
+                "Add channels: Settings > Channel",
+                ZDECK_PACK_VERSION, firmware_version, longFastDefault ? "LongFast only" : "custom channels", primary,
+                (unsigned int)enabledChannels, gps, (unsigned int)db.config.position.rx_gpio,
+                (unsigned int)db.config.position.tx_gpio, (unsigned int)gpsSatellites, sd, wifi, (unsigned int)nodeCount);
+    lv_label_set_text(zDeckHealthLabel, buf);
+}
+
+void TFTView_320x240::ui_event_zdeckHealthButton(lv_event_t *e)
+{
+    lv_event_code_t event_code = lv_event_get_code(e);
+    if (event_code != LV_EVENT_CLICKED || THIS->activeSettings != eNone)
+        return;
+
+    THIS->updateZDeckHealthPanel();
+    THIS->messageAlert("Z-Deck health refreshed", true);
+}
