+void TFTView_320x240::ui_event_zdeckBluetoothToggleButton(lv_event_t *e)
+{
+    if (lv_event_get_code(e) != LV_EVENT_CLICKED || !THIS->ownNode)
+        return;
+    meshtastic_Config_BluetoothConfig bluetooth = THIS->db.config.bluetooth;
+    bluetooth.enabled = !bluetooth.enabled;
+    THIS->controller->sendConfig(meshtastic_Config_BluetoothConfig{bluetooth}, THIS->ownNode);
+    THIS->db.config.bluetooth = bluetooth;
+    THIS->updateZDeckBluetooth();
+}
+
+void TFTView_320x240::ui_event_zdeckBluetoothPairButton(lv_event_t *e)
+{
+    if (lv_event_get_code(e) != LV_EVENT_CLICKED || !THIS->ownNode)
+        return;
+    meshtastic_Config_BluetoothConfig bluetooth = THIS->db.config.bluetooth;
+    bluetooth.enabled = true;
+    bluetooth.mode = meshtastic_Config_BluetoothConfig_PairingMode_RANDOM_PIN;
+    THIS->controller->sendConfig(meshtastic_Config_BluetoothConfig{bluetooth}, THIS->ownNode);
+    THIS->db.config.bluetooth = bluetooth;
+    THIS->updateZDeckBluetooth();
+}
