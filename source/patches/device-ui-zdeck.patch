+void TFTView_320x240::setZDeckSidebarRight(bool enabled, bool persist)
+{
+    zDeckSidebarRight = enabled;
+    if (persist)
+        zDeckSaveSidebarRightPreference(enabled);
+    applyZDeckSidebarPlacement();
+}
