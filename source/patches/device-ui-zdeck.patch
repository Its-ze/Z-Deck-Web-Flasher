+{
+    if (!obj)
+        return;
+    lv_obj_set_x(obj, sidebarRight ? 0 : zDeckSidebarContentLeftX);
+    lv_obj_set_width(obj, zDeckSidebarContentWidth);
+}
+
+const char *itszOutgoingStatusText(LogMessage::MsgStatus status, bool pendingRequest)
+{
+    switch (status) {
+    case LogMessage::eHeard:
+        return "TX HEARD";
+    case LogMessage::eNoResponse:
+        return "TX NO RESP";
+    case LogMessage::eAcked:
+        return "TX ACK";
+    case LogMessage::eFailed:
+        return "TX FAIL";
+    case LogMessage::eDeleted:
+        return "DELETED";
+    default:
+        return pendingRequest ? "WAIT ACK" : "TX SENT";
+    }
+}
+
+lv_color_t itszOutgoingStatusColor(LogMessage::MsgStatus status)
+{
+    switch (status) {
+    case LogMessage::eHeard:
+        return colorYellow;
+    case LogMessage::eAcked:
+        return colorBlueGreen;
+    case LogMessage::eNoResponse:
+    case LogMessage::eFailed:
+        return colorRed;
+    default:
+        return colorMesh;
+    }
+}
+
+void itszSetOutgoingStatus(lv_obj_t *panel, const char *text, lv_color_t color)
+{
+    if (!panel || !panel->spec_attr || panel->spec_attr->child_cnt < 2)
+        return;
+
+    lv_obj_t *statusLabel = panel->spec_attr->children[1];
+    lv_label_set_text(statusLabel, text);
+    lv_obj_set_style_text_color(statusLabel, color, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_border_color(statusLabel, color, LV_PART_MAIN | LV_STATE_DEFAULT);
+}
+
+void zDeckCleanWifiSsid(char *out, size_t outSize, const char *ssid)
+{
+    if (!out || outSize == 0)
+        return;
+
+    size_t pos = 0;
+    if (ssid) {
+        for (size_t i = 0; ssid[i] != '\0' && pos + 1 < outSize; ++i) {
+            char c = ssid[i];
+            out[pos++] = (c == '\n' || c == '\r' || c == '\t') ? ' ' : c;
+        }
+    }
+    out[pos] = '\0';
+}
+
+void zDeckAppendWifiOption(char *options, size_t optionsSize, const char *line)
+{
+    if (!options || optionsSize == 0 || !line)
+        return;
+
+    size_t used = strlen(options);
+    if (used > 0 && used + 1 < optionsSize) {
+        options[used++] = '\n';
+        options[used] = '\0';
+    }
+
+    if (used + 1 < optionsSize)
+        strncat(options, line, optionsSize - used - 1);
+}
+
+int8_t itszPacketHops(const meshtastic_MeshPacket &p)
+{
+    if (p.hop_start > 0 && p.hop_limit <= p.hop_start)
+        return p.hop_start - p.hop_limit;
+    return -1;
+}
