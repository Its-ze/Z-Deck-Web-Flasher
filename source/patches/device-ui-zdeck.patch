+
+void TFTView_320x240::applyZDeckSidebarPlacement(void)
+{
+    if (objects.button_panel) {
+        lv_obj_set_x(objects.button_panel, zDeckSidebarRight ? zDeckSidebarRightX : 0);
+        lv_obj_set_width(objects.button_panel, zDeckSidebarWidth);
+        lv_obj_move_foreground(objects.button_panel);
+    }
+
+    lv_obj_t *contentPanels[] = {
+        objects.home_panel,       objects.nodes_panel,          objects.node_options_panel,  objects.groups_panel,
+        objects.messages_panel,   objects.chats_panel,          objects.map_panel,           objects.controller_panel,
+        ui_AdvancedSettingsPanel, objects.mesh_detector_panel,  objects.signal_scanner_panel, objects.trace_route_panel,
+        objects.details_panel,    objects.tools_statistics_panel, objects.tools_packet_log_panel,
+        objects.initial_setup_panel,
+    };
+    for (lv_obj_t *panel : contentPanels)
+        zDeckPlaceMainContent(panel, zDeckSidebarRight);
+
+    lv_obj_t *topPanels[] = {
+        objects.top_panel,          objects.top_nodes_panel,        objects.top_node_options_panel, objects.top_groups_panel,
+        objects.top_group_chat_panel, objects.top_chats_panel,      objects.top_messages_panel,     objects.top_map_panel,
+        objects.top_settings_panel, objects.top_advanced_settings_panel, objects.top_mesh_detector_panel,
+        objects.top_signal_scanner_panel, objects.top_trace_route_panel, objects.top_statistics_panel, objects.top_packet_log_panel,
+        objects.top_node_search_panel, objects.top_neighbors_panel, objects.top_lora_tx_panel, objects.top_setup_panel,
+    };
+    for (lv_obj_t *panel : topPanels)
+        zDeckPlaceMainContent(panel, zDeckSidebarRight);
+
+    if (objects.battery_panel) {
+        lv_obj_set_x(objects.battery_panel, zDeckSidebarRight ? zDeckBatterySafeRightX : (320 - zDeckBatteryPanelWidth));
+        lv_obj_set_y(objects.battery_panel, 0);
+        lv_obj_set_width(objects.battery_panel, zDeckBatteryPanelWidth);
+        lv_obj_move_foreground(objects.battery_panel);
+    }
+    if (objects.battery_image)
+        lv_obj_set_x(objects.battery_image, -2);
+    if (objects.battery_percentage_label) {
+        lv_obj_set_width(objects.battery_percentage_label, 36);
+        lv_label_set_long_mode(objects.battery_percentage_label, LV_LABEL_LONG_CLIP);
+        lv_obj_set_x(objects.battery_percentage_label, -28);
+        lv_obj_set_style_text_align(objects.battery_percentage_label, LV_TEXT_ALIGN_RIGHT, LV_PART_MAIN | LV_STATE_DEFAULT);
+    }
+    updateZDeckSidebarLabel();
+    lv_obj_invalidate(objects.main_screen);
+}
