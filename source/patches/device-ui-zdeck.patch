+void TFTView_320x240::setupScreenCorrectionTool(void)
+{
+    if (screenCorrectionButton || !objects.tab_page_tools)
+        return;
+
+    screenCorrectionButton = lv_btn_create(objects.tab_page_tools);
+    lv_obj_set_pos(screenCorrectionButton, 0, 0);
+    lv_obj_set_size(screenCorrectionButton, LV_PCT(95), 30);
+    add_style_settings_button_style(screenCorrectionButton);
+    lv_obj_set_style_align(screenCorrectionButton, LV_ALIGN_TOP_MID, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_shadow_width(screenCorrectionButton, 0, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_bg_color(screenCorrectionButton, lv_color_hex(0xff4db270), LV_PART_MAIN | LV_STATE_PRESSED);
+    lv_obj_set_style_text_color(screenCorrectionButton, lv_color_hex(0xff015114), LV_PART_MAIN | LV_STATE_PRESSED);
