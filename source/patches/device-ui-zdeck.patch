+    const char *sd = cardDetected ? "ready" : "missing";
+    char sdLine[120];
+    itsz::zdeck_state::formatLine(itsz::zdeck_state::Subsystem::Sd, sdLine, sizeof(sdLine));
+    char buf[260];
+    if (status && status[0]) {
+        lv_snprintf(buf, sizeof(buf), "%s\nSD: %s\n%s", status, sd, sdLine);
+    } else if (zDeckSdResetArmed) {
+        lv_snprintf(buf, sizeof(buf),
+                    "WARNING: next press formats the SD card and rebuilds Z-Deck folders.\nBack up files first.\n%s", sdLine);
+    } else {
+        lv_snprintf(buf, sizeof(buf), "USB: TDECK SD CARD\nLabel after reset: TDECKSDCARD\n%s", sdLine);
+    }
+    lv_label_set_text(zDeckSdLabel, buf);
+}
+
+bool TFTView_320x240::prepareZDeckSDCard(void)
+{
+    itsz::zdeck_state::setSd(itsz::zdeck_state::State::Busy, "Preparing SD card", 0);
+    updateZDeckSDPanel("Formatting SD card...");
+    updateSDCard();
+
+    if (!sdCard || sdCard->cardType() == ISdCard::eNone) {
+        itsz::zdeck_state::setSd(itsz::zdeck_state::State::Error, "No SD card found");
+        updateZDeckSDPanel("No SD card found.");
+        return false;
+    }
+
+    if (!sdCard->format()) {
+        itsz::zdeck_state::setSd(itsz::zdeck_state::State::Error, "SD format failed");
+        updateZDeckSDPanel("SD format failed.");
+        return false;
+    }
+
+    updateSDCard();
+    if (!cardDetected) {
+        itsz::zdeck_state::setSd(itsz::zdeck_state::State::Error, "Formatted, remount failed");
+        updateZDeckSDPanel("Formatted, but remount failed.");
+        return false;
+    }
+
+    bool labelSet = false;
+#if defined(HAS_SDCARD)
+    labelSet = zDeckWriteSdVolumeLabel("TDECKSDCARD");
+
+    SDFs.mkdir("/zdeck");
+    SDFs.mkdir("/zdeck/maps");
+    SDFs.mkdir("/zdeck/maps/cache");
+    SDFs.mkdir("/zdeck/history");
+    SDFs.mkdir("/zdeck/ringtones");
+    SDFs.mkdir("/zdeck/logs");
+    SDFs.mkdir("/zdeck/exports");
+    SDFs.mkdir("/maps");
+    SDFs.mkdir("/maps/zdeck-mesh");
+    SDFs.mkdir("/maps/zdeck-compass");
+    SDFs.mkdir("/maps/zdeck-radar");
+    SDFs.mkdir("/maps/zdeck-alert");
+    SDFs.mkdir("/itsz");
+    SDFs.mkdir("/itsz/history");
+
+#if defined(HAS_SD_MMC) || defined(ARCH_PORTDUINO)
+    File readme = SDFs.open("/zdeck/README.TXT", FILE_WRITE);
+    if (readme) {
+        readme.print("T-Deck SD Card for Z-Deck firmware.\r\nMaps, message history, ringtones, logs, and exports live here.\r\n");
+        readme.print("Put preloaded map tiles under /maps/zdeck-mesh/<z>/<x>/<y>.png.\r\n");
+        readme.close();
+    }
+#else
+    FsFile readme = SDFs.open("/zdeck/README.TXT", O_RDWR | O_CREAT | O_TRUNC);
+    if (readme) {
+        readme.print("T-Deck SD Card for Z-Deck firmware.\r\nMaps, message history, ringtones, logs, and exports live here.\r\n");
+        readme.print("Put preloaded map tiles under /maps/zdeck-mesh/<z>/<x>/<y>.png.\r\n");
+        readme.close();
+    }
+#endif
+#endif
+
+    zDeckUsbSdMassStorageRefresh();
+    itsz::zdeck_state::setSd(itsz::zdeck_state::State::Ready,
+                             labelSet ? "SD prepared and label set" : "SD prepared without label");
+    updateZDeckHealthPanel();
+    updateZDeckSDPanel(labelSet ? "SD card prepared. Label set." : "SD card prepared. Label not set.");
+    return true;
+}
+
+void TFTView_320x240::ui_event_zdeckSdButton(lv_event_t *e)
+{
+    lv_event_code_t event_code = lv_event_get_code(e);
+    if (event_code != LV_EVENT_CLICKED || THIS->activeSettings != eNone)
+        return;
+
+    if (!THIS->zDeckSdResetArmed) {
+        THIS->zDeckSdResetArmed = true;
+        itsz::zdeck_state::setSd(itsz::zdeck_state::State::Warning, "SD reset armed");
+        THIS->updateZDeckSDPanel();
+        THIS->messageAlert("Press again to reset SD card", true);
+        return;
+    }
+
+    THIS->zDeckSdResetArmed = false;
+    if (THIS->prepareZDeckSDCard())
+        THIS->messageAlert("SD card ready for Z-Deck", true);
+    else
+        THIS->messageAlert("SD card reset failed", true);
+}
