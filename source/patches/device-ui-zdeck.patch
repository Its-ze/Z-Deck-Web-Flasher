+bool zDeckLoadSidebarRightPreference(bool defaultValue)
+{
+    File file = fileSystem.open(zDeckSidebarPreferencePath, FILE_READ);
+    if (file) {
+        int value = file.read();
+        file.close();
+        if (value == '0')
+            return false;
+        if (value == '1')
+            return true;
+    }
+    return defaultValue;
+}
+
+void zDeckSaveSidebarRightPreference(bool value)
+{
+    File file = fileSystem.open(zDeckSidebarPreferencePath, FILE_WRITE);
+    if (file) {
+        const uint8_t byteValue = value ? '1' : '0';
+        file.write(&byteValue, 1);
+        file.close();
+    }
+}
+
+bool zDeckLoadAlwaysOnPreference(bool defaultValue)
+{
+    File file = fileSystem.open(zDeckAlwaysOnPreferencePath, FILE_READ);
+    if (file) {
+        int value = file.read();
+        file.close();
+        if (value == '0')
+            return false;
+        if (value == '1')
+            return true;
+    }
+    return defaultValue;
+}
+
+void zDeckSaveAlwaysOnPreference(bool value)
+{
+    File file = fileSystem.open(zDeckAlwaysOnPreferencePath, FILE_WRITE);
+    if (file) {
+        const uint8_t byteValue = value ? '1' : '0';
+        file.write(&byteValue, 1);
+        file.close();
+    }
+}
+
+uint8_t zDeckLoadMapPagePreference(uint8_t defaultValue)
+{
+    File file = fileSystem.open(zDeckMapPagePreferencePath, FILE_READ);
+    if (file) {
+        int value = file.read();
+        file.close();
+        if (value >= '0' && value < '0' + (int)zDeckMapPageCount())
+            return (uint8_t)(value - '0');
+    }
+    return defaultValue % zDeckMapPageCount();
+}
+
+void zDeckSaveMapPagePreference(uint8_t pageIndex)
+{
+    File file = fileSystem.open(zDeckMapPagePreferencePath, FILE_WRITE);
+    if (!file)
+        return;
+    file.write((uint8_t)('0' + (pageIndex % zDeckMapPageCount())));
+    file.close();
+}
