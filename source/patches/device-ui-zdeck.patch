+void TFTView_320x240::updateMapStatusOverlay(uint32_t objectsOnMap)
+{
+    if (!mapStatusOverlayLabel)
+        return;
+
+    const bool gpsConfigured = db.config.position.gps_mode != meshtastic_Config_PositionConfig_GpsMode_NOT_PRESENT;
+    const bool gpsReady = hasPosition && myLatitude != 0 && myLongitude != 0;
+    const bool wifiConnected = db.connectionStatus.has_wifi && db.connectionStatus.wifi.has_status &&
+                               db.connectionStatus.wifi.status.is_connected;
+    zDeckEnsureMapStyle(db.uiConfig.map_data);
+    const uint8_t pageIndex = zDeckMapState.pageIndex();
+    const ZDeckMapPage &page = zDeckCurrentMapPage(pageIndex);
+    const bool offlineToolPage = strcmp(page.style, zDeckDefaultTileStyle) != 0;
+
+    char gps[48];
+    if (gpsReady && gpsSatellites > 0) {
+        lv_snprintf(gps, sizeof(gps), "GPS fix %u sats", (unsigned int)gpsSatellites);
+    } else if (gpsReady) {
+        lv_snprintf(gps, sizeof(gps), "GPS fix");
+    } else if (gpsConfigured && gpsSatellites > 0) {
+        lv_snprintf(gps, sizeof(gps), "GPS acquiring %u sats", (unsigned int)gpsSatellites);
+    } else if (gpsConfigured) {
+        lv_snprintf(gps, sizeof(gps), "GPS searching - open sky");
+    } else {
+        lv_snprintf(gps, sizeof(gps), "GPS off");
+    }
+
+    uint32_t positionedNodes = 0;
+    uint32_t nearestNode = 0;
+    int32_t nearestLat = 0;
+    int32_t nearestLon = 0;
+    float nearestKm = 0.0f;
+    const char *nearestName = "none";
+    for (auto &it : nodes) {
+        if (it.first == ownNode || !it.second)
+            continue;
+        int32_t lat = (long)it.second->LV_OBJ_IDX(node_pos1_idx)->user_data;
+        int32_t lon = (long)it.second->LV_OBJ_IDX(node_pos2_idx)->user_data;
+        if (!lat || !lon)
+            continue;
+        positionedNodes++;
+        if (gpsReady) {
+            float dist = zDeckDistanceKm(myLatitude, myLongitude, lat, lon);
+            if (!nearestNode || dist < nearestKm) {
+                nearestNode = it.first;
+                nearestLat = lat;
+                nearestLon = lon;
+                nearestKm = dist;
+                nearestName = lv_label_get_text(it.second->LV_OBJ_IDX(node_lbl_idx));
+            }
+        }
+    }
+
+    ZDeckDeflockHit deflock;
+    const bool deflockReady = zDeckGetDeflockHit(gpsReady, myLatitude, myLongitude, deflock);
+
+    char tileState[48];
+    itsz::zdeck_map::TileInputs tileInputs;
+    tileInputs.mapOpen = map != nullptr;
+    tileInputs.drawing = map && !map->redrawComplete();
+    tileInputs.tileSlots = map ? map->getTileSlots() : 0;
+    tileInputs.missingTiles = map ? map->getMissingTiles() : 0;
+    tileInputs.wifiConnected = wifiConnected;
+    tileInputs.sdReady = cardDetected;
+    const auto classifiedTiles = itsz::zdeck_map::Controller::classifyTiles(tileInputs);
+    if (classifiedTiles == itsz::zdeck_map::TileState::Drawing) {
+        lv_snprintf(tileState, sizeof(tileState), "drawing %u/%u tiles", (unsigned int)map->getLoadedTiles(),
+                    (unsigned int)map->getTileSlots());
+    } else if (classifiedTiles == itsz::zdeck_map::TileState::Missing) {
+        lv_snprintf(tileState, sizeof(tileState), "ready, %u tiles missing", (unsigned int)map->getMissingTiles());
+    } else {
+        lv_snprintf(tileState, sizeof(tileState), "%s", itsz::zdeck_map::Controller::tileStateLabel(classifiedTiles));
+    }
+
+    const bool noRenderedTiles = !map || map->getLoadedTiles() == 0;
+    const bool fallbackGrid = noRenderedTiles &&
+                              (classifiedTiles == itsz::zdeck_map::TileState::Drawing ||
+                               classifiedTiles == itsz::zdeck_map::TileState::Missing ||
+                               classifiedTiles == itsz::zdeck_map::TileState::Grid);
+    updateZDeckMapFallbackGrid(fallbackGrid, gpsReady);
+
+    char nearest[56];
+    if (nearestNode) {
+        if (db.config.display.units == meshtastic_Config_DisplayConfig_DisplayUnits_METRIC) {
+            if (nearestKm >= 1.0f)
+                lv_snprintf(nearest, sizeof(nearest), "Nearest %.18s %.1fkm", nearestName, nearestKm);
+            else
+                lv_snprintf(nearest, sizeof(nearest), "Nearest %.18s %um", nearestName,
+                            (unsigned int)round(nearestKm * 1000.0f));
+        } else {
+            float miles = nearestKm * 0.621371f;
+            if (miles >= 0.1f)
+                lv_snprintf(nearest, sizeof(nearest), "Nearest %.18s %.1fmi", nearestName, miles);
+            else
+                lv_snprintf(nearest, sizeof(nearest), "Nearest %.18s %uft", nearestName,
+                            (unsigned int)round(nearestKm * 3280.84f));
+        }
+    } else if (gpsReady && positionedNodes == 0) {
+        lv_snprintf(nearest, sizeof(nearest), "No peer GPS yet");
+    } else if (!gpsReady && positionedNodes > 0) {
+        lv_snprintf(nearest, sizeof(nearest), "Need own GPS for range");
+    } else {
+        lv_snprintf(nearest, sizeof(nearest), "Waiting for positions");
+    }
+
+    updateZDeckMapToolPanel(gpsReady, positionedNodes, nearestNode, nearestLat, nearestLon, nearestKm, nearestName, gps, tileState,
+                            deflockReady, deflock.cachePresent, deflock.records, deflock.latitude, deflock.longitude,
+                            deflock.distanceKm, deflock.name, deflock.kind);
+
+    const bool deflockAlert = deflockReady && deflock.distanceKm <= 0.30f;
+    const bool meshAlert = nearestNode && nearestKm <= 0.50f;
+    const bool nearAlert = (pageIndex == 2 && deflockAlert) || (pageIndex == 3 && (deflockAlert || meshAlert));
+    char zdeckMapState[96];
+    if (deflockReady) {
+        lv_snprintf(zdeckMapState, sizeof(zdeckMapState), "%s | %s | DeFlock %.0fm | %u/%u nodes", page.name, gps,
+                    deflock.distanceKm * 1000.0f, (unsigned int)positionedNodes, (unsigned int)nodeCount);
+    } else {
+        lv_snprintf(zdeckMapState, sizeof(zdeckMapState), "%s | %s | DeFlock %s | %u/%u nodes", page.name, gps,
+                    deflock.cachePresent ? "empty" : "no cache", (unsigned int)positionedNodes, (unsigned int)nodeCount);
+    }
+    itsz::zdeck_state::setMap(nearAlert ? itsz::zdeck_state::State::Warning
+                                        : !map                         ? itsz::zdeck_state::State::Waiting
+                                          : !map->redrawComplete()     ? itsz::zdeck_state::State::Busy
+                                          : gpsReady || positionedNodes || deflockReady ? itsz::zdeck_state::State::Ready
+                                                                        : itsz::zdeck_state::State::Waiting,
+                              zdeckMapState);
+    lv_obj_set_size(mapStatusOverlayLabel, zDeckMapOverlayWidth, offlineToolPage ? 86 : zDeckMapOverlayHeight);
+    lv_obj_set_align(mapStatusOverlayLabel, LV_ALIGN_TOP_LEFT);
+    lv_obj_set_pos(mapStatusOverlayLabel, zDeckMapOverlayX, zDeckMapOverlayY);
+    lv_obj_set_style_border_width(mapStatusOverlayLabel, 1, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_border_color(mapStatusOverlayLabel, nearAlert ? colorRed : gpsReady || offlineToolPage ? colorBlueGreen : colorYellow,
+                                  LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_text_align(mapStatusOverlayLabel, LV_TEXT_ALIGN_LEFT, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_text_color(mapStatusOverlayLabel, nearAlert ? colorRed : gpsReady || offlineToolPage ? colorLightGray : colorYellow,
+                                LV_PART_MAIN | LV_STATE_DEFAULT);
+
+    char buf[160];
+    if (pageIndex == 1) {
+        lv_snprintf(buf, sizeof(buf), "%s | %s\n%s\n%s", page.button, gps, nearest, tileState);
+    } else if (pageIndex == 2) {
+        if (deflockReady) {
+            lv_snprintf(buf, sizeof(buf), "%s | %.0fm\n%.24s\n%s", nearAlert ? "DEFLOCK ALERT" : page.button,
+                        deflock.distanceKm * 1000.0f, deflock.name, tileState);
+        } else {
+            lv_snprintf(buf, sizeof(buf), "%s | %s\n%s\n/zdeck/deflock.csv", page.button, gps,
+                        deflock.cachePresent ? "No ALPR rows nearby" : "No DeFlock cache");
+        }
+    } else if (pageIndex == 3) {
+        if (deflockReady) {
+            lv_snprintf(buf, sizeof(buf), "%s | ALPR %.0fm\n%.22s\n%s", nearAlert ? "DISTANCE WARN" : page.name,
+                        deflock.distanceKm * 1000.0f, deflock.name, nearest);
+        } else {
+            lv_snprintf(buf, sizeof(buf), "%s | %s\n%s\n%s", nearAlert ? "DISTANCE WARN" : page.button, gps, nearest, tileState);
+        }
+    } else {
+        const char *locs = objectsOnMap > 0 ? "nodes on map" : nodeCount > 0 ? "nodes lack GPS" : "no node coords";
+        lv_snprintf(buf, sizeof(buf), "%s | %s\n%u/%u %s\n%s", page.button, gps, (unsigned int)objectsOnMap,
+                    (unsigned int)nodeCount, locs, tileState);
+    }
+    lv_label_set_text(mapStatusOverlayLabel, buf);
+    lv_obj_move_foreground(mapStatusOverlayLabel);
+}
