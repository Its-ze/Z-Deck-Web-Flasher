+void TFTView_320x240::updateDynamicMapMenu(void)
+{
+    if (!mapInternetStatusLabel)
+        return;
+
+    zDeckEnsureMapStyle(db.uiConfig.map_data);
+    const ZDeckMapPage &page = zDeckCurrentMapPage(zDeckMapState.pageIndex());
+    const bool hasNetwork = db.config.has_network;
+    const bool hasWifiStatus = db.connectionStatus.has_wifi && db.connectionStatus.wifi.has_status;
+    const bool wifiConnected = hasWifiStatus && db.connectionStatus.wifi.status.is_connected;
+    const bool hasWifiConfig = db.config.network.wifi_ssid[0] != '\0';
+    const char *ssid = db.connectionStatus.wifi.ssid[0] ? db.connectionStatus.wifi.ssid : db.config.network.wifi_ssid;
+
+    char buf[144];
+    if (!hasNetwork) {
+        lv_label_set_text(mapInternetStatusLabel, "WiFi: no radio - SD/offline tiles only");
+        lv_label_set_text(mapInternetButtonLabel, "N/A");
+    } else if (!hasWifiConfig) {
+        lv_label_set_text(mapInternetStatusLabel, "WiFi: not set - hotspot cannot be used yet");
+        lv_label_set_text(mapInternetButtonLabel, "SET");
+    } else if (wifiConnected) {
+        uint32_t ip = db.connectionStatus.wifi.status.ip_address;
+        lv_snprintf(buf, sizeof(buf), "WiFi: %s %d.%d.%d.%d %ddBm", ssid, ip & 0xff, (ip & 0xff00) >> 8,
+                    (ip & 0xff0000) >> 16, (ip & 0xff000000) >> 24, db.connectionStatus.wifi.rssi);
+        lv_label_set_text(mapInternetStatusLabel, buf);
+        lv_label_set_text(mapInternetButtonLabel, "OFF");
+    } else if (db.config.network.wifi_enabled) {
+        lv_snprintf(buf, sizeof(buf), "WiFi: %s connecting - no new tiles yet", ssid);
+        lv_label_set_text(mapInternetStatusLabel, buf);
+        lv_label_set_text(mapInternetButtonLabel, "EDIT");
+    } else {
+        lv_snprintf(buf, sizeof(buf), "WiFi: %s saved but off", ssid);
+        lv_label_set_text(mapInternetStatusLabel, buf);
+        lv_label_set_text(mapInternetButtonLabel, "ON");
+    }
+
+    if (mapModeButtonLabel)
+        lv_label_set_text(mapModeButtonLabel, page.button);
+    if (mapCenterButtonLabel)
+        lv_label_set_text(mapCenterButtonLabel, "CTR");
+
+    const bool mapReady = !map || map->redrawComplete();
+    const uint16_t missingTiles = map ? map->getMissingTiles() : 0;
+    if (MapTileSettings::saveOK()) {
+        lv_snprintf(buf, sizeof(buf), "%s | SD z%d %s%s", page.name, MapTileSettings::getZoomLevel(),
+                    missingTiles ? "partial " : "",
+                    MapTileSettings::getTileStyle()[0] ? MapTileSettings::getTileStyle() : "default");
+    } else if (!mapReady) {
+        lv_snprintf(buf, sizeof(buf), "%s | drawing tiles", page.name);
+    } else if (missingTiles) {
+        lv_snprintf(buf, sizeof(buf), "%s | %u tiles missing", page.name, (unsigned int)missingTiles);
+    } else if (cardDetected && wifiConnected) {
+        lv_snprintf(buf, sizeof(buf), "%s | WiFi fetch", page.name);
+    } else if (cardDetected) {
+        lv_snprintf(buf, sizeof(buf), "%s | SD ready", page.name);
+    } else if (wifiConnected) {
+        lv_snprintf(buf, sizeof(buf), "%s | online", page.name);
+    } else {
+        lv_snprintf(buf, sizeof(buf), "%s | grid only", page.name);
+    }
+    lv_label_set_text(mapCacheStatusLabel, buf);
+    lv_label_set_text(mapCacheButtonLabel, "SAVE");
+    updateZDeckMapPageBar();
+    updateMapStatusOverlay(map ? map->getObjectsOnMap() : 0);
+}
