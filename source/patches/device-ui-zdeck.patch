+namespace
+{
+USBMSC zDeckUsbMsc;
+bool zDeckUsbMscStarted = false;
+bool zDeckUsbMscReady = false;
+char zDeckUsbMscStatus[96] = "USB SD: waiting for card";
+
+int32_t zDeckMscRead(uint32_t lba, uint32_t offset, void *buffer, uint32_t bufsize)
+{
+    if (!SDFs.card() || !buffer || offset >= 512)
+        return -1;
+
+    concurrency::LockGuard g(spiLock);
+    uint8_t sector[512];
+    uint8_t *dst = static_cast<uint8_t *>(buffer);
+    uint32_t copied = 0;
+
+    while (copied < bufsize) {
+        if (!SDFs.card()->readSector(lba, sector))
+            return copied ? (int32_t)copied : -1;
+
+        const uint32_t chunk = std::min<uint32_t>(512 - offset, bufsize - copied);
+        memcpy(dst + copied, sector + offset, chunk);
+        copied += chunk;
+        lba++;
+        offset = 0;
+    }
+
+    return copied;
+}
+
+int32_t zDeckMscWrite(uint32_t lba, uint32_t offset, uint8_t *buffer, uint32_t bufsize)
+{
+    if (!SDFs.card() || !buffer || offset >= 512)
+        return -1;
+
+    concurrency::LockGuard g(spiLock);
+    uint8_t sector[512];
+    uint32_t written = 0;
+
+    while (written < bufsize) {
+        const uint32_t chunk = std::min<uint32_t>(512 - offset, bufsize - written);
+        if (chunk != 512 || offset != 0) {
+            if (!SDFs.card()->readSector(lba, sector))
+                return written ? (int32_t)written : -1;
+            memcpy(sector + offset, buffer + written, chunk);
+        } else {
+            memcpy(sector, buffer + written, 512);
+        }
+
+        if (!SDFs.card()->writeSector(lba, sector))
+            return written ? (int32_t)written : -1;
+
+        written += chunk;
+        lba++;
+        offset = 0;
+    }
+
+    SDFs.card()->syncDevice();
+    return written;
+}
+
+bool zDeckMscStartStop(uint8_t, bool start, bool loadEject)
+{
+    if (!start && loadEject) {
+        zDeckUsbMsc.mediaPresent(false);
+        zDeckUsbMscReady = false;
+        snprintf(zDeckUsbMscStatus, sizeof(zDeckUsbMscStatus), "USB SD: ejected by host");
+    }
+    return true;
+}
+} // namespace
+
+bool zDeckUsbSdMassStorageReady(void)
+{
+    return zDeckUsbMscReady;
+}
+
+const char *zDeckUsbSdMassStorageStatus(void)
+{
+    return zDeckUsbMscStatus;
+}
+
+void zDeckUsbSdMassStorageRefresh(void)
+{
+    if (!SDFs.card()) {
+        zDeckUsbMsc.mediaPresent(false);
+        zDeckUsbMscReady = false;
+        snprintf(zDeckUsbMscStatus, sizeof(zDeckUsbMscStatus), "USB SD: no card");
+        return;
+    }
+
+    const uint32_t sectors = SDFs.card()->sectorCount();
+    if (sectors == 0) {
+        zDeckUsbMsc.mediaPresent(false);
+        zDeckUsbMscReady = false;
+        snprintf(zDeckUsbMscStatus, sizeof(zDeckUsbMscStatus), "USB SD: card size unknown");
+        return;
+    }
+
+    if (!zDeckUsbMscStarted) {
+        zDeckUsbMsc.vendorID("ZDECK");
+        zDeckUsbMsc.productID("TDECK SD CARD");
+        zDeckUsbMsc.productRevision("1.0");
+        zDeckUsbMsc.onStartStop(zDeckMscStartStop);
+        zDeckUsbMsc.onRead(zDeckMscRead);
+        zDeckUsbMsc.onWrite(zDeckMscWrite);
+        zDeckUsbMscStarted = zDeckUsbMsc.begin(sectors, 512);
+    }
+
+    zDeckUsbMsc.mediaPresent(zDeckUsbMscStarted);
+    zDeckUsbMscReady = zDeckUsbMscStarted;
+    snprintf(zDeckUsbMscStatus, sizeof(zDeckUsbMscStatus), "USB SD: %s, %.1f GB", zDeckUsbMscReady ? "mounted" : "not started",
+             sectors / 2097152.0f);
+}
