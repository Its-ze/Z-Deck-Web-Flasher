+float zDeckRadiansToDegrees360(float angle)
+{
+    return zDeckWrapRadians(angle) * 180.0f / PI;
+}
+
+float zDeckDistanceKm(int32_t fromLat, int32_t fromLon, int32_t toLat, int32_t toLon)
+{
+    const float midLatRad = float(fromLat + toLat) * 0.5e-7f * PI / 180.0f;
+    const float latKm = 111.32f * 1e-7f * float(fromLat - toLat);
+    const float lonKm = 111.32f * std::max(0.1f, fabsf(cosf(midLatRad))) * 1e-7f * float(fromLon - toLon);
+    return sqrtf(latKm * latKm + lonKm * lonKm);
+}
