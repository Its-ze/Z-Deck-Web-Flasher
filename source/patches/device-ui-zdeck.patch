+    if (showAlert) {
+        char msg[64];
+        lv_snprintf(msg, sizeof(msg), "Default view: %s", zDeckCurrentMapPage(zDeckMapState.pageIndex()).name);
+        messageAlert(msg, true);
+    }
+}
