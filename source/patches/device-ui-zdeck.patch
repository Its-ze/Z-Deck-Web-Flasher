+void zDeckSetSafeText(char *target, size_t targetSize, const char *value, const char *fallback)
+{
+    const char *src = value && value[0] ? value : fallback;
+    strncpy(target, src, targetSize - 1);
+    target[targetSize - 1] = '\0';
+    for (size_t i = 0; target[i]; ++i) {
+        if (target[i] == '\r' || target[i] == '\n')
+            target[i] = ' ';
+    }
+}
+
+bool zDeckGetCsvField(const char *line, uint8_t fieldIndex, char *out, size_t outSize)
+{
+    if (!line || !out || outSize == 0)
+        return false;
+    out[0] = '\0';
+    uint8_t field = 0;
+    size_t pos = 0;
+    bool quoted = false;
+    for (const char *p = line; *p; ++p) {
+        if (*p == '"') {
+            quoted = !quoted;
+            continue;
+        }
+        if (!quoted && (*p == ',' || *p == ';')) {
+            if (field == fieldIndex)
+                break;
+            field++;
+            pos = 0;
+            out[0] = '\0';
+            continue;
+        }
+        if (field == fieldIndex && pos < outSize - 1) {
+            out[pos++] = *p;
+            out[pos] = '\0';
+        }
+    }
+    while (pos > 0 && (out[pos - 1] == ' ' || out[pos - 1] == '\t')) {
+        out[--pos] = '\0';
+    }
+    char *start = out;
+    while (*start == ' ' || *start == '\t')
+        start++;
+    if (start != out)
+        memmove(out, start, strlen(start) + 1);
+    return out[0] != '\0';
+}
+
+bool zDeckParseDeflockLine(const char *line, int32_t myLat, int32_t myLon, ZDeckDeflockHit &hit)
+{
+    if (!line || !line[0] || line[0] == '#')
+        return false;
+
+    char latField[24];
+    char lonField[24];
+    if (!zDeckGetCsvField(line, 0, latField, sizeof(latField)) || !zDeckGetCsvField(line, 1, lonField, sizeof(lonField)))
+        return false;
+
+    char *latEnd = nullptr;
+    char *lonEnd = nullptr;
+    const float lat = strtof(latField, &latEnd);
+    const float lon = strtof(lonField, &lonEnd);
+    if (latEnd == latField || lonEnd == lonField || !std::isfinite(lat) || !std::isfinite(lon) || fabsf(lat) > 90.0f ||
+        fabsf(lon) > 180.0f)
+        return false;
+
+    char nameField[48];
+    char kindField[32];
+    zDeckGetCsvField(line, 2, nameField, sizeof(nameField));
+    zDeckGetCsvField(line, 3, kindField, sizeof(kindField));
+
+    hit.valid = true;
+    hit.latitude = (int32_t)roundf(lat * 1e7f);
+    hit.longitude = (int32_t)roundf(lon * 1e7f);
+    hit.distanceKm = zDeckDistanceKm(myLat, myLon, hit.latitude, hit.longitude);
+    zDeckSetSafeText(hit.name, sizeof(hit.name), nameField, "DeFlock ALPR");
+    zDeckSetSafeText(hit.kind, sizeof(hit.kind), kindField, "ALPR");
+    return true;
+}
+
+bool zDeckScanDeflockCache(int32_t myLat, int32_t myLon, ZDeckDeflockHit &best)
+{
+    best = ZDeckDeflockHit{};
+    static const char *paths[] = {"/zdeck/deflock.csv", "/maps/deflock.csv", "/deflock.csv"};
+    File file;
+    for (const char *path : paths) {
+        file = fileSystem.open(path, FILE_READ);
+        if (file)
+            break;
+    }
+    if (!file) {
+        best.cachePresent = false;
+        return false;
+    }
+
+    best.cachePresent = true;
+    while (file.available()) {
+        String line = file.readStringUntil('\n');
+        line.trim();
+        ZDeckDeflockHit candidate;
+        if (!zDeckParseDeflockLine(line.c_str(), myLat, myLon, candidate))
+            continue;
+        best.records++;
+        if (!best.valid || candidate.distanceKm < best.distanceKm) {
+            candidate.cachePresent = true;
+            candidate.records = best.records;
+            best = candidate;
+        }
+    }
+    file.close();
+    return best.valid;
+}
+
+bool zDeckGetDeflockHit(bool gpsReady, int32_t myLat, int32_t myLon, ZDeckDeflockHit &hit)
+{
+    if (!gpsReady) {
+        hit = zDeckLastDeflockHit;
+        return false;
+    }
+
+    const uint32_t now = millis();
+    const float movedKm = zDeckLastDeflockScanLat && zDeckLastDeflockScanLon
+                              ? zDeckDistanceKm(myLat, myLon, zDeckLastDeflockScanLat, zDeckLastDeflockScanLon)
+                              : 99.0f;
+    if (now - zDeckLastDeflockScanMs > 15000 || movedKm > 0.03f) {
+        zDeckScanDeflockCache(myLat, myLon, zDeckLastDeflockHit);
+        zDeckLastDeflockScanMs = now;
+        zDeckLastDeflockScanLat = myLat;
+        zDeckLastDeflockScanLon = myLon;
+    }
+    hit = zDeckLastDeflockHit;
+    return hit.valid;
+}
