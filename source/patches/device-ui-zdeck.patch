+bool zDeckUpdateCompassHeading(int32_t lat, int32_t lon, float &heading, const char **source)
+{
+    if (source)
+        *source = "waiting";
+    if (!lat || !lon)
+        return false;
+
+    if (gpsStatus && gpsStatus->getHasHeading()) {
+        heading = zDeckWrapRadians(gpsStatus->getHeadingDegrees() * PI / 180.0f);
+        zDeckCompassHeading = heading;
+        zDeckCompassHeadingValid = true;
+        zDeckCompassLastLat = lat;
+        zDeckCompassLastLon = lon;
+        if (source)
+            *source = "GPS course";
+        return true;
+    }
+
+    if (zDeckCompassLastLat && zDeckCompassLastLon) {
+        const float movedKm = zDeckDistanceKm(lat, lon, zDeckCompassLastLat, zDeckCompassLastLon);
+        if (movedKm >= 0.003f) {
+            zDeckCompassHeading =
+                GeoCoord::bearing(zDeckCompassLastLat * 1e-7, zDeckCompassLastLon * 1e-7, lat * 1e-7, lon * 1e-7);
+            zDeckCompassHeadingValid = true;
+            zDeckCompassLastLat = lat;
+            zDeckCompassLastLon = lon;
+        }
+    } else {
+        zDeckCompassLastLat = lat;
+        zDeckCompassLastLon = lon;
+    }
+
+    if (!zDeckCompassHeadingValid)
+        return false;
+
+    heading = zDeckCompassHeading;
+    if (source)
+        *source = "GPS motion";
+    return true;
+}
