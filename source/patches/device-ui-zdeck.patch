+void TFTView_320x240::updateZDeckMapToolPanel(bool gpsReady, uint32_t positionedNodes, uint32_t nearestNode, int32_t nearestLat,
+                                              int32_t nearestLon, float nearestKm, const char *nearestName, const char *gps,
+                                              const char *tileState, bool deflockReady, bool deflockCachePresent,
+                                              uint16_t deflockRecords, int32_t deflockLat, int32_t deflockLon, float deflockKm,
+                                              const char *deflockName, const char *deflockKind)
+{
+    setupZDeckMapToolPanel();
+    if (!zDeckMapToolPanel)
+        return;
+
+    const uint8_t pageIndex = zDeckMapState.pageIndex();
+    const bool toolPage = pageIndex > 0;
+    if (!toolPage) {
+        lv_obj_add_flag(zDeckMapToolPanel, LV_OBJ_FLAG_HIDDEN);
+        if (mapStatusOverlayLabel)
+            lv_obj_clear_flag(mapStatusOverlayLabel, LV_OBJ_FLAG_HIDDEN);
+        lv_obj_clear_flag(objects.navigation_panel, LV_OBJ_FLAG_HIDDEN);
+        lv_obj_set_pos(objects.navigation_panel, -2, -zDeckMapPageBarHeight - 2);
+        if (db.config.position.gps_mode != meshtastic_Config_PositionConfig_GpsMode_NOT_PRESENT)
+            lv_obj_clear_flag(objects.gps_lock_button, LV_OBJ_FLAG_HIDDEN);
+        lv_obj_clear_flag(objects.zoom_in_button, LV_OBJ_FLAG_HIDDEN);
+        lv_obj_clear_flag(objects.zoom_out_button, LV_OBJ_FLAG_HIDDEN);
+        updateZDeckMapPageBar();
+        return;
+    }
+
+    lv_obj_clear_flag(zDeckMapToolPanel, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_move_foreground(zDeckMapToolPanel);
+    if (mapStatusOverlayLabel)
+        lv_obj_add_flag(mapStatusOverlayLabel, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_add_flag(objects.navigation_panel, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_add_flag(objects.gps_lock_button, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_add_flag(objects.zoom_in_button, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_add_flag(objects.zoom_out_button, LV_OBJ_FLAG_HIDDEN);
+    updateZDeckMapPageBar();
+
+    const bool deflockPage = pageIndex == 2;
+    const bool alertPage = pageIndex == 3;
+    const bool deflockAlert = deflockReady && deflockKm <= 0.30f;
+    const bool meshAlert = nearestNode && nearestKm <= 0.50f;
+    const bool nearAlert = (deflockPage && deflockAlert) || (alertPage && (deflockAlert || meshAlert));
+    const int16_t cx = 71;
+    const int16_t cy = 82;
+    const int16_t ringRadius = 57;
+    const int16_t needleRadius = 47;
+    float heading = 0.0f;
+    const char *headingSource = "waiting";
+    const bool headingReady = gpsReady && zDeckUpdateCompassHeading(myLatitude, myLongitude, heading, &headingSource);
+    const bool dynamicRing = db.uiConfig.compass_mode != meshtastic_CompassMode_FIXED_RING;
+    const float ringOffset = headingReady && dynamicRing ? -heading : 0.0f;
+    const float headingNeedle = headingReady && !dynamicRing ? heading : 0.0f;
+
+    zDeckPlaceCompassLabel(zDeckMapToolNorthLabel, cx, cy, ringRadius, ringOffset);
+    zDeckPlaceCompassLabel(zDeckMapToolEastLabel, cx, cy, ringRadius, zDeckWrapRadians(ringOffset + PI / 2.0f));
+    zDeckPlaceCompassLabel(zDeckMapToolSouthLabel, cx, cy, ringRadius, zDeckWrapRadians(ringOffset + PI));
+    zDeckPlaceCompassLabel(zDeckMapToolWestLabel, cx, cy, ringRadius, zDeckWrapRadians(ringOffset + (3.0f * PI / 2.0f)));
+
+    lv_obj_set_style_border_color(zDeckMapToolRing, nearAlert ? colorRed : headingReady ? colorBlueGreen : colorYellow,
+                                  LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_line_color(zDeckMapToolNeedle, nearAlert ? colorRed : colorYellow, LV_PART_MAIN | LV_STATE_DEFAULT);
+    if (headingReady)
+        zDeckSetLineToAngle(zDeckMapToolNeedle, zDeckCompassNeedlePoints, cx, cy, needleRadius, headingNeedle);
+    else
+        lv_obj_add_flag(zDeckMapToolNeedle, LV_OBJ_FLAG_HIDDEN);
+
+    bool havePeerBearing = false;
+    float peerBearing = 0.0f;
+    const bool useDeflockTarget = (deflockPage || alertPage) && deflockReady;
+    const int32_t targetLat = useDeflockTarget ? deflockLat : nearestLat;
+    const int32_t targetLon = useDeflockTarget ? deflockLon : nearestLon;
+    const bool haveTarget = useDeflockTarget || nearestNode;
+    if (gpsReady && haveTarget && targetLat && targetLon) {
+        peerBearing = GeoCoord::bearing(myLatitude * 1e-7, myLongitude * 1e-7, targetLat * 1e-7, targetLon * 1e-7);
+        if (headingReady && dynamicRing)
+            peerBearing = zDeckWrapRadians(peerBearing - heading);
+        havePeerBearing = true;
+    }
+    if (havePeerBearing) {
+        lv_obj_set_style_line_color(zDeckMapToolPeerNeedle, nearAlert ? colorRed : colorMesh, LV_PART_MAIN | LV_STATE_DEFAULT);
+        zDeckSetLineToAngle(zDeckMapToolPeerNeedle, zDeckCompassPeerNeedlePoints, cx, cy, needleRadius - 10, peerBearing);
+    } else {
+        lv_obj_add_flag(zDeckMapToolPeerNeedle, LV_OBJ_FLAG_HIDDEN);
+    }
+
+    const char *title = pageIndex == 1 ? "COMPASS" : pageIndex == 2 ? "DEFLOCK" : "ALERT";
+    char header[42];
+    if (headingReady) {
+        const unsigned int headingDeg = (unsigned int)roundf(zDeckRadiansToDegrees360(heading));
+        lv_snprintf(header, sizeof(header), "%s %03u deg", title, headingDeg);
+    } else {
+        lv_snprintf(header, sizeof(header), "%s waiting", title);
+    }
+    lv_label_set_text(zDeckMapToolHeadingLabel, header);
+    lv_obj_set_style_text_color(zDeckMapToolHeadingLabel, nearAlert ? colorRed : headingReady ? colorBlueGreen : colorYellow,
+                                LV_PART_MAIN | LV_STATE_DEFAULT);
+
+    char bearingLine[36];
+    if (havePeerBearing) {
+        const unsigned int peerDeg = (unsigned int)roundf(zDeckRadiansToDegrees360(peerBearing));
+        lv_snprintf(bearingLine, sizeof(bearingLine), "%s brg %03u deg", useDeflockTarget ? "ALPR" : "Peer", peerDeg);
+    } else if (haveTarget) {
+        lv_snprintf(bearingLine, sizeof(bearingLine), "Need heading");
+    } else {
+        lv_snprintf(bearingLine, sizeof(bearingLine), "No target bearing");
+    }
+
+    char detail[176];
+    if (pageIndex == 1) {
+        lv_snprintf(detail, sizeof(detail), "%s\nHeading: %s\nMesh %.18s\n%s", gps,
+                    headingReady ? headingSource : "move for course", nearestNode ? nearestName : "none", bearingLine);
+    } else if (pageIndex == 2) {
+        if (!gpsReady) {
+            lv_snprintf(detail, sizeof(detail), "Need GPS fix\nDeFlock cache ready after fix\nCSV: lat,lon,name,type");
+        } else if (!deflockCachePresent) {
+            lv_snprintf(detail, sizeof(detail), "No DeFlock cache\nAdd /zdeck/deflock.csv\nCSV: lat,lon,name,type");
+        } else if (deflockReady) {
+            lv_snprintf(detail, sizeof(detail), "%s\n%.0fm %s\n%s\n%u cache pts", deflockName, deflockKm * 1000.0f,
+                        deflockKind, bearingLine, (unsigned int)deflockRecords);
+        } else {
+            lv_snprintf(detail, sizeof(detail), "DeFlock cache empty\nAdd ALPR rows\nCSV: lat,lon,name,type");
+        }
+    } else {
+        const char *alert = deflockAlert ? "DEFLOCK ALERT" : meshAlert ? "MESH PROXIMITY" : "Distance clear";
+        if (deflockReady) {
+            lv_snprintf(detail, sizeof(detail), "%s\nALPR %.0fm %.18s\nMesh %.18s\n%s", alert, deflockKm * 1000.0f,
+                        deflockName, nearestNode ? nearestName : "none", bearingLine);
+        } else {
+            lv_snprintf(detail, sizeof(detail), "%s\nNo DeFlock target\nMesh %.18s\nWarn ALPR 300m", alert,
+                        nearestNode ? nearestName : "none");
+        }
+    }
+    lv_label_set_text(zDeckMapToolDetailLabel, detail);
+    lv_obj_set_style_text_color(zDeckMapToolDetailLabel, nearAlert ? colorRed : colorLightGray, LV_PART_MAIN | LV_STATE_DEFAULT);
+
+    char footer[96];
+    if ((deflockPage || alertPage) && deflockReady)
+        lv_snprintf(footer, sizeof(footer), "DeFlock %.2fkm | %s", deflockKm, zDeckCurrentMapPage(pageIndex).summary);
+    else if (nearestNode)
+        lv_snprintf(footer, sizeof(footer), "%s | mesh %.2fkm | %s", tileState, nearestKm, zDeckCurrentMapPage(pageIndex).summary);
+    else
+        lv_snprintf(footer, sizeof(footer), "%s | %s", tileState, zDeckCurrentMapPage(pageIndex).summary);
+    lv_label_set_text(zDeckMapToolFooterLabel, footer);
+    lv_obj_set_style_text_color(zDeckMapToolFooterLabel, nearAlert ? colorRed : colorGray, LV_PART_MAIN | LV_STATE_DEFAULT);
+}
