+void TFTView_320x240::scanWifiNetworks(void)
+{
+    setupWifiScanControls();
+    if (!wifiNetworkDropdown || !wifiScanButton)
+        return;
+
+    wifiScanNetworkCount = 0;
+    memset(wifiScanSsids, 0, sizeof(wifiScanSsids));
+    memset(wifiScanOpen, 0, sizeof(wifiScanOpen));
+    memset(wifiScanOptions, 0, sizeof(wifiScanOptions));
+
+    updateWifiScanStatus("Scanning nearby WiFi...");
+    lv_dropdown_set_options(wifiNetworkDropdown, "Scanning...");
+    lv_label_set_text(wifiScanButtonLabel, "WAIT");
+    lv_obj_add_state(wifiScanButton, LV_STATE_DISABLED);
+    lv_timer_handler();
+
+#if defined(ARCH_ESP32)
+    struct WifiCandidate {
+        char ssid[33];
+        int32_t rssi;
+        bool open;
+    };
+
+    WifiCandidate candidates[zDeckWifiScanMaxNetworks] = {};
+    uint8_t candidateCount = 0;
+    wifi_mode_t previousMode = WiFiGenericClass::getMode();
+    bool changedMode = false;
+    if (previousMode == WIFI_MODE_NULL) {
+        WiFi.mode(WIFI_STA);
+        changedMode = true;
+    } else if (previousMode == WIFI_MODE_AP) {
+        WiFi.mode(WIFI_AP_STA);
+        changedMode = true;
+    }
+
+    int networkCount = WiFi.scanNetworks(false, true);
+    for (int i = 0; i < networkCount; ++i) {
+        char ssid[33];
+        String ssidString = WiFi.SSID(i);
+        zDeckCleanWifiSsid(ssid, sizeof(ssid), ssidString.c_str());
+        if (!ssid[0])
+            continue;
+
+        int duplicate = -1;
+        for (uint8_t j = 0; j < candidateCount; ++j) {
+            if (strcmp(candidates[j].ssid, ssid) == 0) {
+                duplicate = j;
+                break;
+            }
+        }
+
+        int32_t rssi = WiFi.RSSI(i);
+        bool open = WiFi.encryptionType(i) == WIFI_AUTH_OPEN;
+        if (duplicate >= 0) {
+            if (rssi > candidates[duplicate].rssi) {
+                candidates[duplicate].rssi = rssi;
+                candidates[duplicate].open = open;
+            }
+            continue;
+        }
+
+        uint8_t target = candidateCount;
+        if (candidateCount < zDeckWifiScanMaxNetworks) {
+            candidateCount++;
+        } else {
+            target = 0;
+            for (uint8_t j = 1; j < candidateCount; ++j) {
+                if (candidates[j].rssi < candidates[target].rssi)
+                    target = j;
+            }
+            if (rssi <= candidates[target].rssi)
+                continue;
+        }
+
+        strncpy(candidates[target].ssid, ssid, sizeof(candidates[target].ssid) - 1);
+        candidates[target].ssid[sizeof(candidates[target].ssid) - 1] = '\0';
+        candidates[target].rssi = rssi;
+        candidates[target].open = open;
+    }
+
+    std::sort(candidates, candidates + candidateCount, [](const WifiCandidate &a, const WifiCandidate &b) {
+        return a.rssi > b.rssi;
+    });
+
+    for (uint8_t i = 0; i < candidateCount; ++i) {
+        strncpy(wifiScanSsids[i], candidates[i].ssid, sizeof(wifiScanSsids[i]) - 1);
+        wifiScanOpen[i] = candidates[i].open;
+
+        char line[80];
+        lv_snprintf(line, sizeof(line), "%s  %lddBm %s", candidates[i].ssid, (long)candidates[i].rssi,
+                    candidates[i].open ? "open" : "lock");
+        zDeckAppendWifiOption(wifiScanOptions, sizeof(wifiScanOptions), line);
+    }
+
+    wifiScanNetworkCount = candidateCount;
+    if (wifiScanNetworkCount > 0) {
+        lv_dropdown_set_options(wifiNetworkDropdown, wifiScanOptions);
+        lv_dropdown_set_selected(wifiNetworkDropdown, 0);
+        char buf[80];
+        lv_snprintf(buf, sizeof(buf), "Found %u networks. Pick one.", (unsigned int)wifiScanNetworkCount);
+        updateWifiScanStatus(buf);
+    } else {
+        lv_dropdown_set_options(wifiNetworkDropdown, "No networks found");
+        updateWifiScanStatus("No WiFi networks found.");
+    }
+
+    WiFi.scanDelete();
+    if (changedMode) {
+        if (previousMode == WIFI_MODE_NULL && !db.config.network.wifi_enabled)
+            WiFi.mode(WIFI_MODE_NULL);
+        else if (previousMode == WIFI_MODE_AP)
+            WiFi.mode(WIFI_MODE_AP);
+    }
+#else
+    lv_dropdown_set_options(wifiNetworkDropdown, "Scan unavailable");
+    updateWifiScanStatus("WiFi scan is only available on ESP32.");
+#endif
+
+    lv_label_set_text(wifiScanButtonLabel, "SCAN");
+    lv_obj_clear_state(wifiScanButton, LV_STATE_DISABLED);
+}
