+            lv_obj_set_style_bg_color(bar, lv_color_hex((v << 16) | (v << 8) | v), LV_PART_MAIN | LV_STATE_DEFAULT);
+        }
+    } else if (step == 10) {
+        for (uint8_t y = 0; y < 6; y++) {
+            for (uint8_t x = 0; x < 8; x++) {
+                lv_obj_t *cell = lv_obj_create(screenCorrectionOverlay);
+                lv_obj_remove_style_all(cell);
+                lv_obj_set_pos(cell, (width * x) / 8, (height * y) / 6);
+                lv_obj_set_size(cell, (width / 8) + 2, (height / 6) + 2);
+                lv_obj_set_style_bg_opa(cell, LV_OPA_COVER, LV_PART_MAIN | LV_STATE_DEFAULT);
+                lv_obj_set_style_bg_color(cell, lv_color_hex(((x + y) % 2) ? 0xffffff : 0x000000),
+                                          LV_PART_MAIN | LV_STATE_DEFAULT);
+            }
+        }
+    } else if (step == 11) {
+        lv_obj_set_style_bg_color(screenCorrectionOverlay, lv_color_hex(0x101010), LV_PART_MAIN | LV_STATE_DEFAULT);
+        for (uint8_t y = 0; y < 12; y++) {
+            lv_obj_t *line = lv_obj_create(screenCorrectionOverlay);
+            lv_obj_remove_style_all(line);
+            lv_obj_set_pos(line, 0, (height * y) / 12);
+            lv_obj_set_size(line, width, 3);
+            lv_obj_set_style_bg_opa(line, LV_OPA_COVER, LV_PART_MAIN | LV_STATE_DEFAULT);
+            lv_obj_set_style_bg_color(line, lv_color_hex(y % 2 ? 0x67ea94 : 0x05f6cb), LV_PART_MAIN | LV_STATE_DEFAULT);
+        }
+    } else if (step == 12) {
+        lv_obj_set_style_bg_color(screenCorrectionOverlay, lv_color_hex(0xffffff), LV_PART_MAIN | LV_STATE_DEFAULT);
+        for (uint8_t i = 0; i < 8; i++) {
+            lv_obj_t *line = lv_obj_create(screenCorrectionOverlay);
+            lv_obj_remove_style_all(line);
+            lv_obj_set_pos(line, (width * i) / 8, 0);
+            lv_obj_set_size(line, 2, height);
+            lv_obj_set_style_bg_opa(line, LV_OPA_COVER, LV_PART_MAIN | LV_STATE_DEFAULT);
+            lv_obj_set_style_bg_color(line, lv_color_hex(0x000000), LV_PART_MAIN | LV_STATE_DEFAULT);
+        }
+        for (uint8_t i = 0; i < 6; i++) {
+            lv_obj_t *line = lv_obj_create(screenCorrectionOverlay);
+            lv_obj_remove_style_all(line);
+            lv_obj_set_pos(line, 0, (height * i) / 6);
+            lv_obj_set_size(line, width, 2);
+            lv_obj_set_style_bg_opa(line, LV_OPA_COVER, LV_PART_MAIN | LV_STATE_DEFAULT);
+            lv_obj_set_style_bg_color(line, lv_color_hex(0x000000), LV_PART_MAIN | LV_STATE_DEFAULT);
+        }
+    } else if (step >= 13) {
+        lv_obj_set_style_bg_color(screenCorrectionOverlay, lv_color_hex(0x000000), LV_PART_MAIN | LV_STATE_DEFAULT);
+        const uint32_t sweepColors[] = {0xff5555, 0x67ea94, 0x05f6cb};
+        for (uint8_t i = 0; i < 12; i++) {
+            lv_obj_t *block = lv_obj_create(screenCorrectionOverlay);
+            lv_obj_remove_style_all(block);
+            lv_obj_set_pos(block, ((width - 24) * ((i + step) % 12)) / 11, ((height - 24) * i) / 11);
+            lv_obj_set_size(block, 24, 24);
+            lv_obj_set_style_bg_opa(block, LV_OPA_COVER, LV_PART_MAIN | LV_STATE_DEFAULT);
+            lv_obj_set_style_bg_color(block, lv_color_hex(sweepColors[(i + step) % 3]), LV_PART_MAIN | LV_STATE_DEFAULT);
+        }
+    }
+
+    lv_obj_t *label = lv_label_create(screenCorrectionOverlay);
+    lv_label_set_text_fmt(label, "SCREEN FIX %02u/16  %s\nTap to stop", step + 1, names[step]);
+    lv_obj_set_style_text_color(label, lv_color_hex((step == 1 || step == 5 || step == 7 || step == 9 || step == 12) ? 0x101010 : 0xffffff),
+                                LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_bg_color(label, lv_color_hex((step == 1 || step == 5 || step == 7 || step == 9 || step == 12) ? 0xffffff : 0x000000),
+                              LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_bg_opa(label, LV_OPA_60, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_set_style_pad_all(label, 4, LV_PART_MAIN | LV_STATE_DEFAULT);
+    lv_obj_align(label, LV_ALIGN_BOTTOM_MID, 0, -8);
+}
+
+void TFTView_320x240::ui_event_screenCorrectionButton(lv_event_t *e)
+{
+    if (lv_event_get_code(e) != LV_EVENT_CLICKED)
+        return;
+
+    lv_obj_t *target = (lv_obj_t *)lv_event_get_target(e);
+    if (target == THIS->screenCorrectionOverlay) {
+        THIS->stopScreenCorrection();
+        THIS->messageAlert(_("Screen correction stopped"), true);
+        return;
+    }
+
+    if (THIS->activeSettings == eNone)
+        THIS->startScreenCorrection();
 }
 
