+void TFTView_320x240::setZDeckMapPage(uint8_t pageIndex, bool showAlert)
+{
+    zDeckEnsureMapStyle(db.uiConfig.map_data);
+    zDeckMapState.setPage(pageIndex);
+    db.uiConfig.has_map_data = true;
+    MapTileSettings::setPrefix("/maps");
+    MapTileSettings::setTileStyle(db.uiConfig.map_data.style);
+    zDeckSaveMapPagePreference(zDeckMapState.pageIndex());
+    if (cardDetected)
+        MapTileSettings::setSaveOK(true);
+    controller->storeUIConfig(db.uiConfig);
+    if (map)
+        map->forceRedraw();
